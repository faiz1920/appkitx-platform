---
import ToolLayout from "../layouts/ToolLayout.astro";
import LoanCalculator from "../components/LoanCalculator.astro";
import ProseText from "../components/ProseText.astro";
import { getDictionary, type LocaleCode } from "../i18n/config";
import { resolveLocalizedTools } from "../i18n/tool-catalog";
import { localizedHref } from "../i18n/routing";
import {
  categoryPath,
  isCategoryPublished,
  toolCategory,
} from "../lib/categories";
import calculatorIcon from "lucide-static/icons/calculator.svg?raw";
import tagIcon from "lucide-static/icons/tag.svg?raw";
import table2Icon from "lucide-static/icons/table-2.svg?raw";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.loanCalculator;

const category = toolCategory("/loan-calculator");
const relatedHref = isCategoryPublished(category)
  ? localizedHref(categoryPath(category), locale)
  : undefined;

const toolIcons: Record<string, string> = {
  calculator: calculatorIcon,
  tag: tagIcon,
  "table-2": table2Icon,
};
const relatedTools = resolveLocalizedTools(locale, [
  "/emi-calculator",
  "/percentage-calculator",
  "/discount-calculator",
]).map((related) => ({
  title: related.title,
  description: related.description,
  href: localizedHref(related.href, locale),
  icon: toolIcons[related.icon] ?? "",
}));
---

<ToolLayout
  title={tool.title}
  description={tool.metaDescription}
  toolName={tool.name}
  toolDescription={tool.description}
  locale={locale}
  breadcrumb={[
    { label: t.toolLayout.breadcrumbHome, href: localizedHref("/", locale) },
    { label: tool.name },
  ]}
  relatedTools={relatedTools}
  relatedHref={relatedHref}
>
  <LoanCalculator slot="tool" locale={locale} />

  <ProseText sections={tool.sections} />
</ToolLayout>
