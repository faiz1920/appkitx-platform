---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalNav from "../components/GlobalNav.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import GuideCard from "../components/GuideCard.astro";
import { getCollection } from "astro:content";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import { localizedHref } from "../i18n/routing";
import {
  GUIDE_CATEGORY_LABELS,
  GUIDE_COPY,
  formatEditorialDate,
  groupGuidesByCategory,
  guideIndexHref,
  sortGuidesByDate,
  toGuideSummary,
} from "../lib/editorial";
import {
  buildBreadcrumbJsonLd,
  buildCollectionPageJsonLd,
  siteUrl,
} from "../lib/seo";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const localeMeta = getLocale(locale);
const copy = GUIDE_COPY[locale];

const entries = await getCollection(
  "guides",
  ({ data }) => data.lang === locale,
);
const guides = sortGuidesByDate(entries.map(toGuideSummary));
const groups = groupGuidesByCategory(guides);

if (guides.length === 0) {
  throw new Error(`The ${locale} guides index requires at least one guide.`);
}

const latestUpdate = guides.reduce(
  (latest, guide) => (guide.updated > latest ? guide.updated : latest),
  guides[0]!.updated,
);

const breadcrumb = [
  { label: t.toolLayout.breadcrumbHome, href: localizedHref("/", locale) },
  { label: copy.breadcrumbGuides },
];

const canonical = siteUrl(guideIndexHref(locale), Astro.site);
const jsonLd = [
  buildBreadcrumbJsonLd({ entries: breadcrumb, site: Astro.site }),
  buildCollectionPageJsonLd({
    name: copy.guideIndexTitle,
    description: copy.guideIndexMetaDescription,
    url: canonical,
    inLanguage: localeMeta.hreflang,
  }),
];
---

<BaseLayout
  title={`${copy.guideIndexTitle} — AppKitX`}
  description={copy.guideIndexMetaDescription}
  locale={locale}
  jsonLd={jsonLd}
>
  <GlobalNav locale={locale} />
  <main id="main">
    <header class="bg-surface">
      <div class="mx-auto max-w-(--layout-container) px-6 pt-10 pb-8 md:pt-16 md:pb-12">
        <Breadcrumbs label={t.toolLayout.breadcrumbLabel} items={breadcrumb} />
        <h1 class="hero-title mt-4 text-text-primary">
          {copy.guideIndexTitle}
        </h1>
        <p class="mt-4 max-w-(--layout-prose) text-body-lg text-text-secondary">
          {copy.guideIndexDescription}
        </p>
        <p class="mt-3 text-caption text-text-muted">
          {guides.length} {copy.guideCountSuffix}
          <span aria-hidden="true"> · </span>
          {copy.latestUpdateLabel}
          <time datetime={latestUpdate.toISOString().slice(0, 10)} class="ml-1">
            {formatEditorialDate(latestUpdate, locale)}
          </time>
        </p>
      </div>
    </header>

    <div class="bg-surface-subtle">
      <div class="mx-auto max-w-(--layout-container) space-y-16 px-6 py-16 md:py-(--layout-section-y)">
        {groups.map((group) => (
          <section aria-labelledby={`category-${group.category}`}>
            <h2
              id={`category-${group.category}`}
              class="text-headline text-text-primary"
            >
              {GUIDE_CATEGORY_LABELS[locale][group.category]}
            </h2>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-(--layout-grid-gap) lg:grid-cols-3">
              {group.guides.map((guide) => (
                <GuideCard
                  slug={guide.slug}
                  title={guide.title}
                  description={guide.description}
                  category={guide.category}
                  readingMinutes={guide.readingMinutes}
                  locale={locale}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
