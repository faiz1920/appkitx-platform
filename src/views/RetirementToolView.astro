---
import ToolLayout from "../layouts/ToolLayout.astro";
import RetirementCalculator from "../components/RetirementCalculator.astro";
import ProseText from "../components/ProseText.astro";
import { getDictionary, type LocaleCode } from "../i18n/config";
import { resolveLocalizedTools } from "../i18n/tool-catalog";
import { localizedHref } from "../i18n/routing";
import {
  categoryPath,
  isCategoryPublished,
  toolCategory,
} from "../lib/categories";
import piggyBankIcon from "lucide-static/icons/piggy-bank.svg?raw";
import trendingUpIcon from "lucide-static/icons/trending-up.svg?raw";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.retirementCalculator;

const category = toolCategory("/retirement-calculator");
const relatedHref = isCategoryPublished(category)
  ? localizedHref(categoryPath(category), locale)
  : undefined;

const toolIcons: Record<string, string> = {
  "trending-up": trendingUpIcon,
  "piggy-bank": piggyBankIcon,
};
const relatedTools = resolveLocalizedTools(locale, [
  "/compound-interest-calculator",
  "/savings-goal-calculator",
]).map((related) => ({
  title: related.title,
  description: related.description,
  href: localizedHref(related.href, locale),
  icon: toolIcons[related.icon] ?? "",
}));
---

<ToolLayout
  title={tool.title}
  description={tool.metaDescription}
  toolName={tool.name}
  toolDescription={tool.description}
  locale={locale}
  breadcrumb={[
    { label: t.toolLayout.breadcrumbHome, href: localizedHref("/", locale) },
    { label: tool.name },
  ]}
  relatedTools={relatedTools}
  relatedHref={relatedHref}
>
  <RetirementCalculator slot="tool" locale={locale} />

  <ProseText sections={tool.sections} />
</ToolLayout>
