---
/*
 * Manual PC Builder UI (M10.2) — development preview.
 *
 * Framework-free by design: this markup plus one client script that owns the
 * immutable selection state. Compatibility and power results are always
 * derived with the M10.1 engine on render; no UI-side compatibility logic.
 */
import closeIcon from "lucide-static/icons/x.svg?raw";
import { catalogue } from "../../lib/pc-builder/catalogue";
import { CATEGORY_LABELS } from "../../lib/pc-builder/ui";
import {
  componentCategories,
  multiSlotCategories,
} from "../../lib/pc-builder/types";
import { manufacturerOptions } from "../../lib/pc-builder/ui";
import {
  BUILD_SIZE_OPTIONS,
  COOLING_OPTIONS,
  CPU_BRAND_OPTIONS,
  CURRENCY_UNIT_LABEL,
  DEFAULT_QUESTIONNAIRE,
  GPU_BRAND_OPTIONS,
  PERFORMANCE_PRIORITY_OPTIONS,
  RESOLUTION_OPTIONS,
  UPGRADE_OPTIONS,
  USE_CASE_OPTIONS,
} from "../../lib/pc-builder/recommendations/questionnaire";

const manufacturers = manufacturerOptions(catalogue);
const catalogueNote = `Initial curated catalogue: ${catalogue.length} components from ${manufacturers.length} manufacturers. It is not the full market. Specifications come from manufacturer pages; unpublished values are marked as not published.`;
const multiSlot = new Set<string>(multiSlotCategories);
---

<div
  class="mx-auto max-w-(--layout-container) px-6 py-8 md:py-10"
  data-pc-builder
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-overline text-text-muted">
        Development preview — not published
      </p>
      <h1 class="mt-1 text-headline text-text-primary">PC Builder</h1>
      <p class="mt-2 max-w-(--layout-prose) text-small text-text-secondary">
        Start with a guided recommendation based on your requirements, or
        assemble a PC manually and check compatibility as you go. Both modes use
        the same catalogue, compatibility engine and power estimator.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <p
        class="text-caption text-text-muted"
        data-progress
        data-manual-only
      ></p>
      <button
        type="button"
        class="btn btn-secondary"
        data-clear
        data-manual-only
      >
        Clear build
      </button>
    </div>
  </div>

  <fieldset class="mt-6">
    <legend class="sr-only">Builder mode</legend>
    <div class="segmented max-w-md">
      <label class="min-h-11">
        <input
          type="radio"
          name="builder-mode"
          value="guided"
          class="sr-only"
          checked
          data-mode-input
        />
        Guided
      </label>
      <label class="min-h-11">
        <input
          type="radio"
          name="builder-mode"
          value="manual"
          class="sr-only"
          data-mode-input
        />
        Manual
      </label>
    </div>
    <p class="mt-2 text-caption text-text-muted">
      Guided mode recommends a specification-based configuration. Manual mode
      exposes the full catalogue and every compatibility finding.
    </p>
  </fieldset>

  <noscript>
    <p class="mt-6 rounded-lg border border-warning bg-warning-subtle p-4 text-small text-warning">
      The PC Builder requires JavaScript to manage the selection and run
      compatibility checks.
    </p>
  </noscript>

  <section
    class="mt-8"
    data-mode-panel="guided"
    aria-labelledby="guided-heading"
  >
    <div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_420px]">
      <div class="min-w-0">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-overline text-text-muted" data-guided-step>
              Step 1 of 2 — Requirements
            </p>
            <h2
              id="guided-heading"
              class="mt-1 text-title text-text-primary"
              tabindex="-1"
            >
              Tell us what you need
            </h2>
            <p class="mt-1 max-w-(--layout-prose) text-caption text-text-muted">
              The questionnaire shapes component priorities and the target
              allocation. It does not imply live pricing.
            </p>
          </div>
          <span
            class="inline-flex items-center rounded-full border border-border-strong bg-surface-muted px-3 py-1 text-chip text-text-secondary"
            data-guided-stage
          >
            Requirements
          </span>
        </div>

        <form
          class="mt-4 rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          data-guided-form
          novalidate
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="guided-budget" class="text-label text-text-primary">
                Budget
              </label>
              <input
                id="guided-budget"
                name="budget"
                type="number"
                class="input mt-1 font-mono tabular-nums"
                min="1"
                max="1000000"
                step="1"
                inputmode="decimal"
                value={DEFAULT_QUESTIONNAIRE.budget}
                aria-describedby="guided-budget-help guided-budget-error"
                data-guided-budget
              />
              <p
                id="guided-budget-help"
                class="mt-1 text-caption text-text-muted"
              >
                {CURRENCY_UNIT_LABEL} — a planning envelope, not a live price.
              </p>
              <p
                id="guided-budget-error"
                class="field-error mt-1"
                role="alert"
                hidden
                data-guided-budget-error
              ></p>
            </div>

            <div>
              <label for="guided-use-case" class="text-label text-text-primary">
                Primary use case
              </label>
              <select
                id="guided-use-case"
                class="input mt-1"
                data-guided-use-case
              >
                {USE_CASE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.useCase}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p class="mt-1 text-caption text-text-muted">
                Sets the component priorities and allocation shape.
              </p>
            </div>

            <div>
              <label
                for="guided-resolution"
                class="text-label text-text-primary"
              >
                Target resolution
              </label>
              <select
                id="guided-resolution"
                class="input mt-1"
                data-guided-resolution
              >
                {RESOLUTION_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.resolution}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p class="mt-1 text-caption text-text-muted">
                Influences GPU priorities for gaming.
              </p>
            </div>

            <div>
              <label for="guided-priority" class="text-label text-text-primary">
                Performance priority
              </label>
              <select
                id="guided-priority"
                class="input mt-1"
                data-guided-priority
              >
                {PERFORMANCE_PRIORITY_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={
                      option.value === DEFAULT_QUESTIONNAIRE.performancePriority
                    }
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p class="mt-1 text-caption text-text-muted">
                Adjusts the scoring weights; it does not change compatibility.
              </p>
            </div>

            <div>
              <label
                for="guided-cpu-brand"
                class="text-label text-text-primary"
              >
                CPU preference
              </label>
              <select
                id="guided-cpu-brand"
                class="input mt-1"
                data-guided-cpu-brand
              >
                {CPU_BRAND_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.cpuBrand}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label
                for="guided-gpu-brand"
                class="text-label text-text-primary"
              >
                GPU preference
              </label>
              <select
                id="guided-gpu-brand"
                class="input mt-1"
                data-guided-gpu-brand
              >
                {GPU_BRAND_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.gpuBrand}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="guided-cooling" class="text-label text-text-primary">
                Cooling preference
              </label>
              <select
                id="guided-cooling"
                class="input mt-1"
                data-guided-cooling
              >
                {COOLING_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.cooling}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label
                for="guided-build-size"
                class="text-label text-text-primary"
              >
                Build size
              </label>
              <select
                id="guided-build-size"
                class="input mt-1"
                data-guided-build-size
              >
                {BUILD_SIZE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.buildSize}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="guided-upgrade" class="text-label text-text-primary">
                Upgrade flexibility
              </label>
              <select
                id="guided-upgrade"
                class="input mt-1"
                data-guided-upgrade
              >
                {UPGRADE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={
                      option.value === DEFAULT_QUESTIONNAIRE.upgradeFlexibility
                    }
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <p
            class="field-error mt-4"
            role="alert"
            hidden
            data-guided-form-error
          ></p>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary" data-guided-generate>
              Generate recommendation
            </button>
            <button type="button" class="btn btn-secondary" data-guided-reset>
              Start over
            </button>
            <p class="text-caption text-text-muted">
              Deterministic, specification-based, no account required.
            </p>
          </div>
        </form>
      </div>

      <aside
        class="rounded-lg border border-border-subtle bg-surface-subtle p-(--layout-panel-padding)"
        aria-labelledby="guided-method-heading"
      >
        <h2 id="guided-method-heading" class="text-title text-text-primary">
          How this works
        </h2>
        <ul class="mt-3 space-y-3 text-small text-text-secondary">
          <li>
            Candidates are filtered by known socket, memory, clearance and
            connector constraints.
          </li>
          <li>
            Every candidate is checked by the shared compatibility engine.
            Unknown checks stay visible and are never treated as compatible.
          </li>
          <li>
            Power comes from the existing estimator; missing CPU or GPU power
            data is reported instead of guessed.
          </li>
          <li>
            The catalogue stores no prices. Budget figures are target
            allocations, not quotes, and no FPS or benchmark scores are claimed.
          </li>
        </ul>
      </aside>
    </div>

    <section
      class="mt-8"
      data-guided-results
      aria-labelledby="guided-results-heading"
      hidden
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-overline text-text-muted" data-guided-result-step>
            Step 2 of 2 — Recommendation
          </p>
          <h2
            id="guided-results-heading"
            class="mt-1 text-headline text-text-primary"
            tabindex="-1"
            data-guided-result-headline
          >
            Recommendation
          </h2>
          <p
            class="mt-2 max-w-(--layout-prose) text-small text-text-secondary"
            data-guided-result-explanation
          ></p>
        </div>
        <span
          class="inline-flex items-center rounded-full border px-3 py-1 text-chip"
          data-guided-result-status
        >
          Recommendation
        </span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-secondary" data-guided-edit>
          Edit requirements
        </button>
        <button type="button" class="btn btn-secondary" data-guided-regenerate>
          Regenerate
        </button>
        <button type="button" class="btn btn-primary" data-guided-transfer>
          Transfer to manual builder
        </button>
        <button type="button" class="btn btn-ghost" data-guided-start-over>
          Start over
        </button>
      </div>

      <p class="mt-2 text-caption text-warning" data-guided-stale hidden>
        Requirements changed — generate again to update this recommendation.
      </p>

      <dl
        class="mt-4 flex flex-wrap gap-2 text-caption"
        data-guided-result-meta
      ></dl>

      <div
        class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2"
        data-guided-selections
      ></div>

      <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section
          class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          aria-labelledby="guided-compat-heading"
        >
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h3 id="guided-compat-heading" class="text-title text-text-primary">
              Compatibility
            </h3>
            <span
              class="inline-flex items-center rounded-full border px-3 py-1 text-chip"
              data-guided-compat-badge
            >
              Unknown
            </span>
          </div>
          <p
            class="mt-2 text-caption text-text-secondary"
            data-guided-compat-message
          ></p>
          <dl class="mt-4 grid grid-cols-2 gap-2">
            <div class="rounded-md bg-surface-subtle px-3 py-2">
              <dt class="text-micro text-text-muted">Incompatible</dt>
              <dd
                class="font-mono text-title tabular-nums text-text-primary"
                data-guided-count-incompatible
              >
                0
              </dd>
            </div>
            <div class="rounded-md bg-surface-subtle px-3 py-2">
              <dt class="text-micro text-text-muted">Warnings</dt>
              <dd
                class="font-mono text-title tabular-nums text-text-primary"
                data-guided-count-warning
              >
                0
              </dd>
            </div>
            <div class="rounded-md bg-surface-subtle px-3 py-2">
              <dt class="text-micro text-text-muted">Unknown</dt>
              <dd
                class="font-mono text-title tabular-nums text-text-primary"
                data-guided-count-unknown
              >
                0
              </dd>
            </div>
            <div class="rounded-md bg-surface-subtle px-3 py-2">
              <dt class="text-micro text-text-muted">Compatible</dt>
              <dd
                class="font-mono text-title tabular-nums text-text-primary"
                data-guided-count-compatible
              >
                0
              </dd>
            </div>
          </dl>
          <div class="mt-3 space-y-4" data-guided-compat-groups></div>
        </section>

        <section
          class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          aria-labelledby="guided-power-heading"
        >
          <h3 id="guided-power-heading" class="text-title text-text-primary">
            Power estimate
          </h3>
          <p class="mt-1 text-caption text-text-muted">
            Reuses the M10.1 estimator and its documented assumptions.
          </p>
          <dl class="mt-4 space-y-2 text-small">
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-text-secondary">Estimated load</dt>
              <dd
                class="font-mono text-title tabular-nums text-text-primary"
                data-guided-power-load
              >
                —
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-text-secondary">Recommended PSU</dt>
              <dd class="font-mono tabular-nums" data-guided-power-recommended>
                —
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-text-secondary">Selected PSU</dt>
              <dd class="font-mono tabular-nums" data-guided-power-selected>
                —
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-text-secondary">Headroom</dt>
              <dd class="font-mono tabular-nums" data-guided-power-headroom>
                —
              </dd>
            </div>
          </dl>
          <div data-guided-power-missing hidden>
            <p class="mt-3 text-caption text-text-secondary">
              Missing information
            </p>
            <ul
              class="mt-1 space-y-1 text-micro text-text-muted"
              data-guided-power-missing-list
            ></ul>
          </div>
          <details class="mt-3">
            <summary class="focus-ring cursor-pointer text-label text-accent hover:text-accent-hover">
              Power assumptions
            </summary>
            <ul
              class="mt-2 space-y-1 text-micro text-text-muted"
              data-guided-power-assumptions
            ></ul>
          </details>
        </section>

        <section
          class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          aria-labelledby="guided-budget-heading"
        >
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h3 id="guided-budget-heading" class="text-title text-text-primary">
              Budget allocation
            </h3>
            <span class="inline-flex items-center rounded-full border border-warning bg-warning-subtle px-3 py-1 text-chip text-warning">
              Price data unverified
            </span>
          </div>
          <p
            class="mt-2 text-caption text-text-secondary"
            data-guided-budget-summary
          ></p>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-caption">
              <caption class="sr-only">
                Target budget allocation by component category
              </caption>
              <thead>
                <tr class="text-overline text-text-muted">
                  <th scope="col" class="py-1 pr-2 text-left font-semibold">
                    Category
                  </th>
                  <th scope="col" class="py-1 pr-2 text-right font-semibold">
                    Share
                  </th>
                  <th scope="col" class="py-1 text-right font-semibold">
                    Target
                  </th>
                </tr>
              </thead>
              <tbody data-guided-budget-rows></tbody>
            </table>
          </div>
          <p
            class="mt-3 text-micro text-text-muted"
            data-guided-budget-note
          ></p>
        </section>

        <section
          class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          aria-labelledby="guided-confidence-heading"
        >
          <h3
            id="guided-confidence-heading"
            class="text-title text-text-primary"
          >
            Data confidence
          </h3>
          <p
            class="mt-2 text-small text-text-primary"
            data-guided-confidence-label
          >
            —
          </p>
          <ul
            class="mt-2 space-y-1 text-caption text-text-secondary"
            data-guided-confidence-reasons
          ></ul>
          <div data-guided-confidence-missing hidden>
            <p class="mt-3 text-caption text-text-secondary">
              Unpublished specifications
            </p>
            <p
              class="mt-1 text-micro text-text-muted"
              data-guided-confidence-missing-list
            ></p>
          </div>
          <div data-guided-confidence-unknown hidden>
            <p class="mt-3 text-caption text-text-secondary">
              Critical checks that remain Unknown
            </p>
            <ul
              class="mt-1 space-y-1 text-micro text-text-muted"
              data-guided-confidence-unknown-list
            ></ul>
          </div>
        </section>
      </div>

      <section
        class="mt-4 rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
        aria-labelledby="guided-unmet-heading"
        data-guided-unmet
        hidden
      >
        <h3 id="guided-unmet-heading" class="text-title text-text-primary">
          Preferences not fully met
        </h3>
        <ul
          class="mt-2 space-y-1 text-small text-text-secondary"
          data-guided-unmet-list
        ></ul>
      </section>

      <section
        class="mt-4 rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
        aria-labelledby="guided-limitations-heading"
      >
        <h3
          id="guided-limitations-heading"
          class="text-title text-text-primary"
        >
          Limitations
        </h3>
        <ul
          class="mt-2 space-y-1 text-small text-text-secondary"
          data-guided-limitations
        ></ul>
      </section>
    </section>
  </section>

  <div
    class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_360px]"
    data-mode-panel="manual"
    hidden
  >
    <section aria-labelledby="components-heading" class="min-w-0">
      <h2
        id="components-heading"
        class="text-title text-text-primary"
        tabindex="-1"
      >
        Components
      </h2>
      <p class="mt-1 text-caption text-text-muted">
        One selection per component category, except RAM kits, storage and case
        fans, which can hold several.
      </p>

      <div class="mt-4 space-y-3" data-slots>
        {componentCategories.map((category) => (
          <article
            class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
            aria-labelledby={`slot-heading-${category}`}
            data-slot={category}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3
                  id={`slot-heading-${category}`}
                  class="text-body-strong text-text-primary"
                >
                  {CATEGORY_LABELS[category]}
                </h3>
                <p
                  class="text-caption text-text-muted"
                  data-slot-meta={category}
                >
                  Not selected
                </p>
              </div>
              <button
                type="button"
                class="btn btn-secondary"
                data-slot-button={category}
                aria-label={`Select ${CATEGORY_LABELS[category]}`}
              >
                {multiSlot.has(category) ? "Add" : "Select"}
              </button>
            </div>
            <div data-slot-content={category}></div>
          </article>
        ))}
      </div>

      <p class="mt-4 text-micro text-text-muted">{catalogueNote}</p>
    </section>

    <aside
      class="space-y-6 lg:sticky lg:top-[calc(var(--layout-nav-height)+16px)]"
      aria-label="Build results"
    >
      <section
        class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
        aria-labelledby="compatibility-heading"
      >
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h2 id="compatibility-heading" class="text-title text-text-primary">
            Compatibility
          </h2>
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-border-strong bg-surface-muted px-3 py-1 text-chip text-text-secondary"
            data-overall-badge
          >
            No components selected
          </span>
        </div>
        <p class="mt-2 text-caption text-text-secondary" data-overall-message>
          Add components to run compatibility checks.
        </p>

        <dl class="mt-4 grid grid-cols-2 gap-2" data-counts>
          <div class="rounded-md bg-surface-subtle px-3 py-2">
            <dt class="text-micro text-text-muted">Incompatible</dt>
            <dd
              class="font-mono text-title tabular-nums text-text-primary"
              data-count-incompatible
            >
              0
            </dd>
          </div>
          <div class="rounded-md bg-surface-subtle px-3 py-2">
            <dt class="text-micro text-text-muted">Warnings</dt>
            <dd
              class="font-mono text-title tabular-nums text-text-primary"
              data-count-warning
            >
              0
            </dd>
          </div>
          <div class="rounded-md bg-surface-subtle px-3 py-2">
            <dt class="text-micro text-text-muted">Unknown</dt>
            <dd
              class="font-mono text-title tabular-nums text-text-primary"
              data-count-unknown
            >
              0
            </dd>
          </div>
