---
/*
 * Manual PC Builder UI (M10.2) — development preview.
 *
 * Framework-free by design: this markup plus one client script that owns the
 * immutable selection state. Compatibility and power results are always
 * derived with the M10.1 engine on render; no UI-side compatibility logic.
 */
import closeIcon from "lucide-static/icons/x.svg?raw";
import { catalogue } from "../../lib/pc-builder/catalogue";
import { CATEGORY_LABELS } from "../../lib/pc-builder/ui";
import {
  componentCategories,
  multiSlotCategories,
} from "../../lib/pc-builder/types";
import { manufacturerOptions } from "../../lib/pc-builder/ui";
import { EXAMPLE_MARKETS, INDIA_MARKET_ID } from "../../lib/pc-builder/pricing";
import {
  BUILD_SIZE_OPTIONS,
  COOLING_OPTIONS,
  CPU_BRAND_OPTIONS,
  CURRENCY_UNIT_LABEL,
  DEFAULT_QUESTIONNAIRE,
  GPU_BRAND_OPTIONS,
  PERFORMANCE_PRIORITY_OPTIONS,
  RESOLUTION_OPTIONS,
  UPGRADE_OPTIONS,
  USE_CASE_OPTIONS,
} from "../../lib/pc-builder/recommendations/questionnaire";

const manufacturers = manufacturerOptions(catalogue);
const catalogueNote = `Initial curated catalogue: ${catalogue.length} components from ${manufacturers.length} manufacturers. It is not the full market. Specifications come from manufacturer pages; unpublished values are marked as not published.`;
const multiSlot = new Set<string>(multiSlotCategories);
const descriptionFor = (
  options: readonly { value: string; description: string }[],
  value: string,
): string =>
  options.find((option) => option.value === value)?.description ?? "";
---

<div
  class="mx-auto max-w-(--layout-container) px-6 py-8 md:py-10"
  data-pc-builder
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-overline text-text-muted">
        Development preview — not published
      </p>
      <h1 class="mt-1 text-headline text-text-primary">PC Builder</h1>
      <p class="mt-2 max-w-(--layout-prose) text-small text-text-secondary">
        Start with a guided recommendation based on your requirements, or
        assemble a PC manually and check compatibility as you go. Both modes use
        the same catalogue, compatibility engine and power estimator.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <p
        class="text-caption text-text-muted"
        data-progress
        data-manual-only
      ></p>
      <button
        type="button"
        class="btn btn-secondary"
        data-clear
        data-manual-only
      >
        Clear build
      </button>
    </div>
  </div>

  <fieldset class="mt-6" data-builder-chrome>
    <legend class="sr-only">Builder mode</legend>
    <div class="segmented max-w-md">
      <label class="min-h-11">
        <input
          type="radio"
          name="builder-mode"
          value="guided"
          class="sr-only"
          checked
          data-mode-input
        />
        Guided
      </label>
      <label class="min-h-11">
        <input
          type="radio"
          name="builder-mode"
          value="manual"
          class="sr-only"
          data-mode-input
        />
        Manual
      </label>
    </div>
    <p class="mt-2 text-caption text-text-muted">
      Guided mode recommends a specification-based configuration. Manual mode
      exposes the full catalogue and every compatibility finding.
    </p>
  </fieldset>

  <section
    class="mt-6 rounded-lg border border-border-subtle bg-surface-subtle p-(--layout-panel-padding)"
    aria-labelledby="saved-builds-heading"
    data-saved-builds
    data-builder-chrome
  >
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-overline text-text-muted">Local library</p>
        <h2
          id="saved-builds-heading"
          class="mt-1 text-title text-text-primary"
          tabindex="-1"
        >
          Saved builds
        </h2>
        <p class="mt-1 max-w-(--layout-prose) text-caption text-text-muted">
          Stored in this browser only. No account, cloud sync or server copy.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2" data-saved-actions>
        <button type="button" class="btn btn-primary" data-save-new>
          Save as new
        </button>
        <button type="button" class="btn btn-secondary" data-save-update>
          Update saved build
        </button>
        <button type="button" class="btn btn-secondary" data-share-current>
          Share current build
        </button>
      </div>
    </div>

    <p
      class="mt-2 break-words text-caption text-text-secondary"
      data-active-saved
    >
      No saved build is active. Save the current selection to keep it in this
      browser.
    </p>

    <div
      class="mt-2 rounded-md border border-error bg-error-subtle p-3"
      role="alert"
      data-saved-error
      hidden
    >
      <p class="break-words text-small text-error" data-saved-error-message></p>
    </div>

    <div
      class="mt-2 rounded-md border border-warning bg-warning-subtle p-3"
      data-saved-notice
      hidden
    >
      <p
        class="break-words text-small text-warning"
        data-saved-notice-message
      ></p>
    </div>

    <div
      class="mt-2 rounded-md border border-warning bg-warning-subtle p-3"
      role="alert"
      data-saved-corrupt
      hidden
    >
      <p
        class="break-words text-small text-warning"
        data-saved-corrupt-message
      ></p>
      <button type="button" class="btn btn-secondary mt-2" data-saved-reset>
        Reset saved builds
      </button>
    </div>

    <p class="mt-3 text-small text-text-muted" data-saved-empty>
      No saved builds yet. Configure a build or generate a recommendation, then
      save it to keep it in this browser.
    </p>
    <ul class="mt-3 grid grid-cols-1 gap-3 lg:grid-cols-2" data-saved-list></ul>
  </section>

  <section
    class="mt-8"
    data-shared-view
    aria-labelledby="shared-heading"
    tabindex="-1"
    hidden
  >
    <div data-shared-content>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-overline text-text-muted">Shared build — read-only</p>
          <h2
            id="shared-heading"
            class="mt-1 text-headline text-text-primary"
            tabindex="-1"
            data-shared-name
          >
            Shared build
          </h2>
          <p class="mt-2 text-small text-text-secondary" data-shared-meta></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="inline-flex items-center rounded-full border border-border-strong bg-surface-muted px-3 py-1 text-chip text-text-secondary"
            data-shared-source
          >
            Manual
          </span>
          <span
            class="inline-flex items-center rounded-full border px-3 py-1 text-chip"
            data-shared-compat-badge
          >
            Unknown
          </span>
        </div>
      </div>

      <p class="mt-3 max-w-(--layout-prose) text-small text-text-secondary">
        This view is read-only. Compatibility and power are recalculated from
        the current catalogue; nothing is added to your manual build until you
        choose Import.
      </p>

      <div
        class="mt-3 rounded-md border border-warning bg-warning-subtle p-3"
        data-shared-warnings
        hidden
      >
        <p class="text-label text-warning">Catalogue warnings</p>
        <ul
          class="mt-1 space-y-1 text-small text-warning"
          data-shared-warning-list
        ></ul>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-primary" data-shared-import>
          Import into manual builder
        </button>
        <button type="button" class="btn btn-secondary" data-shared-save>
          Save a copy locally
        </button>
        <button type="button" class="btn btn-ghost" data-shared-return>
          Return to builder
        </button>
      </div>
      <p
        class="mt-2 break-words text-caption text-text-secondary"
        role="status"
        data-shared-feedback
      ></p>

      <div class="mt-6 grid grid-cols-1 items-start gap-4 xl:grid-cols-[minmax(0,1fr)_380px]">
        <section
          class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          aria-labelledby="shared-components-heading"
        >
          <h3
            id="shared-components-heading"
            class="text-title text-text-primary"
          >
            Components
          </h3>
          <p
            class="mt-1 break-words text-caption text-text-muted"
            data-shared-summary
          ></p>
          <ul class="mt-3 space-y-3" data-shared-components></ul>
        </section>

        <div class="space-y-4">
          <section
            class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
            aria-labelledby="shared-compat-heading"
          >
            <h3 id="shared-compat-heading" class="text-title text-text-primary">
              Compatibility
            </h3>
            <p
              class="mt-1 text-caption text-text-secondary"
              data-shared-compat-message
            ></p>
            <dl class="mt-3 grid grid-cols-2 gap-2">
              <div class="rounded-md bg-surface-subtle px-3 py-2">
                <dt class="text-micro text-text-muted">Incompatible</dt>
                <dd
                  class="font-mono text-title tabular-nums text-text-primary"
                  data-shared-count-incompatible
                >
                  0
                </dd>
              </div>
              <div class="rounded-md bg-surface-subtle px-3 py-2">
                <dt class="text-micro text-text-muted">Warnings</dt>
                <dd
                  class="font-mono text-title tabular-nums text-text-primary"
                  data-shared-count-warning
                >
                  0
                </dd>
              </div>
              <div class="rounded-md bg-surface-subtle px-3 py-2">
                <dt class="text-micro text-text-muted">Unknown</dt>
                <dd
                  class="font-mono text-title tabular-nums text-text-primary"
                  data-shared-count-unknown
                >
                  0
                </dd>
              </div>
              <div class="rounded-md bg-surface-subtle px-3 py-2">
                <dt class="text-micro text-text-muted">Compatible</dt>
                <dd
                  class="font-mono text-title tabular-nums text-text-primary"
                  data-shared-count-compatible
                >
                  0
                </dd>
              </div>
            </dl>
            <ul
              class="mt-2 divide-y divide-border-subtle"
              data-shared-findings
            ></ul>
          </section>

          <section
            class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
            aria-labelledby="shared-power-heading"
          >
            <h3 id="shared-power-heading" class="text-title text-text-primary">
              Power estimate
            </h3>
            <dl class="mt-3 space-y-2 text-small">
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-text-secondary">Estimated load</dt>
                <dd
                  class="font-mono text-title tabular-nums text-text-primary"
                  data-shared-power-load
                >
                  —
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-text-secondary">Recommended PSU</dt>
                <dd
                  class="font-mono tabular-nums"
                  data-shared-power-recommended
                >
                  —
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-text-secondary">Selected PSU</dt>
                <dd class="font-mono tabular-nums" data-shared-power-selected>
                  —
                </dd>
              </div>
            </dl>
            <p class="mt-2 text-micro text-text-muted">
              Manufacturer power figures are combined with generic estimates.
              This is not a certified PSU requirement.
            </p>
          </section>
        </div>
      </div>

      <section
        class="mt-4 rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
        aria-labelledby="shared-limitations-heading"
      >
        <h3
          id="shared-limitations-heading"
          class="text-title text-text-primary"
        >
          Limitations
        </h3>
        <ul
          class="mt-2 space-y-1 text-small text-text-secondary"
          data-shared-limitations
        ></ul>
      </section>
    </div>

    <div data-shared-error role="alert" hidden>
      <p class="text-overline text-text-muted">Shared build — read-only</p>
      <h2
        id="shared-error-heading"
        class="mt-1 text-headline text-text-primary"
      >
        Shared build could not be opened
      </h2>
      <p
        class="mt-2 text-small text-text-secondary"
        data-shared-error-message
      ></p>
      <button type="button" class="btn btn-secondary mt-4" data-shared-return>
        Return to builder
      </button>
    </div>
  </section>

  <noscript>
    <p class="mt-6 rounded-lg border border-warning bg-warning-subtle p-4 text-small text-warning">
      The PC Builder requires JavaScript to manage the selection and run
      compatibility checks.
    </p>
  </noscript>

  <section
    class="mt-8"
    data-mode-panel="guided"
    data-builder-chrome
    aria-labelledby="guided-heading"
  >
    <div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_420px]">
      <div class="min-w-0" data-guided-requirements>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-overline text-text-muted" data-guided-step>
              Step 1 of 2 — Requirements
            </p>
            <h2
              id="guided-heading"
              class="mt-1 text-title text-text-primary"
              tabindex="-1"
            >
              Tell us what you need
            </h2>
            <p class="mt-1 max-w-(--layout-prose) text-caption text-text-muted">
              The questionnaire shapes component priorities and the target
              allocation. It does not imply live pricing.
            </p>
          </div>
          <span
            class="inline-flex items-center rounded-full border border-border-strong bg-surface-muted px-3 py-1 text-chip text-text-secondary"
            data-guided-stage
          >
            Requirements
          </span>
        </div>

        <p
          class="mt-3 rounded-md border border-warning bg-warning-subtle p-3 text-small text-warning"
          data-guided-stale
          role="status"
          hidden
        >
          Requirements changed. The previous recommendation was cleared.
          Generate again to apply the new requirements.
        </p>

        <form
          class="mt-4 rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)"
          data-guided-form
          novalidate
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="guided-budget" class="text-label text-text-primary">
                Budget
              </label>
              <input
                id="guided-budget"
                name="budget"
                type="number"
                class="input mt-1 font-mono tabular-nums"
                min="1"
                max="1000000"
                step="1"
                inputmode="decimal"
                value={DEFAULT_QUESTIONNAIRE.budget}
                aria-describedby="guided-budget-help guided-budget-error"
                data-guided-budget
              />
              <p
                id="guided-budget-help"
                class="mt-1 text-caption text-text-muted"
              >
                {CURRENCY_UNIT_LABEL} — a planning envelope, not a live price.
              </p>
              <p
                id="guided-budget-error"
                class="field-error mt-1"
                role="alert"
                hidden
                data-guided-budget-error
              ></p>
            </div>

            <div>
              <label for="guided-use-case" class="text-label text-text-primary">
                Primary use case
              </label>
              <select
                id="guided-use-case"
                class="input mt-1"
                aria-describedby="guided-use-case-help"
                data-guided-use-case
              >
                {USE_CASE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.useCase}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-use-case-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-use-case-help
              >
                {descriptionFor(
                  USE_CASE_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.useCase,
                )}
              </p>
            </div>

            <div>
              <label
                for="guided-resolution"
                class="text-label text-text-primary"
              >
                Target resolution
              </label>
              <select
                id="guided-resolution"
                class="input mt-1"
                aria-describedby="guided-resolution-help"
                data-guided-resolution
              >
                {RESOLUTION_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.resolution}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-resolution-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-resolution-help
              >
                {descriptionFor(
                  RESOLUTION_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.resolution,
                )}
              </p>
            </div>

            <div>
              <label for="guided-priority" class="text-label text-text-primary">
                Performance priority
              </label>
              <select
                id="guided-priority"
                class="input mt-1"
                aria-describedby="guided-priority-help"
                data-guided-priority
              >
                {PERFORMANCE_PRIORITY_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={
                      option.value === DEFAULT_QUESTIONNAIRE.performancePriority
                    }
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-priority-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-priority-help
              >
                {descriptionFor(
                  PERFORMANCE_PRIORITY_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.performancePriority,
                )}
              </p>
            </div>

            <div>
              <label
                for="guided-cpu-brand"
                class="text-label text-text-primary"
              >
                CPU preference
              </label>
              <select
                id="guided-cpu-brand"
                class="input mt-1"
                aria-describedby="guided-cpu-brand-help"
                data-guided-cpu-brand
              >
                {CPU_BRAND_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.cpuBrand}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-cpu-brand-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-cpu-brand-help
              >
                {descriptionFor(
                  CPU_BRAND_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.cpuBrand,
                )}
              </p>
            </div>

            <div>
              <label
                for="guided-gpu-brand"
                class="text-label text-text-primary"
              >
                GPU preference
              </label>
              <select
                id="guided-gpu-brand"
                class="input mt-1"
                aria-describedby="guided-gpu-brand-help"
                data-guided-gpu-brand
              >
                {GPU_BRAND_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.gpuBrand}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-gpu-brand-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-gpu-brand-help
              >
                {descriptionFor(
                  GPU_BRAND_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.gpuBrand,
                )}
              </p>
            </div>

            <div>
              <label for="guided-cooling" class="text-label text-text-primary">
                Cooling preference
              </label>
              <select
                id="guided-cooling"
                class="input mt-1"
                aria-describedby="guided-cooling-help"
                data-guided-cooling
              >
                {COOLING_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.cooling}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-cooling-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-cooling-help
              >
                {descriptionFor(COOLING_OPTIONS, DEFAULT_QUESTIONNAIRE.cooling)}
              </p>
            </div>

            <div>
              <label
                for="guided-build-size"
                class="text-label text-text-primary"
              >
                Build size
              </label>
              <select
                id="guided-build-size"
                class="input mt-1"
                aria-describedby="guided-build-size-help"
                data-guided-build-size
              >
                {BUILD_SIZE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={option.value === DEFAULT_QUESTIONNAIRE.buildSize}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-build-size-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-build-size-help
              >
                {descriptionFor(
                  BUILD_SIZE_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.buildSize,
                )}
              </p>
            </div>

            <div>
              <label for="guided-upgrade" class="text-label text-text-primary">
                Upgrade flexibility
              </label>
              <select
                id="guided-upgrade"
                class="input mt-1"
                aria-describedby="guided-upgrade-help"
                data-guided-upgrade
              >
                {UPGRADE_OPTIONS.map((option) => (
                  <option
                    value={option.value}
                    selected={
                      option.value === DEFAULT_QUESTIONNAIRE.upgradeFlexibility
                    }
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <p
                id="guided-upgrade-help"
                class="mt-1 text-caption text-text-muted"
                data-guided-upgrade-help
              >
                {descriptionFor(
                  UPGRADE_OPTIONS,
                  DEFAULT_QUESTIONNAIRE.upgradeFlexibility,
                )}
              </p>
            </div>
          </div>

          <p
            class="field-error mt-4"
            role="alert"
            hidden
            data-guided-form-error
          ></p>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary" data-guided-generate>
              Generate recommendation
            </button>
            <button type="button" class="btn btn-secondary" data-guided-reset>
              Start over
            </button>
            <p class="text-caption text-text-muted">
              Deterministic, specification-based, no account required.
            </p>
          </div>
        </form>
      </div>

      <aside
        class="rounded-lg border border-border-subtle bg-surface-subtle p-(--layout-panel-padding)"
        aria-labelledby="guided-method-heading"
        data-guided-method
      >
        <h2 id="guided-method-heading" class="text-title text-text-primary">
          How this works
        </h2>
        <ul class="mt-3 space-y-3 text-small text-text-secondary">
          <li>
            Candidates are filtered by known socket, memory, clearance and
            connector constraints.
          </li>
          <li>
            Every candidate is checked by the shared compatibility engine.
            Unknown checks stay visible and are never treated as compatible.
          </li>
          <li>
            Power comes from the existing estimator; missing CPU or GPU power
            data is reported instead of guessed.
          </li>
          <li>
            The catalogue stores no prices. Budget figures are target
            allocations, not quotes, and no FPS or benchmark scores are claimed.
          </li>
        </ul>
      </aside>
    </div>

    <section
      class="mt-8"
      data-guided-results
      aria-labelledby="guided-results-heading"
      hidden
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-overline text-text-muted" data-guided-result-step>
            Step 2 of 2 — Recommendation
          </p>
          <h2
            id="guided-results-heading"
            class="mt-1 text-headline text-text-primary"
            tabindex="-1"
            data-guided-result-headline
          >
            Recommendation
          </h2>
          <p
            class="mt-2 max-w-(--layout-prose) text-small text-text-secondary"
            data-guided-result-explanation
          ></p>
        </div>
        <span
