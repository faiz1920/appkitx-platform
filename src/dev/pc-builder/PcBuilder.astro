    <details>
      <summary
        id="pricing-preview-heading"
        class="focus-ring min-h-11 cursor-pointer py-2 text-title text-text-primary"
      >
        Pricing architecture preview (synthetic)
      </summary>
      <div class="mt-3">
        <div
          class="rounded-md border border-warning bg-warning-subtle p-3"
          role="note"
        >
          <p class="text-small text-warning">
            <strong>Synthetic fixtures only.</strong> These sellers, prices,
            stock states and matches are development data on example domains.
            They are not real retailer offers and are never used by the
            recommendation engine.
          </p>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_240px]">
          <div class="min-w-0">
            <p class="text-label text-text-primary">Preview component</p>
            <p
              class="mt-1 break-words text-small text-text-secondary"
              data-pricing-component
            ></p>
            <p class="mt-1 text-caption text-text-muted">
              Offers are filtered to this catalogue component, market and
              currency. No cross-currency comparison is performed.
            </p>
          </div>
          <div>
            <label for="pricing-market" class="text-label text-text-primary">
              Market
            </label>
            <select
              id="pricing-market"
              class="input mt-1"
              aria-describedby="pricing-market-help"
              data-pricing-market
            >
              {EXAMPLE_MARKETS.map((market) => (
                <option
                  value={market.id}
                  selected={market.id === INDIA_MARKET_ID}
                >
                  {market.name} — {market.defaultCurrency}
                </option>
              ))}
            </select>
            <p
              id="pricing-market-help"
              class="mt-1 text-caption text-text-muted"
              data-pricing-market-help
            ></p>
          </div>
        </div>

        <div
          class="mt-4 rounded-md border border-border-subtle bg-surface-subtle p-3"
