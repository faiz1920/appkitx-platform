    let activeCategory: ComponentCategory | null = null;
    let currentRecommendation: RecommendationResult | null = null;
    let builderMode: "guided" | "manual" = "guided";
    let activeSavedBuildId: string | null = null;
    let currentBuildSource: BuildSource = "manual";
    let currentGuidedQuestionnaire: SavedBuildQuestionnaire | null = null;
    let savedBuildsCache: SavedBuild[] = [];
    let storageAvailable = true;
    let corruptSavedStore: "invalid" | "unsupported-version" | null = null;
    let pendingSave: {
      selections: SavedBuildSelection[];
      source: BuildSource;
      questionnaire: SavedBuildQuestionnaire | null;
    } | null = null;
    let pendingRenameId: string | null = null;
    let pendingConfirmation: (() => void) | null = null;
    let currentShared: {
      payload: ShareBuildPayload;
      resolution: SavedBuildResolution;
    } | null = null;
    let sharedViewOpen = false;
    const syntheticPricing = createSyntheticPricingScenario(new Date());
    let pricingMarketId = pricingMarket.value;

    const savedRepository = createSavedBuildRepository(createBrowserStorage());
    const componentLookup = (id: string) => byId.get(id);

    function statusBadge(status: CompatibilityStatus): HTMLElement {
      const badge = el(
        "span",
        `inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-micro font-medium ${STATUS_BADGE_CLASS[status]}`,
        COMPATIBILITY_STATUS_LABELS[status],
      );
      const icon = el("span", STATUS_ICON_CLASS);
      icon.setAttribute("aria-hidden", "true");
      icon.innerHTML = STATUS_ICON[status];
      badge.prepend(icon);
      return badge;
    }

    function announce(text: string): void {
      announcer.textContent = "";
      announcer.textContent = text;
    }

    /* ---------------------------------------------------------------- */
    /* Component slots                                                    */
    /* ---------------------------------------------------------------- */

    function renderSlot(category: ComponentCategory): void {
      const content = slotContent(category);
      const action = slotButton(category);
      const meta = slotMeta(category);
      const ids = state.selected[category];
      const components = ids
        .map((id) => byId.get(id))
        .filter((component): component is Component => component !== undefined);
      const limitReached =
        isMultiSlot(category) && isAtCategoryLimit(state, category);

      content.replaceChildren();

      if (components.length === 0) {
        content.append(
          el("p", "mt-3 text-small text-text-muted", "Not selected yet."),
        );
        meta.hidden = true;
        meta.textContent = "";
      } else {
        meta.hidden = false;
        meta.textContent = `${
          components.length === 1
            ? "1 selected"
            : `${components.length} selected`
        }${limitReached ? " · limit reached" : ""}`;
        for (const component of components) {
          content.append(selectedComponentCard(category, component));
        }
        if (limitReached) {
          content.append(
            el(
              "p",
              "mt-3 text-caption text-text-muted",
              `Maximum of ${maxComponentSelections[category]} selections reached for ${CATEGORY_LABELS[category]}. Remove one to add another.`,
            ),
          );
        }
      }

      const hasSelection = components.length > 0;
      const label = CATEGORY_LABELS[category];
      const actionText = limitReached
        ? `${label} limit reached`
        : isMultiSlot(category)
          ? hasSelection
            ? `Add ${label}`
            : `Select ${label}`
          : hasSelection
            ? `Change ${label}`
            : `Select ${label}`;
      action.disabled = limitReached;
      action.textContent = actionText;
      // The accessible name must match the visible label (WCAG 2.5.3).
      action.setAttribute("aria-label", actionText);
    }

    function selectedComponentCard(
      category: ComponentCategory,
      component: Component,
    ): HTMLElement {
      const card = el(
        "div",
        "mt-3 rounded-md border border-border-subtle bg-surface-subtle p-4",
      );
      const header = el(
        "div",
        "flex flex-wrap items-start justify-between gap-2",
      );
      const title = el("div", "min-w-0");
      title.append(
        el(
          "p",
          "text-body-strong text-text-primary",
          componentDisplayName(component),
        ),
        el("p", "font-mono text-caption text-text-muted", component.model),
      );

      const availability = el(
        "span",
        "rounded-full border border-border-subtle bg-surface px-2.5 py-0.5 text-micro text-text-secondary",
        availabilityLabel(component),
      );

      header.append(title, availability);
      card.append(header);

      const specs = specLines(component).slice(0, 4);
      if (specs.length > 0) {
        const list = el(
          "ul",
          "mt-3 space-y-1 text-caption text-text-secondary",
        );
        for (const line of specs) {
          const item = el("li");
          item.append(
            el("span", "text-text-muted", `${line.label}: `),
            document.createTextNode(line.value),
          );
          list.append(item);
        }
        card.append(list);
      }

      const actions = el("div", "mt-3 flex flex-wrap items-center gap-2");
      const remove = button(
        "Remove",
        "btn btn-ghost px-3 text-caption hover:bg-error-subtle hover:text-error",
      );
      remove.setAttribute(
        "aria-label",
        `Remove ${componentDisplayName(component)} from ${CATEGORY_LABELS[category]}`,
      );
      remove.addEventListener("click", () => {
        state = removeComponent(state, category, component.id);
        renderAll(
          `Removed ${componentDisplayName(component)} from ${CATEGORY_LABELS[category]}.`,
        );
        slotButton(category).focus();
      });
      actions.append(remove);
      card.append(actions);

      return card;
    }

    /* ---------------------------------------------------------------- */
    /* Compatibility panel                                               */
    /* ---------------------------------------------------------------- */

    function overallMessageFor(
      report: CompatibilityReport,
      selectedComponents: number,
    ): string {
      if (report.results.length === 0) {
        return selectedComponents === 0
          ? "Add components to run compatibility checks."
          : "No compatibility rule can run yet. Add a related component, such as a motherboard for the CPU.";
      }
      switch (report.summary.status) {
        case "incompatible":
          return "At least one confirmed conflict needs attention.";
        case "warning":
          return "The build works, with one or more considerations.";
        case "unknown":
          return "Compatibility could not be fully verified from the available specifications.";
        case "compatible":
          return "All applicable rules passed with the available data.";
        default:
          return "Compatibility could not be determined.";
      }
    }

    function setOverallBadge(
      status: CompatibilityStatus | null,
      label: string,
    ): void {
      overallBadge.textContent = label;
      overallBadge.className =
        "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-chip " +
        (status === null
          ? "border-border-strong bg-surface-muted text-text-secondary"
          : STATUS_BADGE_CLASS[status]);
      if (status !== null) {
        const icon = el("span", STATUS_ICON_CLASS);
        icon.setAttribute("aria-hidden", "true");
        icon.innerHTML = STATUS_ICON[status];
        overallBadge.prepend(icon);
      }
    }

    function findingItem(
      ruleId: string,
      status: CompatibilityStatus,
      message: string,
      componentIds: string[],
      recommendation?: string,
    ): HTMLElement {
      const item = el("li", "py-3");
      const header = el(
        "div",
        "flex flex-wrap items-center justify-between gap-2",
      );
      header.append(
        statusBadge(status),
        el("span", "break-all font-mono text-micro text-text-muted", ruleId),
      );
      item.append(header);
      item.append(
        el("p", "mt-2 break-words text-small text-text-primary", message),
      );

      const affected = componentIds
        .map((id) => {
          const component = byId.get(id);
          return component ? componentDisplayName(component) : id;
        })
        .join(" · ");
      if (affected !== "") {
        item.append(
          el(
            "p",
            "mt-1 text-caption text-text-secondary",
            `Affects: ${affected}`,
          ),
        );
      }
      if (recommendation) {
        item.append(
          el(
            "p",
            "mt-1 break-words text-caption text-text-secondary",
            `Recommended: ${recommendation}`,
          ),
        );
      }
      return item;
    }

    function renderCompatibility(
      report: CompatibilityReport,
      selectedComponents: number,
    ): void {
      const analysis = report.summary.status;
      const hasResults = report.results.length > 0;
      const label = overallStatusLabel(report, selectedComponents);
      setOverallBadge(hasResults ? analysis : null, label);
      overallMessage.textContent = overallMessageFor(
        report,
        selectedComponents,
      );

      mobileBadge.textContent = label;
      mobileBadge.className =
        "inline-flex items-center rounded-full border px-3 py-1 text-chip " +
        (hasResults
          ? STATUS_BADGE_CLASS[analysis]
          : "border-border-strong bg-surface-muted text-text-secondary");
      mobileCounts.textContent = !hasResults
        ? selectedComponents === 0
          ? "Add components to run compatibility checks."
          : "No rule applies to the current selection yet."
        : `${report.summary.counts.incompatible} incompatible · ${
            report.summary.counts.warning
          } warning${report.summary.counts.warning === 1 ? "" : "s"} · ${
            report.summary.counts.unknown
          } unknown`;

      (Object.keys(countNodes) as CompatibilityStatus[]).forEach((status) => {
        countNodes[status].textContent = String(report.summary.counts[status]);
      });

      const sorted = sortedFindings(report);
      const actionable = sorted.filter(
        (result) => result.status !== "compatible",
      );
      const compatible = sorted.filter(
        (result) => result.status === "compatible",
      );

      findingsList.replaceChildren();
      for (const result of actionable) {
        findingsList.append(
          findingItem(
            result.ruleId,
            result.status,
            result.message,
            result.componentIds,
            result.recommendation,
          ),
        );
      }

      findingsEmpty.hidden = report.results.length > 0;
      if (!hasResults) {
        findingsEmpty.textContent =
          selectedComponents === 0
            ? "Findings appear here after you select components."
            : "No rule applies to the current selection yet.";
      }

      if (compatible.length > 0) {
        const details = el("details", "py-3");
        const summary = el(
          "summary",
          "focus-ring min-h-11 cursor-pointer py-2 text-label text-accent hover:text-accent-hover",
          `Show ${compatible.length} compatible check${compatible.length === 1 ? "" : "s"}`,
        );
        details.append(summary);
        const list = el("ul", "mt-2 divide-y divide-border-subtle");
        for (const result of compatible) {
          list.append(
            findingItem(
              result.ruleId,
              result.status,
              result.message,
              result.componentIds,
              result.recommendation,
            ),
          );
        }
        details.append(list);
        findingsList.append(details);
      }
    }

    /* ---------------------------------------------------------------- */
    /* Build summary & power                                             */
    /* ---------------------------------------------------------------- */

    function renderPower(
      report: CompatibilityReport,
      components: Component[],
    ): void {
      selectedSummary.textContent = `${components.length} component${components.length === 1 ? "" : "s"} selected`;
      selectedList.replaceChildren();
      for (const component of components) {
        selectedList.append(el("li", "", componentDisplayName(component)));
      }

      const power = report.power;
      loadValue.textContent = formatPower(power.loadWatts);
      recommendedPsu.textContent = formatPower(power.recommendedPsuW);
      headroomNote.textContent = power.sufficientData
        ? `Includes ${power.headroomPercent}% headroom policy.`
        : "";

      breakdownBody.replaceChildren();
      for (const item of power.breakdown) {
        const row = el("tr");
        const label = el("td", "py-1 pr-2 text-text-secondary", item.label);
        const kind = el(
          "td",
          "py-1 pr-2 text-text-muted",
          POWER_KIND_LABELS[item.kind],
        );
        const watts = el(
          "td",
          "py-1 text-right font-mono tabular-nums text-text-primary",
          `${item.watts} W`,
        );
        row.append(label, kind, watts);
        breakdownBody.append(row);
      }
      if (power.breakdown.length === 0) {
        const row = el("tr");
        const cell = el(
          "td",
          "py-1 text-text-muted",
          "No components with power data.",
        );
        cell.colSpan = 3;
        row.append(cell);
        breakdownBody.append(row);
      }

      assumptionsList.replaceChildren();
      for (const assumption of power.assumptions) {
        assumptionsList.append(el("li", "", assumption));
      }
      if (power.assumptions.length === 0) {
        assumptionsList.append(
          el("li", "", "Select components to see power assumptions."),
        );
      }
    }

    /* ---------------------------------------------------------------- */
    /* Synthetic pricing preview (M10.7)                                 */
    /* ---------------------------------------------------------------- */

    function pricingBadge(text: string, tone: string): HTMLElement {
      return el(
        "span",
        `inline-flex items-center rounded-full border px-2.5 py-0.5 text-micro ${tone}`,
        text,
      );
    }

    function pricingMoneyText(amount: Money, market: Market): string {
      const formatted = formatMoney(amount, market.displayLocale);
      return formatted.ok ? formatted.value : "—";
    }

    function pricingDateText(iso: string | null, market: Market): string {
      if (iso === null) return "Unknown";
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return "Unknown";
      return new Intl.DateTimeFormat(market.displayLocale, {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    function pricingFreshnessTone(state: string): string {
      switch (state) {
        case "fresh":
          return "border-success bg-success-subtle text-success";
        case "aging":
          return "border-warning bg-warning-subtle text-warning";
        case "stale":
        case "expired":
          return "border-error bg-error-subtle text-error";
        default:
          return "border-border-strong bg-surface-muted text-text-secondary";
      }
    }

    function pricingAvailabilityTone(state: string): string {
      switch (state) {
        case "in-stock":
          return "border-success bg-success-subtle text-success";
        case "limited":
        case "preorder":
        case "backorder":
          return "border-warning bg-warning-subtle text-warning";
        case "out-of-stock":
          return "border-error bg-error-subtle text-error";
        default:
          return "border-border-strong bg-surface-muted text-text-secondary";
      }
    }

    function renderPricingOffer(
      offer: Offer,
      market: Market,
      excluded: ExcludedOffer | undefined,
    ): HTMLElement {
      const seller = sellerById(syntheticPricing.sellers, offer.sellerId);
      const card = el(
        "li",
        "rounded-md border border-border-subtle bg-surface-subtle p-4",
      );
      card.dataset.pricingOffer = "";
      card.dataset.pricingOfferId = offer.id;
      card.dataset.pricingOfferState =
        excluded === undefined ? "eligible" : "excluded";
      card.dataset.pricingCurrency = offer.price.currency;
      card.dataset.pricingSynthetic = "true";

      const freshness =
        excluded?.priceFreshness ??
        assessFreshness(
          offer.provenance.observedAt,
          DEFAULT_FRESHNESS_POLICY,
          new Date(),
        );
      const availability =
        excluded?.effectiveAvailability ??
        effectiveAvailability(offer, DEFAULT_FRESHNESS_POLICY, new Date())
          .state;
      const money = pricingMoneyText(offer.price, market);
      const isStale =
        freshness.state === "stale" ||
        freshness.state === "expired" ||
        freshness.state === "unknown";

      card.dataset.pricingFreshness = freshness.state;
      card.dataset.pricingAvailability = availability;
      card.dataset.pricingPrice = String(offer.price.amountMinor);

      const header = el(
        "div",
        "flex flex-wrap items-start justify-between gap-2",
      );
      const identity = el("div", "min-w-0");
      identity.append(
        el(
          "p",
          "text-body-strong text-text-primary",
          seller?.displayName ?? "Unknown synthetic seller",
        ),
        el(
          "p",
          "mt-0.5 text-caption text-text-secondary",
          `${seller ? SELLER_TYPE_LABELS[seller.sellerType] : "Seller type unknown"}${
            offer.marketplaceId
              ? ` · via marketplace ${offer.marketplaceId}`
              : ""
          }`,
        ),
      );
      const badges = el("div", "flex flex-wrap items-center gap-1.5");
      badges.append(
        pricingBadge(
          "Synthetic",
          "border-warning bg-warning-subtle text-warning",
        ),
        pricingBadge(
          freshness.state === "fresh"
            ? "Fresh"
            : FRESHNESS_LABELS[freshness.state],
          pricingFreshnessTone(freshness.state),
        ),
        pricingBadge(
          AVAILABILITY_LABELS[availability],
          pricingAvailabilityTone(availability),
        ),
      );
      header.append(identity, badges);
      card.append(header);

      const priceLine = el("div", "mt-3 flex flex-wrap items-baseline gap-2");
      priceLine.append(
        el(
          "span",
          "text-caption text-text-muted",
          isStale ? "Last observed price" : "Current price",
        ),
        el(
          "span",
          `font-mono text-title tabular-nums ${
            isStale ? "text-text-muted line-through" : "text-text-primary"
          }`,
          money,
        ),
        el(
          "span",
          "text-caption text-text-secondary",
          `${offer.price.currency} · ${market.name}`,
        ),
      );
      card.append(priceLine);

      if (offer.listPrice && offer.discount && !isStale) {
        card.append(
          el(
            "p",
            "mt-1 text-caption text-text-secondary",
            `List ${pricingMoneyText(offer.listPrice, market)} · Save ${pricingMoneyText(
              offer.discount,
              market,
            )}${
              offer.discountPercent === null
                ? ""
                : ` (${offer.discountPercent}%)`
            }`,
          ),
        );
      }

      const cost = offerCost(offer);
      const costLines = el(
        "p",
        "mt-2 break-words text-caption text-text-secondary",
      );
      costLines.textContent = [
        `Shipping: ${
          offer.shipping === null
            ? "unknown"
            : pricingMoneyText(offer.shipping, market)
        }`,
        `Tax: ${
          offer.taxInclusion === "included"
            ? "included"
            : offer.taxInclusion === "excluded"
              ? "excluded"
              : "inclusion unknown"
        }`,
        cost.total === null
          ? `Total incomplete (${cost.incompleteReasons.join(" ")})`
          : `${
              isStale ? "Last observed total" : "Total"
            }: ${pricingMoneyText(cost.total, market)}`,
      ].join(" · ");
      card.append(costLines);

      card.append(
        el(
          "p",
          "mt-1 text-caption text-text-secondary",
          `Observed ${pricingDateText(offer.provenance.observedAt, market)} · ${
            offer.provenance.matchStatus === "verified"
              ? "Verified synthetic match"
              : "Probable synthetic match"
          }`,
        ),
      );

      if (excluded !== undefined) {
        const reasons = el("p", "mt-2 break-words text-caption text-error");
        reasons.textContent = `Not current: ${excluded.reasons
          .map((reason) => EXCLUSION_REASON_LABELS[reason])
          .join(" · ")}`;
        card.append(reasons);
      }

      const footer = el("div", "mt-2 flex flex-wrap items-center gap-2");
      const source = el(
        "a",
        "focus-ring text-caption text-accent hover:text-accent-hover",
        "Synthetic source link",
      );
      source.href = offer.provenance.productUrl;
      source.target = "_blank";
      source.rel = "noopener noreferrer";
      footer.append(source);
      if (offer.restrictions.length > 0) {
        footer.append(
          el(
            "span",
            "text-micro text-text-muted",
            `${offer.restrictions.length} restriction(s) recorded`,
          ),
        );
      }
      card.append(footer);
      return card;
    }

    function renderPricingPreview(): void {
      const market =
        syntheticPricing.markets.find(
          (entry) => entry.id === pricingMarketId,
        ) ?? syntheticPricing.markets[0];
      if (!market) return;

      const selectedCpuId = state.selected.cpu[0];
      const selectedCpu = selectedCpuId ? byId.get(selectedCpuId) : undefined;
      const componentId = selectedCpu?.id ?? syntheticPricing.demoComponentId;
      const componentName = selectedCpu
        ? componentDisplayName(selectedCpu)
        : `${PRICING_DEMO_COMPONENT_LABEL} (demo)`;
      pricingComponent.dataset.pricingComponentId = componentId;
      pricingComponent.textContent = `${componentName} · ${
        selectedCpu ? "selected CPU" : "no CPU selected — demo component"
      }`;
      pricingMarketHelp.textContent = `${market.countryCode} · default currency ${
        market.defaultCurrency
      } · display locale ${market.displayLocale}. Prices are not converted.`;

      const syntheticOffers = syntheticPricing.offers.filter(
        (offer) => offer.provenance.dataOrigin === "synthetic",
      );
      const marketOffers = syntheticOffers.filter(
        (offer) =>
          offer.componentId === componentId && offer.marketId === market.id,
      );
      const aggregate = aggregateOffers(syntheticOffers, {
        componentId,
        marketId: market.id,
        currency: market.defaultCurrency,
        now: new Date(),
        minimumMatch: "verified",
        availability: "purchasable",
      });
      if (!aggregate.ok) {
        pricingSummary.textContent =
          "The synthetic pricing aggregate could not be calculated.";
        pricingOffers.replaceChildren();
        pricingEmpty.hidden = true;
        return;
      }

      const result = aggregate.value;
      pricingSummary.dataset.pricingTotalCount = String(result.totalCount);
      pricingSummary.dataset.pricingEligibleCount = String(
        result.eligibleCount,
      );
      pricingSummary.dataset.pricingStatus = result.status;
      pricingSummary.dataset.pricingCurrency = result.currency;
      pricingSummary.dataset.pricingMarketId = market.id;
      pricingSummary.replaceChildren();
      const summaryLine = el("div", "flex flex-wrap items-center gap-2");
      summaryLine.append(
        pricingBadge(
          `${result.totalCount} recorded offer${result.totalCount === 1 ? "" : "s"}`,
          "border-border-strong bg-surface text-text-secondary",
        ),
        pricingBadge(
          `${result.eligibleCount} current eligible`,
          "border-accent-subtle-border bg-accent-subtle text-accent",
        ),
        pricingBadge(
          AGGREGATE_STATUS_LABELS[result.status],
          result.status === "available"
            ? "border-success bg-success-subtle text-success"
            : "border-warning bg-warning-subtle text-warning",
        ),
      );
      pricingSummary.append(summaryLine);
      if (result.cheapest) {
        const cheapest = el("p", "mt-2 text-small text-text-primary");
        cheapest.dataset.pricingCheapest = "";
        cheapest.textContent = `Cheapest current item price: ${pricingMoneyText(
          result.cheapest.price,
          market,
        )} · ${result.currency}`;
        pricingSummary.append(cheapest);
      }
      if (result.limitations.length > 0) {
        pricingSummary.append(
          el(
            "p",
            "mt-1 break-words text-caption text-text-muted",
            result.limitations.join(" "),
          ),
        );
      }

      pricingOffers.replaceChildren();
      pricingEmpty.hidden = marketOffers.length > 0;

      if (marketOffers.length === 0) {
        pricingSummary.append(
          el(
            "p",
            "mt-2 text-caption text-text-muted",
            `${SYNTHETIC_PRICING_DISCLOSURE} No offer is fabricated for this component and market.`,
          ),
        );
        return;
      }

      for (const offer of result.eligible) {
        pricingOffers.append(renderPricingOffer(offer, market, undefined));
      }
      for (const excluded of result.excluded) {
        pricingOffers.append(
          renderPricingOffer(excluded.offer, market, excluded),
        );
      }
      if (result.status === "currency-mismatch") {
        for (const offer of marketOffers) {
          pricingOffers.append(renderPricingOffer(offer, market, undefined));
        }
      }
    }

    /* ---------------------------------------------------------------- */
    /* Render orchestration                                              */
    /* ---------------------------------------------------------------- */

    function renderAll(announcement?: string): void {
      const resolved = resolveBuild(state, (id) => byId.get(id));
      const report = evaluateBuild(resolved.components);

      for (const category of slotCategories) renderSlot(category);
      renderCompatibility(report, resolved.components.length);
      renderPower(report, resolved.components);

      progress.textContent = `${categoriesSelectedText(
        countSelectedCategories(state.selected),
      )} · ${resolved.components.length} selected`;
      clearButton.disabled = resolved.components.length === 0;

      missingNote.hidden = resolved.missingIds.length === 0;
      if (resolved.missingIds.length > 0) {
        missingNote.textContent = `Unavailable catalogue entries were skipped: ${resolved.missingIds.join(", ")}.`;
      }

      if (announcement) {
        announce(
          `${announcement} ${overallStatusLabel(report, resolved.components.length)}. ${report.summary.counts.incompatible} incompatible, ${report.summary.counts.warning} warning(s), ${report.summary.counts.unknown} unknown finding(s).`,
        );
      }
      refreshBuildActions();
      renderPricingPreview();
    }

    /* ---------------------------------------------------------------- */
    /* Guided recommendation                                             */
    /* ---------------------------------------------------------------- */

    const RECOMMENDATION_BADGE_CLASS: Record<RecommendationStatus, string> = {
      recommended: "border-success bg-success-subtle text-success",
      "recommended-with-caveats":
        "border-warning bg-warning-subtle text-warning",
      "needs-review": "border-warning bg-warning-subtle text-warning",
      "no-safe-recommendation": "border-error bg-error-subtle text-error",
      "invalid-questionnaire":
        "border-border-strong bg-surface-muted text-text-secondary",
    };

    function optionLabel<T extends string>(
      options: readonly { value: T; label: string }[],
      value: T,
    ): string {
      return options.find((option) => option.value === value)?.label ?? value;
    }

    function optionDescription<T extends string>(
      options: readonly { value: T; description: string }[],
      value: T,
    ): string {
      return (
        options.find((option) => option.value === value)?.description ?? ""
      );
    }

    function setRecommendationBadge(
      element: HTMLElement,
      status: RecommendationStatus,
    ): void {
      element.className =
        "inline-flex items-center rounded-full border px-3 py-1 text-chip " +
        RECOMMENDATION_BADGE_CLASS[status];
      element.textContent = RECOMMENDATION_STATUS_LABELS[status];
      element.title = RECOMMENDATION_STATUS_DESCRIPTIONS[status];
    }

    function setGuidedRequirementsVisible(visible: boolean): void {
      guidedRequirements.hidden = !visible;
      guidedMethod.hidden = !visible;
    }

    function setMode(mode: "guided" | "manual", focus = false): void {
      builderMode = mode;
      guidedPanel.hidden = sharedViewOpen || mode !== "guided";
      manualPanel.hidden = sharedViewOpen || mode !== "manual";
      for (const input of modeInputs) input.checked = input.value === mode;
      for (const node of manualOnly) node.hidden = mode !== "manual";
      refreshBuildActions();
      if (mode === "manual" && focus) {
        renderAll();
        manualHeading.focus();
      } else if (mode === "guided" && focus) {
        if (guidedRequirements.hidden) {
          resultHeadline.focus();
        } else {
          guidedHeading.focus();
        }
      }
    }

    function showBudgetError(message: string): void {
      budgetError.textContent = message;
      budgetError.hidden = message === "";
      if (message === "") {
        budgetInput.removeAttribute("aria-invalid");
      } else {
        budgetInput.setAttribute("aria-invalid", "true");
      }
    }

    function showFormError(message: string): void {
      formError.textContent = message;
      formError.hidden = message === "";
    }

    function setDefaultQuestionnaire(): void {
      budgetInput.value = String(DEFAULT_QUESTIONNAIRE.budget);
      useCaseSelect.value = DEFAULT_QUESTIONNAIRE.useCase;
      resolutionSelect.value = DEFAULT_QUESTIONNAIRE.resolution;
      prioritySelect.value = DEFAULT_QUESTIONNAIRE.performancePriority;
      cpuBrandSelect.value = DEFAULT_QUESTIONNAIRE.cpuBrand;
      gpuBrandSelect.value = DEFAULT_QUESTIONNAIRE.gpuBrand;
      coolingSelect.value = DEFAULT_QUESTIONNAIRE.cooling;
      buildSizeSelect.value = DEFAULT_QUESTIONNAIRE.buildSize;
      upgradeSelect.value = DEFAULT_QUESTIONNAIRE.upgradeFlexibility;
      updateQuestionnaireDescriptions();
    }

    function updateQuestionnaireDescriptions(): void {
      useCaseHelp.textContent = optionDescription(
        USE_CASE_OPTIONS,
        useCaseSelect.value as RecommendationQuestionnaire["useCase"],
      );
      resolutionHelp.textContent = optionDescription(
        RESOLUTION_OPTIONS,
        resolutionSelect.value as RecommendationQuestionnaire["resolution"],
      );
      priorityHelp.textContent = optionDescription(
        PERFORMANCE_PRIORITY_OPTIONS,
        prioritySelect.value as RecommendationQuestionnaire["performancePriority"],
      );
      cpuBrandHelp.textContent = optionDescription(
        CPU_BRAND_OPTIONS,
        cpuBrandSelect.value as RecommendationQuestionnaire["cpuBrand"],
      );
      gpuBrandHelp.textContent = optionDescription(
        GPU_BRAND_OPTIONS,
        gpuBrandSelect.value as RecommendationQuestionnaire["gpuBrand"],
      );
      coolingHelp.textContent = optionDescription(
        COOLING_OPTIONS,
        coolingSelect.value as RecommendationQuestionnaire["cooling"],
      );
      buildSizeHelp.textContent = optionDescription(
        BUILD_SIZE_OPTIONS,
        buildSizeSelect.value as RecommendationQuestionnaire["buildSize"],
      );
      upgradeHelp.textContent = optionDescription(
        UPGRADE_OPTIONS,
        upgradeSelect.value as RecommendationQuestionnaire["upgradeFlexibility"],
      );
    }

    function markRequirementsDirty(): void {
      if (!currentRecommendation) return;
      currentRecommendation = null;
      guidedResults.hidden = true;
      guidedStep.textContent = "Step 1 of 2 — Requirements";
      guidedStage.textContent = "Requirements";
      guidedTransfer.disabled = true;
      guidedStale.hidden = false;
      setGuidedRequirementsVisible(true);
      refreshBuildActions();
      announce(
        "Requirements changed. The previous recommendation was cleared. Generate again to apply the new requirements.",
      );
    }

    function readQuestionnaire(): RecommendationQuestionnaire {
      return {
        budget: Number(budgetInput.value),
        currency: CURRENCY_UNIT,
        useCase: useCaseSelect.value as RecommendationQuestionnaire["useCase"],
        resolution:
          resolutionSelect.value as RecommendationQuestionnaire["resolution"],
        performancePriority:
          prioritySelect.value as RecommendationQuestionnaire["performancePriority"],
        cpuBrand:
          cpuBrandSelect.value as RecommendationQuestionnaire["cpuBrand"],
        gpuBrand:
          gpuBrandSelect.value as RecommendationQuestionnaire["gpuBrand"],
        cooling: coolingSelect.value as RecommendationQuestionnaire["cooling"],
        buildSize:
          buildSizeSelect.value as RecommendationQuestionnaire["buildSize"],
        upgradeFlexibility:
          upgradeSelect.value as RecommendationQuestionnaire["upgradeFlexibility"],
      };
    }

    function metaItem(label: string, value: string): HTMLElement {
      const item = el(
        "div",
        "rounded-full border border-border-subtle bg-surface px-3 py-1 text-caption",
      );
      item.append(
        el("dt", "sr-only", label),
        el("dd", "text-text-secondary", `${label}: ${value}`),
      );
      return item;
    }

    function selectionCard(selection: ComponentSelection): HTMLElement {
      const card = el(
        "article",
        "rounded-lg border border-border-subtle bg-surface p-4",
      );
      card.dataset.guidedSelection = selection.category;
      card.tabIndex = -1;
      const categoryLabel = CATEGORY_LABELS[selection.category];
      const headingId = `guided-selection-${selection.category}`;
      card.setAttribute("aria-labelledby", headingId);

      const header = el(
        "div",
        "flex flex-wrap items-start justify-between gap-2",
      );
      const title = el("div", "min-w-0");
      title.append(
        el("p", "text-overline text-text-muted", categoryLabel),
        el(
          "h3",
          "mt-1 text-body-strong text-text-primary",
          `${selection.manufacturer} ${selection.name}`,
        ),
        el("p", "font-mono text-caption text-text-muted", selection.model),
      );
      title.querySelector("h3")?.setAttribute("id", headingId);
      const badges = el("div", "flex flex-wrap items-center gap-2");
      badges.append(
        statusBadge(selection.compatibilityStatus),
        el(
          "span",
          "rounded-full border border-border-subtle bg-surface-muted px-2.5 py-0.5 font-mono text-micro text-text-secondary",
          `Selection fit ${Math.round(selection.score)}/100`,
        ),
      );
      header.append(title, badges);
      card.append(header);

      if (selection.keySpecs.length > 0) {
        const specs = el(
          "dl",
          "mt-3 grid grid-cols-1 gap-x-4 gap-y-1 text-caption sm:grid-cols-2",
        );
        for (const line of selection.keySpecs) {
          const row = el("div", "flex gap-1");
          row.append(
            el("dt", "shrink-0 text-text-muted", `${line.label}:`),
            el("dd", "text-text-secondary", line.value),
          );
          specs.append(row);
        }
        card.append(specs);
      }

      card.append(
        el("p", "mt-3 text-small text-text-secondary", selection.rationale),
      );

      const actionable = selection.compatibilityFindings.filter(
        (finding) => finding.status !== "compatible",
      );
      if (actionable.length > 0) {
        const findings = el("div", "mt-3");
        findings.append(
          el("h4", "text-label text-text-primary", "Compatibility notes"),
        );
        const list = el("ul", "mt-1 space-y-1");
        for (const finding of actionable) {
          const item = el("li", "break-words text-caption text-text-secondary");
          const badge = statusBadge(finding.status);
          item.append(badge, document.createTextNode(` ${finding.message}`));
          list.append(item);
        }
        findings.append(list);
        card.append(findings);
      }

      if (selection.limitations.length > 0) {
        const limitations = el("div", "mt-3");
        limitations.append(
          el("h4", "text-label text-text-primary", "Known limitations"),
        );
        const list = el(
          "ul",
          "mt-1 space-y-1 text-caption text-text-secondary",
        );
        for (const limitation of selection.limitations) {
          list.append(el("li", "", limitation));
        }
        limitations.append(list);
        card.append(limitations);
      }

      const alternatives = el("div", "mt-4 border-t border-border-subtle pt-3");
      if (selection.alternatives.length === 0) {
        alternatives.append(
          el("h4", "text-label text-text-primary", "Alternatives"),
          el(
            "p",
            "mt-1 text-caption text-text-muted",
            "No compatible alternatives in the current catalogue.",
          ),
        );
      } else {
        const details = el("details");
        details.dataset.guidedAlternatives = "";
        const summary = el(
          "summary",
          "focus-ring min-h-11 cursor-pointer py-2 text-label text-accent hover:text-accent-hover",
          `Compare ${selection.alternatives.length} alternative${
            selection.alternatives.length === 1 ? "" : "s"
          }`,
        );
        details.append(
          summary,
          el(
            "p",
            "mt-1 text-micro text-text-muted",
            "All alternatives are rechecked against the current build. Prices are unavailable, so cost is not compared.",
          ),
        );
        const list = el("ul", "mt-2 space-y-2");
        for (const alternative of selection.alternatives) {
          list.append(alternativeItem(selection.category, alternative));
        }
        details.append(list);
        alternatives.append(details);
      }
      card.append(alternatives);
      return card;
    }

    function alternativeItem(
      category: ComponentCategory,
      alternative: AlternativeSelection,
    ): HTMLElement {
      const item = el(
        "li",
        "rounded-md border border-border-subtle bg-surface-subtle p-3",
      );
      const use = button(
        `${ALTERNATIVE_KIND_LABELS[alternative.kind]}: ${alternative.manufacturer} ${alternative.name}`,
        "btn btn-secondary h-auto min-h-11 w-full items-start justify-start whitespace-normal py-2 text-left",
      );
      use.setAttribute(
        "aria-label",
        `Use ${ALTERNATIVE_KIND_LABELS[alternative.kind].toLowerCase()} ${alternative.manufacturer} ${alternative.name} as ${CATEGORY_LABELS[category]}`,
      );
      use.addEventListener("click", () =>
        applyAlternative(category, alternative.componentId),
      );
      item.append(
        use,
        el("p", "mt-1 text-micro text-text-muted", alternative.tradeoff),
      );
      if (alternative.unknownChecks.length > 0) {
        item.append(
          el(
            "p",
            "mt-1 text-micro text-text-muted",
            `${alternative.unknownChecks.length} Unknown check(s) remain for this alternative.`,
          ),
        );
      }
      if (alternative.limitations.length > 0) {
        item.append(
          el(
            "p",
            "mt-1 text-micro text-text-muted",
            `Limitations: ${alternative.limitations.slice(0, 2).join(" ")}`,
          ),
        );
      }
      return item;
    }

    function findingGroup(
      title: string,
      findings: readonly CompatibilityFinding[],
    ): HTMLElement | null {
      if (findings.length === 0) return null;
      const group = el("div");
      group.append(
        el(
          "h4",
          "text-label text-text-primary",
          `${title} (${findings.length})`,
        ),
      );
      const list = el("ul", "mt-1 divide-y divide-border-subtle");
      for (const finding of findings) {
        list.append(
          findingItem(
            finding.ruleId,
            finding.status,
            finding.message,
            finding.componentIds,
            finding.recommendation,
          ),
        );
      }
      group.append(list);
      return group;
    }

    function renderCompatibilityPanel(result: RecommendationResult): void {
      const compatibility = result.compatibility;
      if (!compatibility) {
        guidedCompatibilityBadge.className =
          "inline-flex items-center rounded-full border px-3 py-1 text-chip border-border-strong bg-surface-muted text-text-secondary";
        guidedCompatibilityBadge.textContent = "Unavailable";
        guidedCompatibilityMessage.textContent =
          "Compatibility data is unavailable for this result.";
        guidedCountIncompatible.textContent = "0";
        guidedCountWarning.textContent = "0";
        guidedCountUnknown.textContent = "0";
        guidedCountCompatible.textContent = "0";
        guidedCompatibilityGroups.replaceChildren();
        return;
      }

      guidedCompatibilityBadge.textContent =
        COMPATIBILITY_STATUS_LABELS[compatibility.status];
      guidedCompatibilityBadge.className =
        "inline-flex items-center rounded-full border px-3 py-1 text-chip " +
        STATUS_BADGE_CLASS[compatibility.status];
      const message =
        compatibility.status === "incompatible"
          ? "At least one confirmed conflict needs attention."
          : compatibility.status === "warning"
            ? "The build works, with one or more considerations."
            : compatibility.criticalUnknowns.length > 0
              ? "A critical compatibility check could not be verified from the available data."
              : compatibility.unknownChecks.length > 0
                ? "Known constraints pass; review the Unknown checks before purchasing."
                : "All applicable checks passed with published data.";
      guidedCompatibilityBadge.title = message;
      guidedCompatibilityMessage.textContent = message;
      guidedCountIncompatible.textContent = String(
        compatibility.confirmedIncompatibilities.length,
      );
      guidedCountWarning.textContent = String(compatibility.warnings.length);
      guidedCountUnknown.textContent = String(
        compatibility.unknownChecks.length,
      );
      guidedCountCompatible.textContent = String(
        compatibility.compatibleCheckCount,
      );

      const groups: (HTMLElement | null)[] = [
        findingGroup(
          "Confirmed incompatibilities",
          compatibility.confirmedIncompatibilities,
        ),
        findingGroup("Critical Unknown checks", compatibility.criticalUnknowns),
        findingGroup("Warnings", compatibility.warnings),
        findingGroup(
          "Other Unknown checks",
          compatibility.unknownChecks.filter(
            (finding) =>
              !compatibility.criticalUnknowns.some(
                (critical) => critical.ruleId === finding.ruleId,
              ),
          ),
        ),
      ];
      guidedCompatibilityGroups.replaceChildren(
        ...groups.filter((group): group is HTMLElement => group !== null),
      );
      if (guidedCompatibilityGroups.childElementCount === 0) {
        guidedCompatibilityGroups.append(
          el(
            "p",
            "text-caption text-text-muted",
            "No incompatibilities, warnings or Unknown checks were reported.",
          ),
        );
      }
    }

    function renderPowerPanel(result: RecommendationResult): void {
      const power = result.power;
      if (!power) {
        guidedPowerLoad.textContent = "—";
        guidedPowerRecommended.textContent = "—";
        guidedPowerSelected.textContent = "—";
        guidedPowerHeadroom.textContent = "—";
        guidedPowerMissing.hidden = true;
        guidedPowerMissingList.replaceChildren();
        guidedPowerAssumptions.replaceChildren();
        return;
      }
      guidedPowerLoad.textContent = formatPower(power.estimatedLoadW);
      guidedPowerRecommended.textContent = formatPower(power.recommendedPsuW);
      guidedPowerSelected.textContent = formatPower(power.selectedPsuW);
      guidedPowerHeadroom.textContent =
        power.headroomW === null
          ? "—"
          : `${formatPower(Math.abs(power.headroomW))} ${
              power.headroomW >= 0 ? "above" : "below"
            } the recommended PSU${
              power.headroomPercent === null
                ? ""
                : ` (${Math.abs(power.headroomPercent)}%)`
            }`;

      guidedPowerMissingList.replaceChildren();
      for (const item of power.missingInformation) {
        guidedPowerMissingList.append(el("li", "", item));
      }
      guidedPowerMissing.hidden = power.missingInformation.length === 0;

      guidedPowerAssumptions.replaceChildren();
      for (const assumption of power.assumptions) {
        guidedPowerAssumptions.append(el("li", "", assumption));
      }
      if (power.assumptions.length === 0) {
        guidedPowerAssumptions.append(
          el("li", "", "No power assumptions were reported."),
        );
      }
    }

    function renderBudgetPanel(result: RecommendationResult): void {
      const budget = result.budget;
      if (!budget) {
        guidedBudgetSummary.textContent =
          "Budget allocation is unavailable for this result.";
        guidedBudgetRows.replaceChildren();
        guidedBudgetNote.textContent = "";
        return;
      }
      guidedBudgetSummary.textContent = `Budget: ${formatBudget(
        budget.budget,
        budget.currency,
      )}. Target allocation only; no component prices are stored.`;
      guidedBudgetRows.replaceChildren();
      for (const allocation of budget.allocations) {
        const row = el("tr");
        row.append(
          el(
            "td",
            "py-1 pr-2 text-text-secondary",
            CATEGORY_LABELS[allocation.category],
          ),
          el(
            "td",
            "py-1 pr-2 text-right font-mono tabular-nums text-text-secondary",
            `${allocation.percent}%`,
          ),
          el(
            "td",
            "py-1 text-right font-mono tabular-nums text-text-primary",
            `${allocation.targetAmount} ${budget.currency === CURRENCY_UNIT ? "units" : budget.currency}`,
          ),
        );
        guidedBudgetRows.append(row);
      }
      guidedBudgetNote.textContent = budget.note;
    }

    function renderConfidencePanel(result: RecommendationResult): void {
      const confidence = result.confidence;
      if (!confidence) {
        guidedConfidenceLabel.textContent = "Data confidence unavailable.";
        guidedConfidenceReasons.replaceChildren();
        guidedConfidenceMissing.hidden = true;
        guidedConfidenceUnknown.hidden = true;
        return;
      }
      guidedConfidenceLabel.textContent =
        DATA_CONFIDENCE_LABELS[confidence.level];
      guidedConfidenceReasons.replaceChildren();
      for (const reason of confidence.reasons) {
        guidedConfidenceReasons.append(el("li", "", reason));
      }
      guidedConfidenceMissingList.textContent =
        confidence.missingSpecifications.join(", ");
      guidedConfidenceMissing.hidden =
        confidence.missingSpecifications.length === 0;
      guidedConfidenceUnknownList.replaceChildren();
      for (const check of confidence.unknownCriticalChecks) {
        guidedConfidenceUnknownList.append(el("li", "", check));
      }
      guidedConfidenceUnknown.hidden =
        confidence.unknownCriticalChecks.length === 0;
    }

    function applyAlternative(
      category: ComponentCategory,
      componentId: string,
    ): void {
      if (!currentRecommendation) return;
      const updated = replaceSelectedComponent(
        currentRecommendation,
        category,
        componentId,
      );
      if (updated === currentRecommendation) {
        announce(
          "That alternative is not compatible with the current recommendation.",
        );
        return;
      }
      currentRecommendation = updated;
      renderGuidedResult(updated);
      const card = document.querySelector<HTMLElement>(
        `[data-guided-selection="${category}"]`,
      );
      const alternatives = card?.querySelector<HTMLDetailsElement>(
        "details[data-guided-alternatives]",
      );
      if (alternatives) alternatives.open = true;
      card?.focus();
      announce(
        `Replaced ${CATEGORY_LABELS[category]}. ${RECOMMENDATION_STATUS_LABELS[updated.status]}. ${updated.compatibility?.unknownChecks.length ?? 0} unknown check(s) remain.`,
      );
    }

    function renderGuidedResult(result: RecommendationResult): void {
      resultHeadline.textContent = result.summary.headline;
      resultExplanation.textContent = result.summary.explanation;
      setRecommendationBadge(resultStatus, result.status);
      resultStep.textContent = "Step 2 of 2 — Recommendation";

      resultMeta.replaceChildren(
        metaItem(
          "Use case",
          optionLabel(USE_CASE_OPTIONS, result.summary.useCase),
        ),
        metaItem(
          "Resolution",
          optionLabel(RESOLUTION_OPTIONS, result.summary.resolution),
        ),
        metaItem(
          "Priority",
          optionLabel(
            PERFORMANCE_PRIORITY_OPTIONS,
            result.summary.performancePriority,
          ),
        ),
        metaItem(
          "Budget",
          formatBudget(result.summary.budget, result.summary.currency),
        ),
        metaItem("Price data", "Unverified — no component prices stored"),
      );

      guidedSelections.replaceChildren();
      for (const entry of result.selections) {
        guidedSelections.append(selectionCard(entry));
      }
      guidedSelections.hidden = result.selections.length === 0;
      guidedSelectionsHeading.hidden = result.selections.length === 0;
      guidedTransfer.disabled = !canTransferRecommendation(result);
      guidedSave.disabled = !canTransferRecommendation(result);

      renderCompatibilityPanel(result);
      renderPowerPanel(result);
      renderBudgetPanel(result);
      renderConfidencePanel(result);

      guidedLimitations.replaceChildren();
      for (const limitation of result.limitations) {
        guidedLimitations.append(el("li", "", limitation));
      }
      if (result.limitations.length === 0) {
        guidedLimitations.append(
          el("li", "", "No additional limitations were reported."),
        );
      }

      guidedUnmetList.replaceChildren();
      for (const preference of result.unmetPreferences) {
        guidedUnmetList.append(el("li", "", preference));
      }
      guidedUnmet.hidden = result.unmetPreferences.length === 0;
    }

    function generateRecommendation(): void {
      const questionnaire = readQuestionnaire();
      const validation = validateQuestionnaire(questionnaire);
      showBudgetError("");
      showFormError("");
      if (!validation.ok) {
        const budgetIssue = validation.issues.find(
          (issue) => issue.field === "budget",
        );
        if (budgetIssue) {
          showBudgetError(budgetIssue.message);
          budgetInput.focus();
        }
        const otherMessages = validation.issues
          .filter((issue) => issue.field !== "budget")
          .map((issue) => issue.message);
        if (otherMessages.length > 0) {
          showFormError(otherMessages.join(" "));
        }
        announce(
          "Recommendation not generated. Check the highlighted requirements.",
        );
        return;
      }

      const result = recommendBuild(questionnaire);
      if (result.status === "invalid-questionnaire") {
        guidedResults.hidden = true;
        showFormError(
          result.issues.map((issue) => issue.message).join(" ") ||
            "The requirements could not be validated.",
        );
        announce(
          "Recommendation not generated. Check the highlighted requirements.",
        );
        return;
      }
      currentRecommendation = result;
      guidedStale.hidden = true;
      guidedStep.textContent = "Step 2 of 2 — Recommendation";
      guidedStage.textContent = "Recommendation";
      setGuidedRequirementsVisible(false);
      guidedResults.hidden = false;
      renderGuidedResult(result);
      resultHeadline.focus();

      if (result.status === "no-safe-recommendation") {
        announce(`No safe recommendation. ${result.summary.explanation}`);
      } else {
        announce(
          `Recommendation generated. ${RECOMMENDATION_STATUS_LABELS[result.status]}. ${result.compatibility?.unknownChecks.length ?? 0} unknown check(s), ${result.compatibility?.criticalUnknowns.length ?? 0} critical.`,
        );
      }
    }

    function resetGuided(): void {
      currentRecommendation = null;
      guidedResults.hidden = true;
      guidedStale.hidden = true;
      guidedStep.textContent = "Step 1 of 2 — Requirements";
      guidedStage.textContent = "Requirements";
      guidedTransfer.disabled = true;
      setGuidedRequirementsVisible(true);
      showBudgetError("");
      showFormError("");
      setDefaultQuestionnaire();
      budgetInput.focus();
      announce(
        "Requirements reset. Enter your preferences and generate a recommendation.",
      );
    }

    function applyTransfer(nextState: BuildState): void {
      state = nextState;
      activeSavedBuildId = null;
      currentBuildSource = "guided";
      currentGuidedQuestionnaire = currentRecommendation
        ? questionnaireMetadataFromQuestionnaire(
            currentRecommendation.questionnaire,
          )
        : null;
      clearSavedNotice();
      transferDialog.close();
      setMode("manual", false);
      renderAll("Transferred the guided recommendation to the manual builder.");
      refreshSavedBuilds();
      manualHeading.focus();
    }

    function requestTransfer(): void {
      if (
        !currentRecommendation ||
        !canTransferRecommendation(currentRecommendation)
      ) {
        return;
      }
      const nextState = recommendationToBuildState(currentRecommendation);
      if (selectedCount(nextState) === 0) return;
      if (manualBuildHasSelection(state)) {
        transferMessage.textContent = `The manual builder already has ${selectedCount(
          state,
        )} component(s) selected. Transferring this recommendation will replace them with ${selectedCount(
          nextState,
        )} recommended component(s). Continue?`;
        transferDialog.showModal();
        transferCancel.focus();
        return;
      }
      applyTransfer(nextState);
    }

    /* ---------------------------------------------------------------- */
    /* Saved builds and sharing                                          */
    /* ---------------------------------------------------------------- */

    function formatSavedDate(iso: string): string {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return iso;
      return new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    function selectionsKey(selections: readonly SavedBuildSelection[]): string {
      return selections
        .map(
          (selection) =>
            `${selection.category}:${selection.componentIds.join(",")}`,
        )
        .join("|");
    }

    function countSelections(
      selections: readonly SavedBuildSelection[],
    ): number {
      return selections.reduce(
        (sum, selection) => sum + selection.componentIds.length,
        0,
      );
    }

    function guidedContextActive(): boolean {
      return (
        builderMode === "guided" &&
        currentRecommendation !== null &&
        canTransferRecommendation(currentRecommendation)
      );
    }

    function currentSelections(): SavedBuildSelection[] {
      if (builderMode === "guided") {
        return guidedContextActive() && currentRecommendation
          ? selectionsFromBuildState(
              recommendationToBuildState(currentRecommendation),
            )
          : [];
      }
      return selectionsFromBuildState(state);
    }

    function currentSource(): BuildSource {
      return guidedContextActive() ? "guided" : currentBuildSource;
    }

    function currentQuestionnaire(): SavedBuildQuestionnaire | null {
      return guidedContextActive() && currentRecommendation
        ? questionnaireMetadataFromQuestionnaire(
            currentRecommendation.questionnaire,
          )
        : currentGuidedQuestionnaire;
    }

    function hasUnsavedBuildChanges(): boolean {
      if (selectedCount(state) === 0) return false;
      if (activeSavedBuildId === null) return true;
      const active = savedRepository.get(activeSavedBuildId);
      if (!active) return true;
      return (
        selectionsKey(selectionsFromBuildState(state)) !==
        selectionsKey(active.selections)
      );
    }

    function guidedBuildName(
      questionnaire: Pick<SavedBuildQuestionnaire, "useCase" | "resolution">,
    ): string {
      const { useCase, resolution } = questionnaire;
      const useLabel = useCase === "general" ? "general purpose" : useCase;
      const resolutionLabel =
        resolution === "not-applicable"
          ? ""
          : ` ${resolution === "4k" ? "4K" : resolution}`;
      return `Guided ${useLabel}${resolutionLabel} build`;
    }

    function defaultSavedName(): string {
      if (guidedContextActive() && currentRecommendation) {
        return guidedBuildName(currentRecommendation.questionnaire);
      }
      if (activeSavedBuildId) {
        const active = savedRepository.get(activeSavedBuildId);
        if (active) return active.name;
      }
      if (currentBuildSource === "guided" && currentGuidedQuestionnaire) {
        return guidedBuildName(currentGuidedQuestionnaire);
      }
      return "My PC build";
    }

    function showSavedError(message: string): void {
      savedErrorMessage.textContent = message;
      savedError.hidden = message === "";
      if (message !== "") savedNotice.hidden = true;
    }

    function clearSavedError(): void {
      showSavedError("");
    }

    function showSavedNotice(message: string): void {
      savedNoticeMessage.textContent = message;
      savedNotice.hidden = message === "";
      if (message !== "") savedError.hidden = true;
    }

    function clearSavedNotice(): void {
      showSavedNotice("");
    }

    function refreshBuildActions(): void {
      const selections = currentSelections();
      const hasBuild = countSelections(selections) > 0;
      const active =
        activeSavedBuildId === null
          ? null
          : savedRepository.get(activeSavedBuildId);
      const canWrite = storageAvailable && corruptSavedStore === null;

      saveNewButton.disabled = !hasBuild || !canWrite;
      saveUpdateButton.disabled =
        !hasBuild || !active || builderMode !== "manual" || !canWrite;
      shareCurrentButton.disabled = !hasBuild;
      saveNewButton.textContent = guidedContextActive()
        ? "Save recommendation as new"
        : "Save as new";
      shareCurrentButton.textContent = guidedContextActive()
        ? "Share recommendation"
        : "Share current build";

      if (active) {
        activeSaved.textContent = `Active saved build: ${active.name} (${
          BUILD_SOURCE_LABELS[active.source]
        }).${
          hasUnsavedBuildChanges()
            ? " Modified since the last save."
            : " Up to date."
        }`;
      } else if (!storageAvailable) {
        activeSaved.textContent =
          "Browser storage is unavailable. You can still open and import share links.";
      } else if (corruptSavedStore !== null) {
        activeSaved.textContent =
          "Saved builds could not be read. Reset them before saving new builds.";
      } else {
        activeSaved.textContent =
          "No saved build is active. Save the current selection to keep it in this browser.";
      }

      const showSavedControls =
        savedBuildsCache.length > 0 ||
        hasBuild ||
        !storageAvailable ||
        corruptSavedStore !== null;
      savedActions.hidden = !showSavedControls;
      activeSaved.hidden = !showSavedControls;
    }

    function savedBuildCard(build: SavedBuild): HTMLElement {
      const resolution = resolveSavedBuild(build, componentLookup);
      const card = el(
        "li",
        "min-w-0 rounded-md border border-border-subtle bg-surface p-4",
      );
      card.dataset.savedBuildId = build.id;

      const header = el(
        "div",
        "flex flex-wrap items-start justify-between gap-2",
      );
      const title = el("div", "min-w-0");
      const name = el(
        "h3",
        "break-words text-body-strong text-text-primary",
        build.name,
      );
      name.dataset.savedBuildName = "";
      title.append(
        name,
        el(
          "p",
          "mt-1 text-micro text-text-muted",
          `Created ${formatSavedDate(build.createdAt)} · Updated ${formatSavedDate(
            build.updatedAt,
          )}`,
        ),
      );
      const badges = el("div", "flex flex-wrap items-center gap-2");
      badges.append(
        el(
          "span",
          "rounded-full border border-border-subtle bg-surface-muted px-2.5 py-0.5 text-micro text-text-secondary",
          BUILD_SOURCE_LABELS[build.source],
        ),
      );
      if (build.id === activeSavedBuildId) {
        badges.append(
          el(
            "span",
            "rounded-full border border-accent-subtle-border bg-accent-subtle px-2.5 py-0.5 text-micro text-accent",
            "Active",
          ),
        );
      }
      header.append(title, badges);
      card.append(header);

      const componentCount = countSelections(build.selections);
      const names = resolution.components
        .slice(0, 3)
        .map((component) => componentDisplayName(component));
      const extra = resolution.components.length - names.length;
      const summary =
        resolution.components.length === 0
          ? `${componentCount} saved component reference(s), none available in the current catalogue.`
          : `${resolution.components.length} of ${componentCount} component(s) resolve · ${names.join(
              " · ",
            )}${extra > 0 ? ` · +${extra} more` : ""}`;
      card.append(
        el("p", "mt-2 break-words text-caption text-text-secondary", summary),
      );

      if (resolution.warnings.length > 0) {
        card.append(
          el(
            "p",
            "mt-2 break-words text-caption text-warning",
            resolution.warnings.join(" "),
          ),
        );
      }

      const actions = el("div", "mt-3 flex flex-wrap items-center gap-2");
      const load = button("Load", "btn btn-secondary");
      load.dataset.savedLoad = "";
      load.disabled = !resolution.importable;
      load.setAttribute("aria-label", `Load ${build.name}`);
      load.addEventListener("click", () => requestLoadSavedBuild(build));
      actions.append(load);

      const share = button("Share", "btn btn-ghost px-3 text-caption");
      share.dataset.savedShare = "";
      share.setAttribute("aria-label", `Share ${build.name}`);
      share.addEventListener("click", () => shareSavedBuild(build));
      actions.append(share);

      const rename = button("Rename", "btn btn-ghost px-3 text-caption");
      rename.dataset.savedRename = "";
      rename.setAttribute("aria-label", `Rename ${build.name}`);
      rename.addEventListener("click", () => openRenameDialog(build));
      actions.append(rename);

      const duplicate = button("Duplicate", "btn btn-ghost px-3 text-caption");
      duplicate.dataset.savedDuplicate = "";
      duplicate.setAttribute("aria-label", `Duplicate ${build.name}`);
      duplicate.addEventListener("click", () =>
        requestDuplicateSavedBuild(build),
      );
      actions.append(duplicate);

      const remove = button(
        "Delete",
        "btn btn-ghost px-3 text-caption hover:bg-error-subtle hover:text-error",
      );
      remove.dataset.savedDelete = "";
      remove.setAttribute("aria-label", `Delete ${build.name}`);
      remove.addEventListener("click", () => requestDeleteSavedBuild(build));
      actions.append(remove);

      card.append(actions);
      return card;
    }

    function renderSavedBuilds(): void {
      savedList.replaceChildren();
      for (const build of savedBuildsCache) {
        savedList.append(savedBuildCard(build));
      }

      if (!storageAvailable) {
        savedEmpty.textContent =
          "Saved builds are unavailable in this browser context. Share links still work.";
        savedEmpty.hidden = false;
        return;
      }
      if (corruptSavedStore !== null) {
        savedEmpty.hidden = true;
        return;
      }
      savedEmpty.textContent =
        "No saved builds yet. Configure a build or generate a recommendation, then save it to keep it in this browser.";
      savedEmpty.hidden = savedBuildsCache.length > 0;
    }

    function refreshSavedBuilds(): void {
      const result = savedRepository.list();
      savedList.replaceChildren();
      savedCorrupt.hidden = true;
      corruptSavedStore = null;

      if (!result.ok) {
        storageAvailable = false;
        savedBuildsCache = [];
        savedEmpty.hidden = true;
        showSavedError(result.error.message);
      } else {
        storageAvailable = true;
        clearSavedError();
        savedBuildsCache = result.builds;
        if (result.corrupt) {
          corruptSavedStore = result.corruptReason;
          savedBuildsCache = [];
          savedCorrupt.hidden = false;
          savedCorruptMessage.textContent =
            result.corruptReason === "unsupported-version"
              ? "Saved builds use a newer storage format than this preview supports. They were left untouched. Reset only if you do not need them."
              : "Saved-build data in this browser could not be read. It was left untouched. Reset only if you do not need it.";
        }
      }

      renderSavedBuilds();
      refreshBuildActions();
    }

    /** Restore keyboard focus to a control inside a re-rendered saved card. */
    function focusSavedBuildAction(
      id: string,
      selector = "[data-saved-rename]",
    ): void {
      const card = savedList.querySelector<HTMLElement>(
        `[data-saved-build-id="${CSS.escape(id)}"]`,
      );
      const control = card?.querySelector<HTMLElement>(selector);
      control?.focus();
    }

    function showSaveDialogError(message: string): void {
      saveError.textContent = message;
      saveError.hidden = message === "";
      if (message === "") {
        saveName.removeAttribute("aria-invalid");
      } else {
        saveName.setAttribute("aria-invalid", "true");
      }
    }

    function openSaveDialog(): void {
      const selections = currentSelections();
      if (countSelections(selections) === 0) {
        announce("Add components before saving a build.");
        return;
      }
      pendingSave = {
        selections,
        source: currentSource(),
        questionnaire: currentQuestionnaire(),
      };
      saveName.value = defaultSavedName();
      const sourceLabel = guidedContextActive()
        ? "Guided recommendation"
        : pendingSave.source === "guided"
          ? "Guided-origin build in the manual builder"
          : "Manual build";
      saveContext.textContent = `${sourceLabel} · ${countSelections(
        selections,
      )} component(s). Stored in this browser only.`;
      showSaveDialogError("");
      saveDialog.showModal();
      saveName.focus();
      saveName.select();
    }

    function submitSave(): void {
      if (!pendingSave) return;
      const name = normalizeBuildName(saveName.value);
      const validation = validateBuildName(name);
      if (!validation.ok) {
        showSaveDialogError(
          validation.issues[0]?.message ?? "Enter a valid build name.",
        );
        saveName.focus();
        return;
      }

      const result = savedRepository.create({
        name,
        selections: pendingSave.selections,
        source: pendingSave.source,
        questionnaire: pendingSave.questionnaire,
      });
      if (!result.ok) {
        showSaveDialogError(result.error.message);
        return;
      }

      // Saving from the manual builder makes the new entry active, including
      // when it originated from a transferred guided recommendation.
      if (builderMode === "manual") {
        activeSavedBuildId = result.value.id;
      }
      pendingSave = null;
      saveDialog.close();
      clearSavedError();
      showSavedNotice(`Saved "${result.value.name}" to this browser.`);
      refreshSavedBuilds();
      announce(`Saved "${result.value.name}" to this browser.`);
    }

    function updateActiveSavedBuild(): void {
      if (activeSavedBuildId === null || builderMode !== "manual") return;
      const active = savedRepository.get(activeSavedBuildId);
      if (!active) {
        refreshSavedBuilds();
        showSavedError(
          "The active saved build no longer exists. Save the current build as a new entry.",
        );
        return;
      }

      const result = savedRepository.update(activeSavedBuildId, {
        selections: selectionsFromBuildState(state),
        source: currentBuildSource,
        questionnaire: currentGuidedQuestionnaire,
      });
      if (!result.ok) {
        showSavedError(result.error.message);
        announce(`The saved build was not updated. ${result.error.message}`);
        return;
      }

      clearSavedError();
      showSavedNotice(`Updated "${result.value.name}".`);
      refreshSavedBuilds();
      announce(`Updated "${result.value.name}".`);
    }

    function openRenameDialog(build: SavedBuild): void {
      pendingRenameId = build.id;
      renameName.value = build.name;
      renameError.textContent = "";
      renameError.hidden = true;
      renameName.removeAttribute("aria-invalid");
      renameDialog.showModal();
      renameName.focus();
      renameName.select();
    }

    function submitRename(): void {
      if (pendingRenameId === null) return;
      const name = normalizeBuildName(renameName.value);
      const validation = validateBuildName(name);
      if (!validation.ok) {
        renameError.textContent =
          validation.issues[0]?.message ?? "Enter a valid build name.";
        renameError.hidden = false;
        renameName.setAttribute("aria-invalid", "true");
        renameName.focus();
        return;
      }

      const result = savedRepository.rename(pendingRenameId, name);
      if (!result.ok) {
        renameError.textContent = result.error.message;
        renameError.hidden = false;
        return;
      }

      const renamedId = pendingRenameId;
      pendingRenameId = null;
      renameDialog.close();
      clearSavedError();
      showSavedNotice(`Renamed the saved build to "${result.value.name}".`);
      refreshSavedBuilds();
      if (activeSavedBuildId === renamedId) refreshBuildActions();
      focusSavedBuildAction(renamedId);
      announce(`Renamed the saved build to "${result.value.name}".`);
    }

    function requestConfirmation(options: {
      title: string;
      message: string;
      confirmLabel: string;
      destructive?: boolean;
      onConfirm: () => void;
    }): void {
      pendingConfirmation = options.onConfirm;
      confirmTitle.textContent = options.title;
      confirmMessage.textContent = options.message;
      confirmAccept.textContent = options.confirmLabel;
      confirmAccept.className = options.destructive
        ? "btn btn-secondary text-error"
        : "btn btn-primary";
      confirmDialog.showModal();
      confirmCancel.focus();
    }

    function applyLoadedBuild(
      build: SavedBuild,
      resolution: SavedBuildResolution,
    ): void {
      state = resolution.state;
      activeSavedBuildId = build.id;
      currentBuildSource = build.source;
      currentGuidedQuestionnaire = build.questionnaire ?? null;
      clearSavedError();
      clearSavedNotice();
      if (resolution.warnings.length > 0) {
        showSavedNotice(resolution.warnings.join(" "));
      } else if (resolution.missingReferences.length > 0) {
        showSavedNotice(
          `${resolution.missingReferences.length} saved component reference(s) were unavailable and skipped.`,
        );
      }
      setMode("manual", false);
      renderAll(
        `Loaded "${build.name}".${
          resolution.warnings.length > 0
            ? ` ${resolution.warnings.join(" ")}`
            : ""
        }`,
      );
      refreshSavedBuilds();
      manualHeading.focus();
    }

    function requestLoadSavedBuild(build: SavedBuild): void {
      const resolution = resolveSavedBuild(build, componentLookup);
      if (!resolution.importable) {
        showSavedError(
          "None of this build's components exist in the current catalogue, so it cannot be loaded.",
        );
        announce(
          "The saved build could not be loaded because no component references resolve.",
        );
        return;
      }

      const load = () => applyLoadedBuild(build, resolution);
      const currentKey = selectionsKey(selectionsFromBuildState(state));
      const targetKey = selectionsKey(
        selectionsFromBuildState(resolution.state),
      );
      if (selectedCount(state) > 0 && currentKey !== targetKey) {
        requestConfirmation({
          title: "Replace the current manual build?",
          message: `The manual builder currently has ${selectedCount(
            state,
          )} selected component(s)${
            hasUnsavedBuildChanges() ? ", including unsaved changes" : ""
          }. Loading "${build.name}" will replace them.`,
          confirmLabel: "Load saved build",
          onConfirm: load,
        });
        return;
      }
      load();
    }

    function requestDuplicateSavedBuild(build: SavedBuild): void {
      const result = savedRepository.duplicate(build.id);
      if (!result.ok) {
        showSavedError(result.error.message);
        announce(`The saved build was not duplicated. ${result.error.message}`);
        return;
      }
      clearSavedError();
      showSavedNotice(`Duplicated as "${result.value.name}".`);
      refreshSavedBuilds();
      focusSavedBuildAction(result.value.id);
      announce(`Duplicated as "${result.value.name}".`);
    }

    function requestDeleteSavedBuild(build: SavedBuild): void {
      requestConfirmation({
        title: `Delete "${build.name}"?`,
        message:
          "This permanently removes the saved build from this browser. The current build and any share links are not changed.",
        confirmLabel: "Delete build",
        destructive: true,
        onConfirm: () => {
          const result = savedRepository.remove(build.id);
          if (!result.ok) {
            showSavedError(result.error.message);
            announce(
              `The saved build was not deleted. ${result.error.message}`,
            );
            return;
          }
          if (activeSavedBuildId === build.id) activeSavedBuildId = null;
          clearSavedError();
          showSavedNotice(`Deleted "${build.name}".`);
          refreshSavedBuilds();
          const next = savedBuildsCache[0];
          if (next) {
            focusSavedBuildAction(next.id);
          } else {
            savedHeading.focus();
          }
          announce(`Deleted "${build.name}".`);
        },
      });
    }

    function openShareDialog(payload: ShareBuildPayload): void {
      const encoded = encodeSharePayload(payload);
      if (!encoded.ok) {
        showSavedError(shareErrorMessage(encoded.error));
        announce(
          `The share link could not be generated. ${encoded.error.message}`,
        );
        return;
      }
      const link = buildShareLink(
        `${location.origin}${location.pathname}`,
        encoded.value,
      );
      if (!link.ok) {
        showSavedError(shareErrorMessage(link.error));
        return;
      }

      shareLink.value = link.value;
      shareOpen.href = link.value;
      shareContext.textContent = `"${payload.name}" · ${
        BUILD_SOURCE_LABELS[payload.source]
      } build · ${countSelections(payload.selections)} component(s)`;
      shareFeedback.textContent = "";
      shareDialog.showModal();
      shareLink.focus();
      shareLink.select();
    }

    function shareSavedBuild(build: SavedBuild): void {
      openShareDialog(savedBuildToSharePayload(build));
    }

    function shareCurrentBuild(): void {
      const selections = currentSelections();
      if (countSelections(selections) === 0) {
        announce("Add components before creating a share link.");
        return;
      }
      const active =
        builderMode === "manual" && activeSavedBuildId !== null
          ? savedRepository.get(activeSavedBuildId)
          : null;
      const payload = createSharePayload({
        name: active?.name ?? defaultSavedName(),
        source: currentSource(),
        selections,
        questionnaire: currentQuestionnaire(),
        createdAt: active?.createdAt ?? new Date().toISOString(),
      });
      if (!payload.ok) {
        showSavedError(shareErrorMessage(payload.error));
        announce(
          `The share link could not be generated. ${payload.error.message}`,
        );
        return;
      }
      openShareDialog(payload.value);
    }

    async function copyShareLink(): Promise<void> {
      const link = shareLink.value;
      if (link === "") return;
      try {
        if (
          !navigator.clipboard ||
          typeof navigator.clipboard.writeText !== "function"
        ) {
          throw new Error("Clipboard unavailable");
        }
        await navigator.clipboard.writeText(link);
        shareFeedback.textContent = "Link copied to the clipboard.";
        announce("Share link copied to the clipboard.");
      } catch {
        shareLink.focus();
        shareLink.select();
        shareFeedback.textContent =
          "Clipboard access is unavailable. The link is selected — copy it manually.";
        announce(
          "Clipboard access is unavailable. The link is selected for manual copying.",
        );
      }
    }

    function setStatusChip(
      element: HTMLElement,
      status: CompatibilityStatus,
    ): void {
      element.className =
        "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-chip " +
        STATUS_BADGE_CLASS[status];
      element.replaceChildren();
      const icon = el("span", STATUS_ICON_CLASS);
      icon.setAttribute("aria-hidden", "true");
      icon.innerHTML = STATUS_ICON[status];
      element.append(
        icon,
        document.createTextNode(COMPATIBILITY_STATUS_LABELS[status]),
      );
    }

    function renderSharedComponents(resolution: SavedBuildResolution): void {
      sharedComponents.replaceChildren();

      for (const component of resolution.components) {
        const item = el(
          "li",
          "rounded-md border border-border-subtle bg-surface-subtle p-4",
        );
        item.dataset.sharedComponent = component.category;
        const header = el(
          "div",
          "flex flex-wrap items-start justify-between gap-2",
        );
        const title = el("div", "min-w-0");
        title.append(
          el(
            "p",
            "text-overline text-text-muted",
            CATEGORY_LABELS[component.category],
          ),
          el(
            "h4",
            "mt-1 text-body-strong text-text-primary",
            componentDisplayName(component),
          ),
          el("p", "font-mono text-caption text-text-muted", component.model),
        );
        header.append(
          title,
          el(
            "span",
            "rounded-full border border-border-subtle bg-surface px-2.5 py-0.5 text-micro text-text-secondary",
            availabilityLabel(component),
          ),
        );
        item.append(header);

        const specs = specLines(component).slice(0, 4);
        if (specs.length > 0) {
          const list = el(
            "ul",
            "mt-2 space-y-1 text-caption text-text-secondary",
          );
          for (const line of specs) {
            const row = el("li");
            row.append(
              el("span", "text-text-muted", `${line.label}: `),
              document.createTextNode(line.value),
            );
            list.append(row);
          }
          item.append(list);
        }
        sharedComponents.append(item);
      }

      if (resolution.missingReferences.length > 0) {
        const item = el(
          "li",
          "rounded-md border border-warning bg-warning-subtle p-4",
        );
        item.append(
          el(
            "h4",
            "text-label text-warning",
            `Unavailable references (${resolution.missingReferences.length})`,
          ),
          el(
            "p",
            "mt-1 text-caption text-warning",
            "These ids are not in the current catalogue and are excluded from the imported build.",
          ),
        );
        const list = el(
          "ul",
          "mt-1 space-y-1 font-mono text-micro text-warning",
        );
        for (const reference of resolution.missingReferences) {
          list.append(
            el(
              "li",
              "break-all",
              `${reference.category}: ${reference.componentId} (${
                reference.reason === "category-mismatch"
                  ? "category mismatch"
                  : "not found"
              })`,
            ),
          );
        }
        item.append(list);
        sharedComponents.append(item);
      }

      if (sharedComponents.childElementCount === 0) {
        sharedComponents.append(
          el(
            "li",
            "text-small text-text-muted",
            "No component references in this shared build resolve to the current catalogue.",
          ),
        );
      }
    }

    function renderSharedView(
      payload: ShareBuildPayload,
      resolution: SavedBuildResolution,
    ): void {
      sharedContent.hidden = false;
      sharedError.hidden = true;
      sharedView.setAttribute("aria-labelledby", "shared-heading");
      sharedName.textContent = payload.name;
      sharedName.className = "mt-1 break-words text-headline text-text-primary";
      sharedSource.textContent = `${BUILD_SOURCE_LABELS[payload.source]} origin`;

      const questionnaire = payload.questionnaire;
      const origin = questionnaire
        ? `${questionnaire.useCase} · ${
            questionnaire.resolution === "not-applicable"
              ? "no resolution target"
              : questionnaire.resolution
          } · ${questionnaire.performancePriority.replace("-", " ")} · ${formatBudget(
            questionnaire.budget,
            questionnaire.currency,
          )}`
        : "";
      sharedMeta.textContent = `${
        payload.createdAt
          ? `Build created ${formatSavedDate(payload.createdAt)} · `
          : ""
      }${countSelections(payload.selections)} component(s) in the payload${
        origin ? ` · ${origin}` : ""
      }.`;

      sharedWarningList.replaceChildren();
      for (const warning of resolution.warnings) {
        sharedWarningList.append(el("li", "", warning));
      }
      sharedWarnings.hidden = resolution.warnings.length === 0;

      const summary = resolution.components
        .slice(0, 4)
        .map((component) => componentDisplayName(component));
      sharedSummary.textContent =
        resolution.components.length === 0
          ? "No components resolve against the current catalogue."
          : `${resolution.components.length} resolved component(s): ${summary.join(
              " · ",
            )}${resolution.components.length > summary.length ? " · …" : ""}`;
      renderSharedComponents(resolution);

      const compatibility = resolution.compatibility;
      setStatusChip(sharedCompatBadge, compatibility.summary.status);
      sharedCompatMessage.textContent = overallMessageFor(
        compatibility,
        resolution.components.length,
      );
      sharedCountIncompatible.textContent = String(
        compatibility.summary.counts.incompatible,
      );
      sharedCountWarning.textContent = String(
        compatibility.summary.counts.warning,
      );
      sharedCountUnknown.textContent = String(
        compatibility.summary.counts.unknown,
      );
      sharedCountCompatible.textContent = String(
        compatibility.summary.counts.compatible,
      );
      sharedFindings.replaceChildren();
      const actionable = compatibility.results.filter(
        (result) => result.status !== "compatible",
      );
      for (const result of actionable) {
        sharedFindings.append(
          findingItem(
            result.ruleId,
            result.status,
            result.message,
            result.componentIds,
            result.recommendation,
          ),
        );
      }
      if (actionable.length === 0) {
        sharedFindings.append(
          el(
            "li",
            "py-3 text-small text-text-secondary",
            "No incompatibilities, warnings or Unknown checks were reported.",
          ),
        );
      }

      sharedPowerLoad.textContent = formatPower(resolution.power.loadWatts);
      sharedPowerRecommended.textContent = formatPower(
        resolution.power.recommendedPsuW,
      );
      const psu = resolution.components.find(
        (component) => component.category === "psu",
      );
      sharedPowerSelected.textContent =
        psu?.category === "psu" ? formatPower(psu.specs.wattage) : "—";

      const limitations = [
        "Compatibility and power were recalculated from the current catalogue. Serialized verdicts are never reused.",
        "No component prices are stored; no quote or market estimate is implied.",
        "Share links work only where the development PC Builder preview is available. They are not public or permanently hosted.",
        "Nothing is added to your manual build until you choose Import.",
      ];
      if (resolution.missingReferences.length > 0) {
        limitations.unshift(
          `${resolution.missingReferences.length} saved component reference(s) are unavailable and excluded from the shared build.`,
        );
      }
      if (resolution.nonProductionComponents.length > 0) {
        limitations.unshift(
          `${resolution.nonProductionComponents.length} component(s) are discontinued or not verified for production availability.`,
        );
      }
      sharedLimitations.replaceChildren();
      for (const limitation of limitations) {
        sharedLimitations.append(el("li", "", limitation));
      }

      sharedSave.disabled = !storageAvailable || corruptSavedStore !== null;
      sharedSave.title = sharedSave.disabled
        ? "Browser storage is unavailable or unreadable, so a local copy cannot be saved."
        : "";
      sharedFeedback.textContent = sharedSave.disabled
        ? "Saving a local copy is unavailable because browser storage cannot be used. You can still import this build."
        : "";
    }

    function renderSharedError(message: string): void {
      currentShared = null;
      sharedContent.hidden = true;
      sharedError.hidden = false;
      sharedView.setAttribute("aria-labelledby", "shared-error-heading");
      sharedErrorMessage.textContent = message;
      sharedFeedback.textContent = "";
    }

    function openSharedView(): void {
      sharedViewOpen = true;
      for (const node of builderChrome) node.hidden = true;
      for (const node of manualOnly) node.hidden = true;
      sharedView.hidden = false;
      if (!sharedContent.hidden) {
        sharedName.focus();
      } else {
        sharedView.focus();
      }
    }

    function closeSharedView(clearHash: boolean): void {
      sharedViewOpen = false;
      sharedView.hidden = true;
      currentShared = null;
      for (const node of builderChrome) node.hidden = false;
      setMode(builderMode, false);
      if (clearHash) {
        try {
          history.replaceState(
            null,
            "",
            `${location.pathname}${location.search}`,
          );
        } catch {
          // History replacement is a convenience; the decoder stays safe.
        }
      }
      savedHeading.focus();
    }

    function handleSharedHash(): void {
      const encoded = extractSharePayloadFromHash(location.hash);
      if (encoded === null) {
        if (sharedViewOpen) closeSharedView(false);
        return;
      }

      const decoded = decodeSharePayload(encoded);
      if (!decoded.ok) {
        renderSharedError(decoded.error.message);
        openSharedView();
        return;
      }

      const resolution = resolveSharePayload(decoded.value, componentLookup);
      if (!resolution.importable) {
        renderSharedError(
          "None of the component references in this shared build exist in the current catalogue, so it cannot be imported.",
        );
        openSharedView();
        return;
      }

      currentShared = { payload: decoded.value, resolution };
      renderSharedView(decoded.value, resolution);
      openSharedView();
    }

    function importSharedBuild(): void {
      if (!currentShared) return;
      const { payload, resolution } = currentShared;
      const importNow = () => {
        state = resolution.state;
        activeSavedBuildId = null;
        currentBuildSource = payload.source;
        currentGuidedQuestionnaire = payload.questionnaire ?? null;
        clearSavedError();
        clearSavedNotice();
        closeSharedView(true);
        setMode("manual", false);
        renderAll(
          `Imported "${payload.name}" into the manual builder.${
            resolution.warnings.length > 0
              ? ` ${resolution.warnings.join(" ")}`
              : ""
          }`,
        );
        refreshSavedBuilds();
        manualHeading.focus();
      };

      const currentKey = selectionsKey(selectionsFromBuildState(state));
      const targetKey = selectionsKey(
        selectionsFromBuildState(resolution.state),
      );
      if (selectedCount(state) > 0 && currentKey !== targetKey) {
        requestConfirmation({
          title: "Replace the current manual build?",
          message: `The manual builder currently has ${selectedCount(
            state,
          )} selected component(s). Importing "${payload.name}" will replace them.`,
          confirmLabel: "Import and replace",
          onConfirm: importNow,
        });
        return;
      }
      importNow();
    }

    function saveSharedCopy(): void {
      if (!currentShared) return;
      const { payload } = currentShared;
      const result = savedRepository.create({
        name: payload.name,
        source: payload.source,
        selections: payload.selections,
        questionnaire: payload.questionnaire ?? null,
      });
      if (!result.ok) {
        sharedFeedback.textContent = `Could not save a copy: ${result.error.message}`;
        announce(`The shared build was not saved. ${result.error.message}`);
        return;
      }
      refreshSavedBuilds();
      sharedSave.disabled = true;
      sharedFeedback.textContent = `Saved a copy as "${result.value.name}". It is available after you return to the builder.`;
      announce(`Saved a copy of the shared build as "${result.value.name}".`);
    }

    /* ---------------------------------------------------------------- */
    /* Picker                                                            */
    /* ---------------------------------------------------------------- */

    function pickerComponents(): Component[] {
      if (!activeCategory) return [];
      const components = sortedCatalogue.filter(
        (component) => component.category === activeCategory,
      );
      return filterComponents(components, {
        search: pickerSearch.value,
        manufacturer: pickerManufacturer.value || null,
      });
    }

    function populateManufacturers(category: ComponentCategory): void {
      const all = componentsByCategory(category);
      pickerManufacturer.replaceChildren(
        new Option("All manufacturers", ""),
        ...manufacturerOptions(all).map(
          (manufacturer) => new Option(manufacturer, manufacturer),
        ),
      );
    }

    function pickerResultCard(component: Component): HTMLElement {
      const category = component.category;
      const card = el(
        "li",
        "rounded-md border border-border-subtle bg-surface p-4",
      );
      const header = el(
        "div",
        "flex flex-wrap items-start justify-between gap-3",
      );
      const title = el("div", "min-w-0");

      if (component.image) {
        const image = el(
          "img",
          "mb-2 h-20 w-20 rounded-md border border-border-subtle object-contain",
        );
        image.src = component.image;
        image.alt = `${componentDisplayName(component)} product image`;
        image.loading = "lazy";
        title.append(image);
      }

      title.append(
        el(
          "p",
          "text-body-strong text-text-primary",
          componentDisplayName(component),
        ),
        el("p", "font-mono text-caption text-text-muted", component.model),
        el(
          "span",
          "mt-1 inline-flex rounded-full border border-border-subtle bg-surface px-2.5 py-0.5 text-micro text-text-secondary",
          availabilityLabel(component),
        ),
      );
      header.append(title);

      const alreadySelected = state.selected[category].includes(component.id);
      const atLimit =
        isMultiSlot(category) && isAtCategoryLimit(state, category);
      if (isMultiSlot(category)) {
        const add = button(
          alreadySelected ? "Added" : atLimit ? "Limit reached" : "Add",
          "btn btn-primary",
        );
        add.disabled = alreadySelected || atLimit;
        add.setAttribute(
          "aria-label",
          alreadySelected
            ? `${componentDisplayName(component)} is already added`
            : atLimit
              ? `Maximum of ${maxComponentSelections[category]} selections reached for ${CATEGORY_LABELS[category]}; remove one first`
              : `Add ${componentDisplayName(component)} to the build`,
        );
        if (!alreadySelected && !atLimit) {
          add.addEventListener("click", () => chooseComponent(component));
        }
        header.append(add);
      } else {
        const select = button(
          alreadySelected ? "Selected" : "Select",
          alreadySelected ? "btn btn-secondary" : "btn btn-primary",
        );
        select.disabled = alreadySelected;
        select.setAttribute(
          "aria-label",
          alreadySelected
            ? `${componentDisplayName(component)} is selected`
            : `Select ${componentDisplayName(component)}`,
        );
        if (!alreadySelected) {
          select.addEventListener("click", () => chooseComponent(component));
        }
        header.append(select);
      }

      card.append(header);

      if (!alreadySelected && !atLimit) {
        const nextState = selectComponent(state, category, component.id);
        const nextReport = evaluateBuild(
          resolveBuild(nextState, componentLookup).components,
        );
        const candidateFindings = nextReport.results.filter((result) =>
          result.componentIds.includes(component.id),
        );
        const problem =
          candidateFindings.find(
            (result) => result.status === "incompatible",
          ) ?? candidateFindings.find((result) => result.status === "warning");
        if (problem) {
          card.append(
            el(
              "p",
              `mt-2 break-words text-caption ${
                problem.status === "incompatible"
                  ? "text-error"
                  : "text-warning"
              }`,
              `With the current build: ${COMPATIBILITY_STATUS_LABELS[problem.status]} — ${problem.message}`,
            ),
          );
        }
      }

      const specs = specLines(component);
      if (specs.length > 0) {
        const list = el(
          "dl",
          "mt-3 grid grid-cols-1 gap-x-4 gap-y-1 text-caption sm:grid-cols-2",
        );
        for (const line of specs) {
          const row = el("div", "flex gap-1");
          row.append(
            el("dt", "shrink-0 text-text-muted", `${line.label}:`),
            el("dd", "text-text-secondary", line.value),
          );
          list.append(row);
        }
        card.append(list);
      }

      const gaps = missingSpecLabels(component);
      if (gaps.length > 0) {
        card.append(
          el(
            "p",
            "mt-2 text-micro text-text-muted",
            `Not published: ${gaps.join(", ")}.`,
          ),
        );
      }

      const footer = el("div", "mt-3 flex flex-wrap items-center gap-2");
      const sourceUrl = component.url ?? component.source.url;
      const source = el(
        "a",
        "focus-ring text-caption text-accent hover:text-accent-hover",
        "Manufacturer specification",
      );
      source.href = sourceUrl;
      source.target = "_blank";
      source.rel = "noopener noreferrer";
      footer.append(
        source,
        el(
          "span",
          "text-micro text-text-muted",
          `· ${componentSourceLabel(component)}`,
        ),
      );
      card.append(footer);

      return card;
    }

    function renderPickerResults(): void {
      if (!activeCategory) return;
      const components = pickerComponents();
      const total = componentsByCategory(activeCategory).length;

      pickerResults.replaceChildren();
      for (const component of components) {
        pickerResults.append(pickerResultCard(component));
      }

      const limitReached =
        activeCategory !== null &&
        isMultiSlot(activeCategory) &&
        isAtCategoryLimit(state, activeCategory);
      pickerCount.textContent =
        (components.length === total
          ? `${total} component${total === 1 ? "" : "s"} available`
          : `${components.length} of ${total} components match`) +
        (limitReached
          ? ` · maximum of ${maxComponentSelections[activeCategory]} reached`
          : "");

      const empty = components.length === 0;
      pickerEmpty.hidden = !empty;
      pickerResults.hidden = empty;
      if (empty) {
        const query = pickerSearch.value.trim();
        const manufacturer = pickerManufacturer.value;
        pickerEmptyMessage.textContent =
          query !== "" || manufacturer !== ""
            ? `No components match ${query !== "" ? `"${query}"` : ""}${
                query !== "" && manufacturer !== "" ? " with " : ""
              }${manufacturer !== "" ? `manufacturer ${manufacturer}` : ""}. Try a different search or filter.`
            : "This category has no catalogue records yet.";
      }
    }

    function openPicker(category: ComponentCategory): void {
      activeCategory = category;
      const label = CATEGORY_LABELS[category];
      pickerTitle.textContent = isMultiSlot(category)
        ? `Add ${label}`
        : `Select ${label}`;
      pickerSearch.value = "";
      populateManufacturers(category);
      pickerManufacturer.value = "";
      renderPickerResults();
      dialog.showModal();
      pickerSearch.focus();
    }

    function chooseComponent(component: Component): void {
      const category = component.category;
      const action = isMultiSlot(category) ? "Added" : "Selected";
      state = selectComponent(state, category, component.id);
      dialog.close();
      renderAll(
        `${action} ${componentDisplayName(component)} as ${CATEGORY_LABELS[category]}.`,
      );
      slotButton(category).focus();
    }

    /* ---------------------------------------------------------------- */
    /* Events                                                            */
    /* ---------------------------------------------------------------- */

    for (const category of slotCategories) {
      slotButton(category).addEventListener("click", () =>
        openPicker(category),
      );
    }

    pickerSearch.addEventListener("input", renderPickerResults);
    pickerManufacturer.addEventListener("change", renderPickerResults);
    pickerClose.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      // Light-dismiss when clicking the backdrop (the dialog element itself).
      if (event.target === dialog) dialog.close();
    });

    const clearManualBuild = (): void => {
      state = clearBuild();
      activeSavedBuildId = null;
      currentBuildSource = "manual";
      currentGuidedQuestionnaire = null;
      clearSavedNotice();
      renderAll("Build cleared.");
      refreshSavedBuilds();
      manualHeading.focus();
    };

    clearButton.addEventListener("click", () => {
      if (selectedCount(state) === 0) return;
      if (hasUnsavedBuildChanges()) {
        requestConfirmation({
          title: "Clear the current build?",
          message: `This removes ${selectedCount(
            state,
          )} selected component(s) and discards changes that are not saved to the active build. Saved builds and share links are not changed.`,
          confirmLabel: "Clear build",
          destructive: true,
          onConfirm: clearManualBuild,
        });
        return;
      }
      clearManualBuild();
    });

    for (const input of modeInputs) {
      input.addEventListener("change", () => {
        if (input.checked) {
          setMode(input.value === "manual" ? "manual" : "guided", true);
        }
      });
    }

    guidedForm.addEventListener("submit", (event) => {
      event.preventDefault();
      generateRecommendation();
    });
    budgetInput.addEventListener("input", () => {
      showBudgetError("");
      markRequirementsDirty();
    });
    for (const select of [
      useCaseSelect,
      resolutionSelect,
      prioritySelect,
      cpuBrandSelect,
      gpuBrandSelect,
      coolingSelect,
      buildSizeSelect,
      upgradeSelect,
    ]) {
      select.addEventListener("change", () => {
        updateQuestionnaireDescriptions();
        markRequirementsDirty();
      });
    }

    mobileReview.addEventListener("click", () => {
      compatibilityHeading.scrollIntoView({ block: "start" });
      compatibilityHeading.focus();
    });

    pricingMarket.addEventListener("change", () => {
      pricingMarketId = pricingMarket.value;
      renderPricingPreview();
    });

    requireEl<HTMLButtonElement>("[data-guided-edit]").addEventListener(
      "click",
      () => {
        setGuidedRequirementsVisible(true);
        guidedStep.textContent = "Step 1 of 2 — Requirements";
        guidedStage.textContent = "Requirements";
        budgetInput.focus();
        budgetInput.scrollIntoView({ block: "center" });
        announce(
          "Edit the requirements, then generate the recommendation again.",
        );
      },
    );
    requireEl<HTMLButtonElement>("[data-guided-regenerate]").addEventListener(
      "click",
      () => guidedForm.requestSubmit(),
    );
    requireEl<HTMLButtonElement>("[data-guided-start-over]").addEventListener(
      "click",
      () => resetGuided(),
    );
    guidedTransfer.addEventListener("click", () => requestTransfer());

    transferCancel.addEventListener("click", () => transferDialog.close());
    transferConfirm.addEventListener("click", () => {
      if (!currentRecommendation) return;
      applyTransfer(recommendationToBuildState(currentRecommendation));
    });
    transferDialog.addEventListener("click", (event) => {
      if (event.target === transferDialog) transferDialog.close();
    });

    saveNewButton.addEventListener("click", openSaveDialog);
    saveUpdateButton.addEventListener("click", updateActiveSavedBuild);
    shareCurrentButton.addEventListener("click", shareCurrentBuild);
    requireEl<HTMLButtonElement>("[data-guided-save]").addEventListener(
      "click",
      openSaveDialog,
    );

    saveConfirm.addEventListener("click", submitSave);
    saveCancel.addEventListener("click", () => saveDialog.close());
    saveName.addEventListener("input", () => showSaveDialogError(""));
    saveName.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        submitSave();
      }
    });
    saveDialog.addEventListener("click", (event) => {
      if (event.target === saveDialog) saveDialog.close();
    });
    saveDialog.addEventListener("close", () => {
      pendingSave = null;
    });

    renameConfirm.addEventListener("click", submitRename);
    renameCancel.addEventListener("click", () => renameDialog.close());
    renameName.addEventListener("input", () => {
      renameError.textContent = "";
      renameError.hidden = true;
      renameName.removeAttribute("aria-invalid");
    });
    renameName.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        submitRename();
      }
    });
    renameDialog.addEventListener("click", (event) => {
      if (event.target === renameDialog) renameDialog.close();
    });
    renameDialog.addEventListener("close", () => {
      pendingRenameId = null;
    });

    confirmAccept.addEventListener("click", () => {
      const action = pendingConfirmation;
      pendingConfirmation = null;
      confirmDialog.close();
      action?.();
    });
    confirmCancel.addEventListener("click", () => {
      pendingConfirmation = null;
      confirmDialog.close();
    });
    confirmDialog.addEventListener("click", (event) => {
      if (event.target === confirmDialog) {
        pendingConfirmation = null;
        confirmDialog.close();
      }
    });
    confirmDialog.addEventListener("close", () => {
      pendingConfirmation = null;
    });

    shareCopy.addEventListener("click", () => {
      void copyShareLink();
    });
    shareClose.addEventListener("click", () => shareDialog.close());
    shareOpen.addEventListener("click", () => shareDialog.close());
    shareDialog.addEventListener("click", (event) => {
      if (event.target === shareDialog) shareDialog.close();
    });

    sharedImport.addEventListener("click", importSharedBuild);
    sharedSave.addEventListener("click", saveSharedCopy);
    for (const returnButton of sharedReturnButtons) {
      returnButton.addEventListener("click", () => closeSharedView(true));
    }

    savedReset.addEventListener("click", () => {
      requestConfirmation({
        title: "Reset saved builds?",
        message:
          "This permanently removes all saved-build data from this browser. The current build and any share links are not changed.",
        confirmLabel: "Reset saved builds",
        destructive: true,
        onConfirm: () => {
          const result = savedRepository.reset();
          if (!result.ok) {
            showSavedError(result.error.message);
            announce(`Saved builds were not reset. ${result.error.message}`);
            return;
          }
          activeSavedBuildId = null;
          clearSavedError();
          clearSavedNotice();
          refreshSavedBuilds();
          savedHeading.focus();
          announce("Saved-build data reset.");
        },
      });
    });

    window.addEventListener("hashchange", handleSharedHash);

    setDefaultQuestionnaire();
    setMode("guided", false);
    refreshSavedBuilds();
    renderAll();
    handleSharedHash();
  }
</script>
