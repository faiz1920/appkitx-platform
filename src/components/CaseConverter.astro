---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import shieldCheckIcon from "lucide-static/icons/shield-check.svg?raw";
import { defaultLocale, getDictionary, type LocaleCode } from "../i18n/config";
import { CASE_MODES } from "../lib/case-convert";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.caseConverter;

const defaultMode = CASE_MODES[0];
---

<div data-case-converter>
  <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
    <label for="case-converter-mode" class="text-label text-text-primary">
      {tool.modeLabel}
    </label>
    <select
      id="case-converter-mode"
      class="input mt-2"
      aria-describedby="case-converter-mode-hint"
      data-case-mode
    >
      {CASE_MODES.map((mode) => (
        <option value={mode} selected={mode === defaultMode}>
          {tool.modes[mode]}
        </option>
      ))}
    </select>
    <p id="case-converter-mode-hint" class="mt-1 text-caption text-text-muted">
      {tool.modeHint}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-secondary" disabled data-copy>
        <span
          class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
          aria-hidden="true"
          set:html={copyIcon}
        />
        {tool.copyOutput}
      </button>
      <button type="button" class="btn btn-ghost" data-reset>
        {t.calculator.reset}
      </button>
    </div>

    <div class="mt-3" role="status" aria-live="polite">
      <p
        class="flex items-center gap-1.5 text-caption text-success"
        hidden
        data-copy-success
      >
        <span
          class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
          aria-hidden="true"
          set:html={checkIcon}
        />
        {tool.copySuccess}
      </p>
      <p
        class="flex items-center gap-1.5 text-caption text-error"
        hidden
        data-copy-error
      >
        <span
          class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
          aria-hidden="true"
          set:html={alertIcon}
        />
        {tool.copyFailure}
      </p>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div>
      <label for="case-converter-input" class="text-label text-text-primary">
        {tool.inputLabel}
      </label>
      <textarea
        id="case-converter-input"
        class="textarea mt-2 min-h-[200px]"
        placeholder={tool.inputPlaceholder}
        autocomplete="off"
        aria-describedby="case-converter-input-hint"
        data-case-input
      ></textarea>
      <p
        id="case-converter-input-hint"
        class="mt-1 text-caption text-text-muted"
      >
        {tool.inputHint}
      </p>
    </div>

    <div>
      <label for="case-converter-output" class="text-label text-text-primary">
        {tool.outputLabel}
      </label>
      <textarea
        id="case-converter-output"
        class="textarea mt-2 min-h-[200px] bg-surface-subtle font-mono text-[15px]"
        placeholder={tool.outputPlaceholder}
        readonly
        aria-describedby="case-converter-output-hint"
        data-case-output
      ></textarea>
      <p
        id="case-converter-output-hint"
        class="mt-1 text-caption text-text-muted"
      >
        {tool.outputHint}
      </p>
    </div>
  </div>

  <div class="mt-6 flex items-start gap-3 rounded-md border border-accent-subtle-border bg-accent-subtle p-3">
    <span
      class="mt-0.5 h-5 w-5 shrink-0 text-accent [&_svg]:h-5 [&_svg]:w-5"
      aria-hidden="true"
      set:html={shieldCheckIcon}
    />
    <div>
      <p class="text-label text-text-primary">{tool.privacyTitle}</p>
      <p class="mt-1 text-caption text-text-secondary">{tool.privacyBody}</p>
    </div>
  </div>
</div>

<script>
  import { CASE_MODES, convertCase, type CaseMode } from "../lib/case-convert";

  const root = document.querySelector<HTMLElement>("[data-case-converter]");

  if (root) {
    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Case converter: missing ${selector}`);
      return el;
    };

    const input = requireEl<HTMLTextAreaElement>("[data-case-input]");
    const output = requireEl<HTMLTextAreaElement>("[data-case-output]");
    const modeSelect = requireEl<HTMLSelectElement>("[data-case-mode]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");
    const copySuccess = requireEl<HTMLElement>("[data-copy-success]");
    const copyError = requireEl<HTMLElement>("[data-copy-error]");

    const defaultMode: CaseMode = CASE_MODES[0];
    let feedbackTimer: number | undefined;
    let copyBusy = false;

    const isCaseMode = (value: string): value is CaseMode =>
      (CASE_MODES as readonly string[]).includes(value);

    const readMode = (): CaseMode =>
      isCaseMode(modeSelect.value) ? modeSelect.value : defaultMode;

    const clearFeedback = (): void => {
      window.clearTimeout(feedbackTimer);
      copySuccess.hidden = true;
      copyError.hidden = true;
    };

    const showFeedback = (message: HTMLElement): void => {
      window.clearTimeout(feedbackTimer);
      copySuccess.hidden = true;
      copyError.hidden = true;
      message.hidden = false;
      feedbackTimer = window.setTimeout(() => {
        message.hidden = true;
      }, 3000);
    };

    const render = (): void => {
      const converted = convertCase(input.value, readMode());
      output.value = converted;
      copyButton.disabled = converted === "";
    };

    input.addEventListener("input", () => {
      clearFeedback();
      render();
    });

    modeSelect.addEventListener("change", () => {
      clearFeedback();
      render();
    });

    copyButton.addEventListener("click", async () => {
      if (output.value === "" || copyBusy) return;
      copyBusy = true;
      clearFeedback();

      try {
        if (!navigator.clipboard) throw new Error("Clipboard unavailable");
        await navigator.clipboard.writeText(output.value);
        showFeedback(copySuccess);
      } catch {
        showFeedback(copyError);
      } finally {
        copyBusy = false;
      }
    });

    resetButton.addEventListener("click", () => {
      input.value = "";
      modeSelect.value = defaultMode;
      clearFeedback();
      render();
      input.focus();
    });

    render();
  }
</script>
