---
import menuIcon from "lucide-static/icons/menu.svg?raw";
import searchIcon from "lucide-static/icons/search.svg?raw";
import { defaultLocale, getDictionary, type LocaleCode } from "../i18n/config";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);

const links = [
  { href: "#tools", label: t.nav.tools },
  { href: "#tools", label: t.nav.categories },
  { href: "#tools", label: t.nav.about },
];
---

<header class="sticky top-0 z-40 border-b border-border-subtle bg-surface">
  <nav
    aria-label={t.nav.ariaLabel}
    class="mx-auto flex h-(--layout-nav-height) max-w-(--layout-container) items-center justify-between gap-6 px-6"
  >
    <a
      href="/"
      class="focus-ring font-sans text-[18px] leading-none font-semibold text-text-primary"
    >
      AppKitX
    </a>

    <div class="flex items-center gap-2 md:gap-6">
      <ul class="hidden items-center gap-6 md:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="focus-ring text-label text-text-secondary hover:text-text-primary active:text-accent-active"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="btn btn-secondary gap-2 px-4"
        aria-label={t.search.label}
        data-search-trigger
      >
        <span
          class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
          aria-hidden="true"
          set:html={searchIcon}
        />
        <span class="hidden text-label font-normal md:inline">
          {t.nav.searchLabel}
        </span>
        <kbd class="kbd hidden md:inline-flex">{t.nav.searchShortcut}</kbd>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="global-menu"
        class="btn btn-secondary w-11 px-0 md:hidden"
        aria-label={t.nav.menuAriaLabel}
      >
        <span
          class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
          aria-hidden="true"
          set:html={menuIcon}
        />
      </button>
    </div>
  </nav>

  <div
    id="global-menu"
    hidden
    class="border-t border-border-subtle bg-surface md:hidden"
  >
    <ul class="mx-auto flex max-w-(--layout-container) flex-col px-6 py-2">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="focus-ring flex h-12 items-center text-label text-text-secondary hover:text-text-primary active:text-accent-active"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("#global-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.toggleAttribute("hidden", open);
  });

  const searchTrigger = document.querySelector<HTMLButtonElement>(
    "[data-search-trigger]",
  );
  searchTrigger?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("appkitx:search-open"));
  });
</script>
