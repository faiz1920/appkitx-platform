---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import infoIcon from "lucide-static/icons/info.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import { CURATED_TIME_ZONES } from "../lib/time-zone";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.timeZoneConverter;
const localeMeta = getLocale(locale);

const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-time-zone-converter data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-calculator-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <div class="space-y-5">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="tz-input-date" class="text-label text-text-primary">
              {tool.dateLabel}
            </label>
            <input
              id="tz-input-date"
              name="date"
              type="date"
              min="1900-01-01"
              max="2100-12-31"
              class="input mt-2 font-mono tabular-nums"
              aria-describedby="tz-hint-date tz-error-date tz-error-gap"
              data-input-date
            />
            <p id="tz-hint-date" class="mt-1 text-caption text-text-muted">
              {tool.dateHint}
            </p>
            <p
              id="tz-error-date"
              class="field-error mt-1"
              role="alert"
              aria-atomic="true"
              hidden
              data-error-date
            >
              <span aria-hidden="true" set:html={alertIcon} />
              <span data-error-text-date></span>
            </p>
          </div>

          <div>
            <label for="tz-input-time" class="text-label text-text-primary">
              {tool.timeLabel}
            </label>
            <input
              id="tz-input-time"
              name="time"
              type="time"
              step="60"
              class="input mt-2 font-mono tabular-nums"
              aria-describedby="tz-hint-time tz-error-time tz-error-gap"
              data-input-time
            />
            <p id="tz-hint-time" class="mt-1 text-caption text-text-muted">
              {tool.timeHint}
            </p>
            <p
              id="tz-error-time"
              class="field-error mt-1"
              role="alert"
              aria-atomic="true"
              hidden
              data-error-time
            >
              <span aria-hidden="true" set:html={alertIcon} />
              <span data-error-text-time></span>
            </p>
          </div>
        </div>

        <div>
          <label for="tz-input-source" class="text-label text-text-primary">
            {tool.sourceZoneLabel}
          </label>
          <select
            id="tz-input-source"
            name="sourceZone"
            class="input mt-2"
            aria-describedby="tz-hint-source tz-error-source"
            data-input-source
          >
            {CURATED_TIME_ZONES.map((zone) => (
              <option value={zone} selected={zone === "UTC"}>
                {tool.zoneLabels[zone]}
              </option>
            ))}
          </select>
          <p id="tz-hint-source" class="mt-1 text-caption text-text-muted">
            {tool.sourceZoneHint}
          </p>
          <p
            id="tz-error-source"
            class="field-error mt-1"
            role="alert"
            aria-atomic="true"
            hidden
            data-error-source
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-source></span>
          </p>
        </div>

        <div>
          <label for="tz-input-target" class="text-label text-text-primary">
            {tool.targetZoneLabel}
          </label>
          <select
            id="tz-input-target"
            name="targetZone"
            class="input mt-2"
            aria-describedby="tz-hint-target tz-error-target"
            data-input-target
          >
            {CURATED_TIME_ZONES.map((zone) => (
              <option value={zone} selected={zone === "Europe/London"}>
                {tool.zoneLabels[zone]}
              </option>
            ))}
          </select>
          <p id="tz-hint-target" class="mt-1 text-caption text-text-muted">
            {tool.targetZoneHint}
          </p>
          <p
            id="tz-error-target"
            class="field-error mt-1"
            role="alert"
            aria-atomic="true"
            hidden
            data-error-target
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-target></span>
          </p>
        </div>

        <p
          id="tz-error-gap"
          class="field-error"
          role="alert"
          aria-atomic="true"
          hidden
          data-error-gap
        >
          <span aria-hidden="true" set:html={alertIcon} />
          <span data-error-text-gap></span>
        </p>

        <p
          class="field-error"
          role="alert"
          aria-atomic="true"
          hidden
          data-error-general
        >
          <span aria-hidden="true" set:html={alertIcon} />
          <span data-error-text-general></span>
        </p>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <button type="button" class="btn btn-secondary w-full" data-current>
            {tool.useCurrentTime}
          </button>
          <button type="button" class="btn btn-secondary w-full" data-reset>
            {t.calculator.reset}
          </button>
        </div>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 pr-14">
      <p class="text-caption text-text-secondary">{tool.convertedTimeLabel}</p>
      <div class="mt-1 flex flex-wrap items-baseline gap-3">
        <p class="text-mono-result text-text-disabled" data-target-time>
          —
        </p>
        <span
          class="inline-flex items-center rounded-full border border-border-subtle bg-surface px-3 py-1 text-caption font-medium text-text-secondary"
          hidden
          data-day-badge
        ></span>
      </div>
      <p class="mt-1 text-small text-text-secondary" data-target-zone>
        —
      </p>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-4 pr-14 sm:grid-cols-2">
      <div>
        <p class="text-caption text-text-secondary">
          {tool.convertedDateLabel}
        </p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-target-date
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.weekdayLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-target-weekday
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.sourceOffsetLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-source-offset
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.targetOffsetLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-target-offset
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.differenceLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-difference
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.dayChangeLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-day-change
        >
          —
        </p>
      </div>
    </div>

    <div class="mt-4 border-t border-accent-subtle-border pt-3">
      <p class="text-caption text-text-secondary">{tool.sourceSummaryLabel}</p>
      <p
        class="mt-1 font-mono text-small tabular-nums text-text-disabled"
        data-source-summary
      >
        —
      </p>
      <p class="mt-3 text-caption text-text-secondary">
        {tool.targetSummaryLabel}
      </p>
      <p
        class="mt-1 font-mono text-small tabular-nums text-text-disabled"
        data-target-summary
      >
        —
      </p>
    </div>

    <div
      class="mt-4 flex items-start gap-2 rounded-md border border-border-subtle bg-surface p-3 text-small text-text-secondary"
      hidden
      role="status"
      data-ambiguous-notice
    >
      <span
        class="mt-0.5 h-4 w-4 shrink-0 [&_svg]:h-4 [&_svg]:w-4"
        aria-hidden="true"
        set:html={infoIcon}
      />
      <span data-ambiguous-text></span>
    </div>

    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={tool.copySummary}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>

  <p class="mt-4 text-caption text-text-muted">{tool.dataNote}</p>

  <section class="mt-8" aria-labelledby="tz-comparison-heading">
    <h2 id="tz-comparison-heading" class="text-title text-text-primary">
      {tool.comparisonHeading}
    </h2>
    <p class="mt-1 text-small text-text-secondary">{tool.comparisonHint}</p>
    <p class="mt-3 text-small text-text-muted" data-comparison-empty>
      {tool.comparisonEmpty}
    </p>
    <div
      class="mt-4 overflow-x-auto focus-ring"
      role="region"
      tabindex="0"
      aria-label={tool.comparisonScrollLabel}
      data-comparison
      hidden
    ></div>
  </section>
</div>

<script>
  import {
    COMPARISON_TIME_ZONES,
    convertTimeZone,
    dayOffsetBetween,
    deviceTimeZone,
    formatUtcOffset,
    formatZoneDate,
    formatZoneTime,
    formatZoneWeekday,
    isValidTimeZone,
    offsetMinutesAt,
    zoneCityLabel,
    zonedParts,
    type TimeZoneConversion,
    type TimeZoneIssue,
  } from "../lib/time-zone";
  import { formatDateInput } from "../lib/date-math";
  import { interpolate } from "../i18n/interpolate";
  import type {
    CalculatorStrings,
    TimeZoneConverterToolStrings,
  } from "../i18n/dictionary";

  const root = document.querySelector<HTMLElement>(
    "[data-time-zone-converter]",
  );

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: TimeZoneConverterToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Time zone converter: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-calculator-form]");
    const inputDate = requireEl<HTMLInputElement>("[data-input-date]");
    const inputTime = requireEl<HTMLInputElement>("[data-input-time]");
    const inputSource = requireEl<HTMLSelectElement>("[data-input-source]");
    const inputTarget = requireEl<HTMLSelectElement>("[data-input-target]");
    const errorDate = requireEl<HTMLElement>("[data-error-date]");
    const errorTextDate = requireEl<HTMLElement>("[data-error-text-date]");
    const errorTime = requireEl<HTMLElement>("[data-error-time]");
    const errorTextTime = requireEl<HTMLElement>("[data-error-text-time]");
    const errorSource = requireEl<HTMLElement>("[data-error-source]");
    const errorTextSource = requireEl<HTMLElement>("[data-error-text-source]");
    const errorTarget = requireEl<HTMLElement>("[data-error-target]");
    const errorTextTarget = requireEl<HTMLElement>("[data-error-text-target]");
    const errorGap = requireEl<HTMLElement>("[data-error-gap]");
    const errorTextGap = requireEl<HTMLElement>("[data-error-text-gap]");
    const errorGeneral = requireEl<HTMLElement>("[data-error-general]");
    const errorTextGeneral = requireEl<HTMLElement>(
      "[data-error-text-general]",
    );
    const targetTimeEl = requireEl<HTMLElement>("[data-target-time]");
    const dayBadge = requireEl<HTMLElement>("[data-day-badge]");
    const targetZoneEl = requireEl<HTMLElement>("[data-target-zone]");
    const targetDateEl = requireEl<HTMLElement>("[data-target-date]");
    const targetWeekdayEl = requireEl<HTMLElement>("[data-target-weekday]");
    const sourceOffsetEl = requireEl<HTMLElement>("[data-source-offset]");
    const targetOffsetEl = requireEl<HTMLElement>("[data-target-offset]");
    const differenceEl = requireEl<HTMLElement>("[data-difference]");
    const dayChangeEl = requireEl<HTMLElement>("[data-day-change]");
    const sourceSummaryEl = requireEl<HTMLElement>("[data-source-summary]");
    const targetSummaryEl = requireEl<HTMLElement>("[data-target-summary]");
    const ambiguousNotice = requireEl<HTMLElement>("[data-ambiguous-notice]");
    const ambiguousText = requireEl<HTMLElement>("[data-ambiguous-text]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const currentButton = requireEl<HTMLButtonElement>("[data-current]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");
    const comparison = requireEl<HTMLElement>("[data-comparison]");
    const comparisonEmpty = requireEl<HTMLElement>("[data-comparison-empty]");

    const tool = i18n.tool;
    const intlLocale = i18n.intlLocale;
    const curatedLabels = tool.zoneLabels as Record<string, string>;

    const RESULT_VALUES = [
      targetDateEl,
      targetWeekdayEl,
      sourceOffsetEl,
      targetOffsetEl,
      differenceEl,
      dayChangeEl,
      sourceSummaryEl,
      targetSummaryEl,
    ] as const;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";
    let resultGeneration = 0;
    let deviceZone = deviceTimeZone();

    const pad2 = (value: number) => String(value).padStart(2, "0");

    const zoneLabel = (zone: string): string =>
      curatedLabels[zone] ?? zoneCityLabel(zone);

    const optionLabel = (zone: string): string =>
      curatedLabels[zone] ??
      `${zoneCityLabel(zone)} (${tool.deviceZoneSuffix})`;

    const setText = (element: HTMLElement, value: string) => {
      if (element.textContent !== value) element.textContent = value;
    };

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const hideError = (
      input: HTMLInputElement | HTMLSelectElement,
      wrap: HTMLElement,
      text: HTMLElement,
    ) => {
      if (
        wrap.hidden &&
        text.textContent === "" &&
        !input.hasAttribute("aria-invalid")
      ) {
        return;
      }
      wrap.hidden = true;
      text.textContent = "";
      input.removeAttribute("aria-invalid");
    };

    const showError = (
      input: HTMLInputElement | HTMLSelectElement,
      wrap: HTMLElement,
      text: HTMLElement,
      message: string,
    ) => {
      if (input.getAttribute("aria-invalid") !== "true") {
        input.setAttribute("aria-invalid", "true");
      }
      if (!wrap.hidden && text.textContent === message) return;
      text.textContent = message;
      wrap.hidden = false;
    };

    const hideGap = () => {
      if (errorGap.hidden && errorTextGap.textContent === "") {
        inputDate.removeAttribute("aria-invalid");
        inputTime.removeAttribute("aria-invalid");
        return;
      }
      errorGap.hidden = true;
      errorTextGap.textContent = "";
      inputDate.removeAttribute("aria-invalid");
      inputTime.removeAttribute("aria-invalid");
    };

    const showGap = (message: string) => {
      inputDate.setAttribute("aria-invalid", "true");
      inputTime.setAttribute("aria-invalid", "true");
      if (!errorGap.hidden && errorTextGap.textContent === message) return;
      errorTextGap.textContent = message;
      errorGap.hidden = false;
    };

    const hideGeneralError = () => {
      if (errorGeneral.hidden && errorTextGeneral.textContent === "") return;
      errorGeneral.hidden = true;
      errorTextGeneral.textContent = "";
    };

    const showGeneralError = (message: string) => {
      if (!errorGeneral.hidden && errorTextGeneral.textContent === message) {
        return;
      }
      errorTextGeneral.textContent = message;
      errorGeneral.hidden = false;
    };

    const clearErrors = () => {
      hideError(inputDate, errorDate, errorTextDate);
      hideError(inputTime, errorTime, errorTextTime);
      hideError(inputSource, errorSource, errorTextSource);
      hideError(inputTarget, errorTarget, errorTextTarget);
      hideGap();
      hideGeneralError();
    };

    const hasOption = (select: HTMLSelectElement, value: string) =>
      Array.from(select.options).some((option) => option.value === value);

    const ensureOption = (
      select: HTMLSelectElement,
      zone: string,
      label: string,
    ) => {
      if (hasOption(select, zone)) return;
      const option = document.createElement("option");
      option.value = zone;
      option.textContent = label;
      select.append(option);
    };

    const prepareZones = () => {
      deviceZone = deviceTimeZone();

      for (const select of [inputSource, inputTarget]) {
        for (const option of Array.from(select.options)) {
          if (!isValidTimeZone(option.value)) option.remove();
        }
        ensureOption(select, "UTC", optionLabel("UTC"));
        ensureOption(select, deviceZone, optionLabel(deviceZone));
      }
    };

    const pickTarget = (source: string): string => {
      for (const candidate of ["UTC", "Europe/London"]) {
        if (candidate !== source && hasOption(inputTarget, candidate)) {
          return candidate;
        }
      }
      const other = Array.from(inputTarget.options).find(
        (option) => option.value !== source,
      );
      return other?.value ?? source;
    };

    const setCurrentDeviceTime = () => {
      const now = new Date();
      inputDate.value = formatDateInput({
        year: now.getFullYear(),
        month: now.getMonth() + 1,
        day: now.getDate(),
      });
      inputTime.value = `${pad2(now.getHours())}:${pad2(now.getMinutes())}`;
    };

    const formatDuration = (minutes: number): string => {
      const absolute = Math.abs(Math.round(minutes));
      const hours = Math.floor(absolute / 60);
      const rest = absolute % 60;
      if (hours > 0 && rest > 0) {
        return interpolate(tool.durationHoursMinutes, {
          hours,
          minutes: rest,
        });
      }
      if (hours > 0) return interpolate(tool.durationHours, { hours });
      return interpolate(tool.durationMinutes, { minutes: rest });
    };

    const differenceText = (minutes: number): string => {
      const rounded = Math.round(minutes);
      if (rounded === 0) return tool.sameTime;
      const duration = formatDuration(rounded);
      return interpolate(
        rounded > 0 ? tool.differenceAhead : tool.differenceBehind,
        { duration },
      );
    };

    const dayLabel = (days: number): string => {
      if (days === 0) return tool.sameDay;
      if (days === 1) return tool.nextDay;
      if (days === -1) return tool.previousDay;
      return interpolate(days > 0 ? tool.daysAhead : tool.daysBehind, {
        count: Math.abs(days),
      });
    };

    const showEmptyResult = () => {
      resultGeneration += 1;
      lastCopyText = "";
      resetCopyFeedback();
      setText(targetTimeEl, "—");
      targetTimeEl.classList.replace("text-text-primary", "text-text-disabled");
      for (const element of RESULT_VALUES) {
        setText(element, "—");
        element.classList.replace("text-text-primary", "text-text-disabled");
      }
      setText(targetZoneEl, "—");
      dayBadge.hidden = true;
      dayBadge.textContent = "";
      ambiguousNotice.hidden = true;
      ambiguousText.textContent = "";
      setText(resultCaption, i18n.calculator.resultsPlaceholder);
      copyButton.disabled = true;
      comparison.textContent = "";
      comparison.hidden = true;
      comparisonEmpty.hidden = false;
    };

    const invalidateResult = () => {
      clearErrors();
      showEmptyResult();
    };

    const reveal = (element: HTMLElement, value: string) => {
      setText(element, value);
      element.classList.replace("text-text-disabled", "text-text-primary");
    };

    const renderComparison = (result: TimeZoneConversion) => {
      comparison.textContent = "";
      comparisonEmpty.hidden = true;
      comparison.hidden = false;

      const table = document.createElement("table");
      table.className = "w-full min-w-[520px] text-small";

      const caption = document.createElement("caption");
      caption.className = "sr-only";
      caption.textContent = tool.comparisonCaption;
      table.append(caption);

      const thead = document.createElement("thead");
      const headerRow = document.createElement("tr");
      const headers = [
        { label: tool.comparisonHeaders.zone, align: "left" },
        { label: tool.comparisonHeaders.date, align: "left" },
        { label: tool.comparisonHeaders.time, align: "right" },
        { label: tool.comparisonHeaders.offset, align: "right" },
        { label: tool.comparisonHeaders.day, align: "left" },
      ] as const;
      for (const header of headers) {
        const th = document.createElement("th");
        th.scope = "col";
        th.className = `border-b border-border-subtle px-2 py-2 ${
          header.align === "right" ? "text-right" : "text-left"
        } font-medium text-text-secondary`;
        th.textContent = header.label;
        headerRow.append(th);
      }
      thead.append(headerRow);
      table.append(thead);

      const tbody = document.createElement("tbody");
      for (const zone of COMPARISON_TIME_ZONES) {
        if (!isValidTimeZone(zone)) continue;

        const parts = zonedParts(result.instant, zone);
        const offset = offsetMinutesAt(result.instant, zone);
        const day = dayOffsetBetween(result.sourceDate, {
          year: parts.year,
          month: parts.month,
          day: parts.day,
        });

        const row = document.createElement("tr");
        row.className = "border-b border-border-subtle last:border-0";
        row.dataset.comparisonZone = zone;

        const zoneCell = document.createElement("th");
        zoneCell.scope = "row";
        zoneCell.className =
          "px-2 py-2 text-left font-mono text-small text-text-secondary";
        zoneCell.textContent = zoneLabel(zone);
        row.append(zoneCell);

        const dateCell = document.createElement("td");
        dateCell.className =
          "px-2 py-2 text-left font-mono text-small tabular-nums text-text-primary";
        dateCell.textContent = formatZoneDate(parts, intlLocale);
        row.append(dateCell);

        const timeCell = document.createElement("td");
        timeCell.className =
          "px-2 py-2 text-right font-mono text-small tabular-nums text-text-primary";
        timeCell.textContent = formatZoneTime(parts, intlLocale);
        row.append(timeCell);

        const offsetCell = document.createElement("td");
        offsetCell.className =
          "px-2 py-2 text-right font-mono text-small tabular-nums text-text-primary";
        offsetCell.textContent = formatUtcOffset(offset);
        row.append(offsetCell);

        const dayCell = document.createElement("td");
        dayCell.className =
          "px-2 py-2 text-left font-mono text-small tabular-nums text-text-secondary";
        dayCell.textContent = dayLabel(day);
        row.append(dayCell);

        tbody.append(row);
      }
      table.append(tbody);
      comparison.append(table);
    };

    const renderConversion = (result: TimeZoneConversion) => {
      clearErrors();
      resultGeneration += 1;
      resetCopyFeedback();

      const sourceLabel = zoneLabel(result.sourceZone);
      const targetLabel = zoneLabel(result.targetZone);
      const sourceTime = formatZoneTime(result.source, intlLocale);
      const sourceDate = formatZoneDate(result.source, intlLocale);
      const targetTime = formatZoneTime(result.target, intlLocale);
      const targetDate = formatZoneDate(result.target, intlLocale);
      const targetWeekday = formatZoneWeekday(result.target, intlLocale);
      const sourceOffset = formatUtcOffset(result.sourceOffsetMinutes);
      const targetOffset = formatUtcOffset(result.targetOffsetMinutes);
      const difference = differenceText(result.differenceMinutes);
      const day = dayLabel(result.dayOffset);

      reveal(targetTimeEl, targetTime);
      setText(targetZoneEl, `${targetLabel} (${result.targetZone})`);
      dayBadge.hidden = result.dayOffset === 0;
      setText(dayBadge, day);
      reveal(targetDateEl, targetDate);
      reveal(targetWeekdayEl, targetWeekday);
      reveal(sourceOffsetEl, sourceOffset);
      reveal(targetOffsetEl, targetOffset);
      reveal(differenceEl, difference);
      reveal(dayChangeEl, day);

      const sourceSummary = interpolate(tool.summaryLine, {
        time: sourceTime,
        date: sourceDate,
        label: sourceLabel,
        zone: result.sourceZone,
      });
      const targetSummary = interpolate(tool.summaryLine, {
        time: targetTime,
        date: targetDate,
        label: targetLabel,
        zone: result.targetZone,
      });
      reveal(sourceSummaryEl, sourceSummary);
      reveal(targetSummaryEl, targetSummary);

      if (result.ambiguous) {
        const selectedOffset = formatUtcOffset(
          result.selectedOffsetMinutes ?? result.sourceOffsetMinutes,
        );
        setText(
          ambiguousText,
          interpolate(tool.dstAmbiguous, {
            zone: sourceLabel,
            offset: selectedOffset,
          }),
        );
        ambiguousNotice.hidden = false;
      } else {
        ambiguousNotice.hidden = true;
        ambiguousText.textContent = "";
      }

      setText(
        resultCaption,
        interpolate(tool.caption, {
          sourceTime,
          sourceDate,
          sourceLabel,
        }),
      );

      let copyText = interpolate(tool.copyText, {
        sourceTime,
        sourceDate,
        sourceLabel,
        sourceZone: result.sourceZone,
        targetTime,
        targetDate,
        targetLabel,
        targetZone: result.targetZone,
        sourceOffset,
        targetOffset,
        difference,
      });
      if (result.ambiguous) {
        copyText += `\n${interpolate(tool.copyAmbiguousLine, {
          offset: formatUtcOffset(
            result.selectedOffsetMinutes ?? result.sourceOffsetMinutes,
          ),
        })}`;
      }
      lastCopyText = copyText;
      copyButton.disabled = false;

      renderComparison(result);
    };

    const issueMessage = (issue: TimeZoneIssue): string => {
      if (issue === "date-range") return tool.errors.dateRange;
      if (issue === "empty-time" || issue === "invalid-time") {
        return tool.errors.time;
      }
      if (issue === "invalid-source-zone") return tool.errors.sourceZone;
      if (issue === "invalid-target-zone") return tool.errors.targetZone;
      return tool.errors.date;
    };

    const runConversion = () => {
      clearErrors();

      let result: ReturnType<typeof convertTimeZone>;
      try {
        result = convertTimeZone({
          date: inputDate.value,
          time: inputTime.value,
          sourceZone: inputSource.value,
          targetZone: inputTarget.value,
        });
      } catch {
        showGeneralError(tool.errors.unexpected);
        showEmptyResult();
        return;
      }

      if (!result.ok) {
        if (result.issue === "nonexistent") {
          const gap =
            result.gapMinutes !== undefined && result.gapMinutes > 0
              ? result.gapMinutes
              : 60;
          showGap(
            interpolate(tool.dstGap, {
              zone: zoneLabel(inputSource.value),
              duration: formatDuration(gap),
            }),
          );
          showEmptyResult();
          return;
        }

        if (
          result.issue === "empty-date" ||
          result.issue === "invalid-date" ||
          result.issue === "date-range"
        ) {
          showError(
            inputDate,
            errorDate,
            errorTextDate,
            issueMessage(result.issue),
          );
        } else if (
          result.issue === "empty-time" ||
          result.issue === "invalid-time"
        ) {
          showError(
            inputTime,
            errorTime,
            errorTextTime,
            issueMessage(result.issue),
          );
        } else if (result.issue === "invalid-source-zone") {
          showError(
            inputSource,
            errorSource,
            errorTextSource,
            tool.errors.sourceZone,
          );
        } else {
          showError(
            inputTarget,
            errorTarget,
            errorTextTarget,
            tool.errors.targetZone,
          );
        }
        showEmptyResult();
        return;
      }

      renderConversion(result.value);
    };

    const applyDefaults = () => {
      prepareZones();
      inputSource.value = deviceZone;
      inputTarget.value = pickTarget(deviceZone);
      if (!hasOption(inputSource, deviceZone)) inputSource.value = "UTC";
      if (!hasOption(inputTarget, inputTarget.value)) {
        inputTarget.value = pickTarget(inputSource.value);
      }
      setCurrentDeviceTime();
      runConversion();
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      runConversion();
    });

    for (const input of [inputDate, inputTime, inputSource, inputTarget]) {
      input.addEventListener("input", invalidateResult);
      input.addEventListener("change", invalidateResult);
    }

    currentButton.addEventListener("click", () => {
      setCurrentDeviceTime();
      runConversion();
    });

    resetButton.addEventListener("click", () => {
      form.reset();
      applyDefaults();
      inputDate.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      const generation = resultGeneration;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        if (generation !== resultGeneration) return;
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        if (generation !== resultGeneration) return;
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });

    applyDefaults();
  }
</script>
