---
interface Props {
  name: string;
  label: string;
  hint: string;
  checked?: boolean;
}

const { name, label, hint, checked = false } = Astro.props;
const labelId = `${name}-label`;
const hintId = `${name}-hint`;
---

<label class="flex min-h-11 cursor-pointer items-start justify-between gap-4">
  <span class="min-w-0">
    <span id={labelId} class="block text-label text-text-primary">
      {label}
    </span>
    <span id={hintId} class="mt-1 block text-caption text-text-muted">
      {hint}
    </span>
  </span>
  <span class="relative mt-1 inline-flex h-6 w-11 shrink-0 items-center rounded-full border border-border-control bg-surface-muted transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus-ring">
    <input
      id={name}
      type="checkbox"
      role="switch"
      name={name}
      class="peer sr-only"
      aria-labelledby={labelId}
      aria-describedby={hintId}
      checked={checked}
    />
    <span
      class="pointer-events-none ml-0.5 h-5 w-5 rounded-full bg-surface shadow-sm transition-transform peer-checked:translate-x-5"
      aria-hidden="true"
    ></span>
  </span>
</label>
