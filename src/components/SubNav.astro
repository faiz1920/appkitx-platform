---
const links = [
  { href: "#tools", label: "Calculators" },
  { href: "#tools", label: "Converters" },
  { href: "#tools", label: "Developer Tools" },
];
---

<div class="nav-frosted sticky top-11 z-30 border-b border-[rgba(0,0,0,0.08)]">
  <div class="mx-auto flex h-[52px] max-w-grid items-center justify-between gap-lg px-lg">
    <span class="font-display text-tagline text-ink">All Tools</span>
    <div class="flex items-center gap-lg">
      <div class="hidden items-center gap-lg tablet:flex">
        {links.map((link) => (
          <a href={link.href} class="font-text text-button-utility text-ink">
            {link.label}
          </a>
        ))}
      </div>
      <a href="#tools" class="btn-primary">
        Browse tools
      </a>
    </div>
  </div>
</div>
