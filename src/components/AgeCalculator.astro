---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.ageCalculator;
const localeMeta = getLocale(locale);

/*
 * Strings for the client script — JSON-safe slice of the dictionary plus
 * the locale's Intl formatting locale (arithmetic stays locale-free).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-age-calculator data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-tool-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <div>
        <label for="age-calc-input-birth" class="text-label text-text-primary">
          {tool.birthLabel}
        </label>
        <input
          id="age-calc-input-birth"
          name="birth"
          type="date"
          class="input mt-2 font-mono tabular-nums"
          aria-describedby="age-calc-hint-birth age-calc-error-birth"
          data-input-birth
        />
        <p id="age-calc-hint-birth" class="mt-1 text-caption text-text-muted">
          {tool.birthHint}
        </p>
        <p
          id="age-calc-error-birth"
          class="field-error mt-1"
          hidden
          data-error-birth
        >
          <span aria-hidden="true" set:html={alertIcon} />
          <span data-error-text-birth></span>
        </p>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 pr-14">
      <p class="text-caption text-text-secondary">{tool.ageLabel}</p>
      <p class="mt-1 text-mono-result text-text-disabled" data-age-value>
        —
      </p>
    </div>
    <div class="mt-4 pr-14">
      <p class="text-caption text-text-secondary">{tool.totalDaysLabel}</p>
      <p
        class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
        data-days-value
      >
        —
      </p>
    </div>
    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={t.calculator.copyResult}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>
</div>

<script>
  import {
    calculateAge,
    parseDateInput,
    type CivilDate,
  } from "../lib/date-math";
  import {
    formatBreakdown,
    formatDayCount,
    formatLongDate,
  } from "../lib/date-format";
  import { interpolate } from "../i18n/interpolate";
  import type {
    AgeCalculatorToolStrings,
    CalculatorStrings,
  } from "../i18n/dictionary";

  const root = document.querySelector<HTMLElement>("[data-age-calculator]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: AgeCalculatorToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Age calculator: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-tool-form]");
    const inputBirth = requireEl<HTMLInputElement>("[data-input-birth]");
    const errorBirth = requireEl<HTMLElement>("[data-error-birth]");
    const errorTextBirth = requireEl<HTMLElement>("[data-error-text-birth]");
    const ageValue = requireEl<HTMLElement>("[data-age-value]");
    const daysValue = requireEl<HTMLElement>("[data-days-value]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");

    const intlLocale = i18n.intlLocale;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearError = () => {
      errorBirth.hidden = true;
      errorTextBirth.textContent = "";
      inputBirth.removeAttribute("aria-invalid");
    };

    const showError = (message: string) => {
      errorBirth.hidden = false;
      errorTextBirth.textContent = message;
      inputBirth.setAttribute("aria-invalid", "true");
    };

    const showEmptyResult = () => {
      lastCopyText = "";
      resetCopyFeedback();
      for (const el of [ageValue, daysValue]) {
        el.textContent = "—";
        el.classList.replace("text-text-primary", "text-text-disabled");
      }
      resultCaption.textContent = i18n.calculator.resultsPlaceholder;
      copyButton.disabled = true;
    };

    const completeValue = (el: HTMLElement, text: string) => {
      el.textContent = text;
      el.classList.replace("text-text-disabled", "text-text-primary");
    };

    /*
     * "Today" is the user's local calendar date — the age tool is explicitly
     * device-local, unlike the pure module, which receives it as an argument.
     */
    const localToday = (): CivilDate => {
      const now = new Date();
      return {
        year: now.getFullYear(),
        month: now.getMonth() + 1,
        day: now.getDate(),
      };
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearError();
      resetCopyFeedback();

      const birth =
        inputBirth.value === "" ? null : parseDateInput(inputBirth.value);
      if (birth === null) {
        showError(i18n.tool.errors.empty);
        showEmptyResult();
        return;
      }

      const today = localToday();
      const age = calculateAge(birth, today);
      if (age === null) {
        showError(i18n.tool.errors.future);
        showEmptyResult();
        return;
      }

      const ageText = formatBreakdown(age, intlLocale);
      const daysText = formatDayCount(age.totalDays, intlLocale);

      completeValue(ageValue, ageText);
      completeValue(daysValue, daysText);
      resultCaption.textContent = interpolate(i18n.tool.caption, {
        date: formatLongDate(today, intlLocale),
      });
      lastCopyText = interpolate(i18n.tool.copyText, {
        age: ageText,
        days: daysText,
      });
      copyButton.disabled = false;
    });

    resetButton.addEventListener("click", () => {
      form.reset();
      clearError();
      showEmptyResult();
      inputBirth.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
