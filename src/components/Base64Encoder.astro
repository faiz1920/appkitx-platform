---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import { defaultLocale, getDictionary, type LocaleCode } from "../i18n/config";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.base64;

/*
 * Strings for the client script — JSON-safe slice of the dictionary. Copy
 * button label and clipboard feedback reuse the shared calculator interface
 * strings (approved M7 decision: renaming that block is out of scope).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
};
---

<div data-base64-tool data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-tool-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <fieldset class="min-w-0">
        <legend class="text-label text-text-primary">{tool.modeLegend}</legend>
        <div class="segmented mt-2">
          <label>
            <input
              type="radio"
              name="mode"
              value="encode"
              class="sr-only"
              checked
            />
            {tool.modes.encode.optionLabel}
          </label>
          <label>
            <input type="radio" name="mode" value="decode" class="sr-only" />
            {tool.modes.decode.optionLabel}
          </label>
        </div>
      </fieldset>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button type="submit" class="btn btn-primary" data-action>
          {tool.modes.encode.action}
        </button>
        <button type="button" class="btn btn-ghost" disabled data-copy>
          {t.calculator.copyResult}
        </button>
        <button type="button" class="btn btn-secondary" data-clear>
          {tool.clear}
        </button>
      </div>
    </div>
  </form>

  <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div>
      <label
        for="base64-input"
        class="text-label text-text-primary"
        data-input-label
      >
        {tool.modes.encode.inputLabel}
      </label>
      <textarea
        id="base64-input"
        class="textarea mt-2 min-h-[240px] font-mono text-[15px]"
        spellcheck="false"
        data-input
        aria-describedby="base64-hint base64-error"
      ></textarea>
      <p
        id="base64-hint"
        class="mt-1 text-caption text-text-muted"
        data-input-hint
      >
        {tool.modes.encode.inputHint}
      </p>
      <p id="base64-error" class="field-error mt-1" hidden data-error>
        <span aria-hidden="true" set:html={alertIcon} />
        <span data-error-text></span>
      </p>
    </div>

    <div>
      <label
        for="base64-output"
        class="text-label text-text-primary"
        data-output-label
      >
        {tool.modes.encode.outputLabel}
      </label>
      <textarea
        id="base64-output"
        class="textarea mt-2 min-h-[240px] bg-surface-subtle font-mono text-[15px]"
        readonly
        data-output
      ></textarea>
    </div>
  </div>

  <p
    class="mt-3 text-caption text-text-muted"
    aria-live="polite"
    data-status
  ></p>
  <p
    class="mt-2 flex items-center gap-1.5 text-caption text-success"
    hidden
    data-copy-status-success
  >
    <span
      class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
      aria-hidden="true"
      set:html={checkIcon}
    />
    {t.calculator.copied}
  </p>
  <p
    class="mt-2 flex items-center gap-1.5 text-caption text-error"
    hidden
    data-copy-status-error
  >
    <span
      class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
      aria-hidden="true"
      set:html={alertIcon}
    />
    {t.calculator.copyFailed}
  </p>
</div>

<script>
  import { decodeBase64, encodeBase64 } from "../lib/base64";
  import { interpolate } from "../i18n/interpolate";
  import type {
    Base64ToolStrings,
    CalculatorStrings,
  } from "../i18n/dictionary";

  const root = document.querySelector<HTMLElement>("[data-base64-tool]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: Base64ToolStrings;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Base64 encoder: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-tool-form]");
    const input = requireEl<HTMLTextAreaElement>("[data-input]");
    const output = requireEl<HTMLTextAreaElement>("[data-output]");
    const inputLabel = requireEl<HTMLElement>("[data-input-label]");
    const inputHint = requireEl<HTMLElement>("[data-input-hint]");
    const outputLabel = requireEl<HTMLElement>("[data-output-label]");
    const errorWrap = requireEl<HTMLElement>("[data-error]");
    const errorText = requireEl<HTMLElement>("[data-error-text]");
    const status = requireEl<HTMLElement>("[data-status]");
    const actionButton = requireEl<HTMLButtonElement>("[data-action]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const clearButton = requireEl<HTMLButtonElement>("[data-clear]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const radios =
      root.querySelectorAll<HTMLInputElement>('input[name="mode"]');

    const MODES = i18n.tool.modes;

    let copyTimer: number | undefined;
    let copyBusy = false;

    const mode = (): "encode" | "decode" =>
      (root.querySelector<HTMLInputElement>('input[name="mode"]:checked')
        ?.value as "encode" | "decode" | undefined) ?? "encode";

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearError = () => {
      errorWrap.hidden = true;
      errorText.textContent = "";
      input.removeAttribute("aria-invalid");
    };

    const showError = (message: string) => {
      errorWrap.hidden = false;
      errorText.textContent = message;
      input.setAttribute("aria-invalid", "true");
    };

    const setStatus = (inCount: number, outCount: number | undefined) => {
      const parts = [interpolate(i18n.tool.statusIn, { count: inCount })];
      if (outCount !== undefined) {
        parts.push(interpolate(i18n.tool.statusOut, { count: outCount }));
      }
      status.textContent = parts.join(" · ");
    };

    const resetOutput = () => {
      output.value = "";
      status.textContent = "";
      resetCopyFeedback();
      copyButton.disabled = true;
    };

    const applyMode = () => {
      const copy = MODES[mode()];
      inputLabel.textContent = copy.inputLabel;
      inputHint.textContent = copy.inputHint;
      outputLabel.textContent = copy.outputLabel;
      actionButton.textContent = copy.action;
      clearError();
      resetOutput();
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearError();
      resetCopyFeedback();

      const value = input.value;
      const activeMode = mode();

      if (value.trim() === "") {
        showError(
          activeMode === "encode"
            ? i18n.tool.errors.emptyEncode
            : i18n.tool.errors.emptyDecode,
        );
        return;
      }

      if (activeMode === "encode") {
        output.value = encodeBase64(value);
        setStatus(value.length, output.value.length);
        copyButton.disabled = false;
        return;
      }

      const result = decodeBase64(value);
      if (!result.ok) {
        showError(i18n.tool.errors.invalid);
        return;
      }

      output.value = result.value;
      setStatus(value.length, output.value.length);
      copyButton.disabled = false;
    });

    radios.forEach((radio) => radio.addEventListener("change", applyMode));

    clearButton.addEventListener("click", () => {
      input.value = "";
      clearError();
      resetOutput();
      input.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (output.value === "" || copyBusy) return;
      copyBusy = true;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(output.value);
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
