---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import { TENURE_UNITS } from "../lib/emi";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.emiCalculator;
const localeMeta = getLocale(locale);

const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-emi-calculator data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-calculator-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <div class="space-y-5">
        <div>
          <label for="emi-input-amount" class="text-label text-text-primary">
            {tool.amountLabel}
          </label>
          <input
            id="emi-input-amount"
            name="amount"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="emi-hint-amount emi-error-amount"
            data-input-amount
          />
          <p id="emi-hint-amount" class="mt-1 text-caption text-text-muted">
            {tool.amountHint}
          </p>
          <p
            id="emi-error-amount"
            class="field-error mt-1"
            role="alert"
            aria-atomic="true"
            hidden
            data-error-amount
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-amount></span>
          </p>
        </div>

        <div>
          <label for="emi-input-rate" class="text-label text-text-primary">
            {tool.rateLabel}
          </label>
          <input
            id="emi-input-rate"
            name="rate"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="emi-hint-rate emi-error-rate"
            data-input-rate
          />
          <p id="emi-hint-rate" class="mt-1 text-caption text-text-muted">
            {tool.rateHint}
          </p>
          <p
            id="emi-error-rate"
            class="field-error mt-1"
            role="alert"
            aria-atomic="true"
            hidden
            data-error-rate
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-rate></span>
          </p>
        </div>

        <div>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label
                for="emi-input-tenure"
                class="text-label text-text-primary"
              >
                {tool.tenureLabel}
              </label>
              <input
                id="emi-input-tenure"
                name="tenure"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                spellcheck="false"
                class="input mt-2 font-mono tabular-nums"
                aria-describedby="emi-hint-tenure emi-error-tenure"
                data-input-tenure
              />
              <p
                id="emi-error-tenure"
                class="field-error mt-1"
                role="alert"
                aria-atomic="true"
                hidden
                data-error-tenure
              >
                <span aria-hidden="true" set:html={alertIcon} />
                <span data-error-text-tenure></span>
              </p>
            </div>

            <div>
              <label
                for="emi-input-tenure-unit"
                class="text-label text-text-primary"
              >
                {tool.tenureUnitLabel}
              </label>
              <select
                id="emi-input-tenure-unit"
                name="tenureUnit"
                class="input mt-2"
                data-input-tenure-unit
              >
                {TENURE_UNITS.map((unit) => (
                  <option value={unit} selected={unit === "years"}>
                    {tool.tenureUnits[unit]}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <p id="emi-hint-tenure" class="mt-1 text-caption text-text-muted">
            {tool.tenureHint}
          </p>
        </div>

        <p
          class="field-error"
          role="alert"
          aria-atomic="true"
          hidden
          data-error-general
        >
          <span aria-hidden="true" set:html={alertIcon} />
          <span data-error-text-general></span>
        </p>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 pr-14">
      <p class="text-caption text-text-secondary">{tool.emiLabel}</p>
      <p class="mt-1 text-mono-result text-text-disabled" data-emi>
        —
      </p>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-4 pr-14 sm:grid-cols-3">
      <div>
        <p class="text-caption text-text-secondary">{tool.principalLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-principal
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.interestLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-interest
        >
          —
        </p>
      </div>
      <div>
        <p class="text-caption text-text-secondary">{tool.totalLabel}</p>
        <p
          class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
          data-total
        >
          —
        </p>
      </div>
    </div>

    <div class="mt-4 border-t border-accent-subtle-border pt-3">
      <p class="text-caption text-text-secondary">{tool.breakdownHeading}</p>
      <p class="mt-1 text-small text-text-secondary" data-principal-share>
        —
      </p>
      <p class="mt-1 text-small text-text-secondary" data-interest-share>
        —
      </p>
    </div>

    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={tool.copySummary}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>

  <p class="mt-4 text-small text-text-secondary">
    {t.calculator.formulaLabel}{" "}
    <code class="inline-code" data-formula>
      {tool.formulas.template}
    </code>
  </p>

  <section class="mt-8" aria-labelledby="emi-schedule-heading">
    <h2 id="emi-schedule-heading" class="text-title text-text-primary">
      {tool.scheduleHeading}
    </h2>
    <p class="mt-1 text-small text-text-secondary">{tool.scheduleHint}</p>
    <p class="mt-3 text-small text-text-muted" data-schedule-empty>
      {tool.scheduleEmpty}
    </p>
    <div class="mt-4 space-y-3" data-schedule hidden></div>
  </section>
</div>

<script>
  import {
    MAX_EMI_MONTHS,
    calculateEmi,
    formatEmiDecimal,
    formatEmiMoney,
    tenureToMonths,
    type EmiIssue,
    type EmiYearSummary,
    type TenureUnit,
  } from "../lib/emi";
  import { parseLocaleNumber } from "../lib/number-input";
  import { interpolate } from "../i18n/interpolate";
  import type {
    CalculatorStrings,
    EmiCalculatorToolStrings,
  } from "../i18n/dictionary";

  const root = document.querySelector<HTMLElement>("[data-emi-calculator]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: EmiCalculatorToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`EMI calculator: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-calculator-form]");
    const inputAmount = requireEl<HTMLInputElement>("[data-input-amount]");
    const inputRate = requireEl<HTMLInputElement>("[data-input-rate]");
    const inputTenure = requireEl<HTMLInputElement>("[data-input-tenure]");
    const inputTenureUnit = requireEl<HTMLSelectElement>(
      "[data-input-tenure-unit]",
    );
    const errorAmount = requireEl<HTMLElement>("[data-error-amount]");
    const errorTextAmount = requireEl<HTMLElement>("[data-error-text-amount]");
    const errorRate = requireEl<HTMLElement>("[data-error-rate]");
    const errorTextRate = requireEl<HTMLElement>("[data-error-text-rate]");
    const errorTenure = requireEl<HTMLElement>("[data-error-tenure]");
    const errorTextTenure = requireEl<HTMLElement>("[data-error-text-tenure]");
    const errorGeneral = requireEl<HTMLElement>("[data-error-general]");
    const errorTextGeneral = requireEl<HTMLElement>(
      "[data-error-text-general]",
    );
    const emiEl = requireEl<HTMLElement>("[data-emi]");
    const principalEl = requireEl<HTMLElement>("[data-principal]");
    const interestEl = requireEl<HTMLElement>("[data-interest]");
    const totalEl = requireEl<HTMLElement>("[data-total]");
    const principalShareEl = requireEl<HTMLElement>("[data-principal-share]");
    const interestShareEl = requireEl<HTMLElement>("[data-interest-share]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const formulaEl = requireEl<HTMLElement>("[data-formula]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");
    const schedule = requireEl<HTMLElement>("[data-schedule]");
    const scheduleEmpty = requireEl<HTMLElement>("[data-schedule-empty]");

    const intlLocale = i18n.intlLocale;
    const FORMULA_TEMPLATE = i18n.tool.formulas.template;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";
    let resultGeneration = 0;

    const setText = (element: HTMLElement, value: string) => {
      if (element.textContent !== value) element.textContent = value;
    };

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const hideError = (
      input: HTMLInputElement,
      wrap: HTMLElement,
      text: HTMLElement,
    ) => {
      if (
        wrap.hidden &&
        text.textContent === "" &&
        !input.hasAttribute("aria-invalid")
      ) {
        return;
      }
      wrap.hidden = true;
      text.textContent = "";
      input.removeAttribute("aria-invalid");
    };

    const showError = (
      input: HTMLInputElement,
      wrap: HTMLElement,
      text: HTMLElement,
      message: string,
    ) => {
      if (input.getAttribute("aria-invalid") !== "true") {
        input.setAttribute("aria-invalid", "true");
      }
      if (!wrap.hidden && text.textContent === message) return;
      text.textContent = message;
      wrap.hidden = false;
    };

    const hideGeneralError = () => {
      if (errorGeneral.hidden && errorTextGeneral.textContent === "") {
        return;
      }
      errorGeneral.hidden = true;
      errorTextGeneral.textContent = "";
    };

    const showGeneralError = (message: string) => {
      if (!errorGeneral.hidden && errorTextGeneral.textContent === message) {
        return;
      }
      errorTextGeneral.textContent = message;
      errorGeneral.hidden = false;
    };

    const clearErrors = () => {
      hideError(inputAmount, errorAmount, errorTextAmount);
      hideError(inputRate, errorRate, errorTextRate);
      hideError(inputTenure, errorTenure, errorTextTenure);
      hideGeneralError();
    };

    const showEmptyResult = () => {
      resultGeneration += 1;
      lastCopyText = "";
      resetCopyFeedback();
      for (const element of [emiEl, principalEl, interestEl, totalEl]) {
        setText(element, "—");
        element.classList.replace("text-text-primary", "text-text-disabled");
      }
      setText(principalShareEl, "—");
      setText(interestShareEl, "—");
      setText(resultCaption, i18n.calculator.resultsPlaceholder);
      setText(formulaEl, FORMULA_TEMPLATE);
      copyButton.disabled = true;
      schedule.textContent = "";
      schedule.hidden = true;
      scheduleEmpty.hidden = false;
    };

    const invalidateResult = () => {
      clearErrors();
      showEmptyResult();
    };

    const errorMessage = (issue: "invalid" | "ambiguous") =>
      issue === "ambiguous"
        ? i18n.calculator.ambiguousNumber
        : i18n.calculator.invalidNumber;

    const issueField = (
      issue: EmiIssue,
    ): "amount" | "rate" | "tenure" | null => {
      if (issue === "invalid-principal") return "amount";
      if (issue === "invalid-rate") return "rate";
      if (issue === "invalid-months") return "tenure";
      return null;
    };

    const renderSchedule = (years: readonly EmiYearSummary[]) => {
      schedule.textContent = "";
      scheduleEmpty.hidden = true;
      schedule.hidden = false;

      for (const [yearIndex, year] of years.entries()) {
        const details = document.createElement("details");
        details.className = "rounded-md border border-border-subtle bg-surface";
        details.open = yearIndex === 0;

        const summary = document.createElement("summary");
        summary.className =
          "focus-ring cursor-pointer px-4 py-3 text-label text-text-primary";

        const title = document.createElement("span");
        title.className = "font-mono";
        title.textContent = interpolate(i18n.tool.yearLabel, {
          year: formatEmiDecimal(year.year, intlLocale),
        });
        summary.append(title);

        const metrics = document.createElement("span");
        metrics.className =
          "mt-3 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-5";
        for (const [label, value] of [
          [i18n.tool.openingBalanceLabel, year.openingBalance],
          [i18n.tool.principalPaidLabel, year.principalPaid],
          [i18n.tool.interestPaidLabel, year.interestPaid],
          [i18n.tool.totalPaidLabel, year.totalPaid],
          [i18n.tool.closingBalanceLabel, year.closingBalance],
        ] as const) {
          const item = document.createElement("span");
          item.className = "block min-w-0";
          const labelEl = document.createElement("span");
          labelEl.className = "block text-caption text-text-muted";
          labelEl.textContent = label;
          const valueEl = document.createElement("span");
          valueEl.className =
            "mt-0.5 block font-mono text-small tabular-nums text-text-primary";
          valueEl.textContent = formatEmiMoney(value, intlLocale);
          item.append(labelEl, valueEl);
          metrics.append(item);
        }
        summary.append(metrics);

        const scroll = document.createElement("div");
        scroll.className = "mt-3 overflow-x-auto px-4 pb-4 focus-ring";
        scroll.tabIndex = 0;
        scroll.setAttribute("role", "region");
        scroll.setAttribute(
          "aria-label",
          interpolate(i18n.tool.scheduleScrollLabel, {
            year: formatEmiDecimal(year.year, intlLocale),
          }),
        );

        const table = document.createElement("table");
        table.className = "w-full min-w-[720px] text-small";
        table.dataset.year = String(year.year);

        const caption = document.createElement("caption");
        caption.className = "sr-only";
        caption.textContent = interpolate(i18n.tool.monthlyTableCaption, {
          year: formatEmiDecimal(year.year, intlLocale),
        });
        table.append(caption);

        const thead = document.createElement("thead");
        const headerRow = document.createElement("tr");
        for (const header of [
          i18n.tool.tableHeaders.paymentNumber,
          i18n.tool.tableHeaders.openingBalance,
          i18n.tool.tableHeaders.payment,
          i18n.tool.tableHeaders.interest,
          i18n.tool.tableHeaders.principal,
          i18n.tool.tableHeaders.closingBalance,
        ]) {
          const th = document.createElement("th");
          th.scope = "col";
          th.className =
            "border-b border-border-subtle px-2 py-2 text-left font-medium text-text-secondary";
          th.textContent = header;
          headerRow.append(th);
        }
        thead.append(headerRow);
        table.append(thead);

        const tbody = document.createElement("tbody");
        for (const installment of year.installments) {
          const row = document.createElement("tr");
          row.className = "border-b border-border-subtle last:border-0";
          row.dataset.payment = String(installment.paymentNumber);

          const number = document.createElement("th");
          number.scope = "row";
          number.className =
            "px-2 py-2 text-left font-mono text-small text-text-secondary";
          number.textContent = formatEmiDecimal(
            installment.paymentNumber,
            intlLocale,
          );
          row.append(number);

          for (const value of [
            installment.openingBalance,
            installment.payment,
            installment.interest,
            installment.principal,
            installment.closingBalance,
          ]) {
            const cell = document.createElement("td");
            cell.className =
              "px-2 py-2 font-mono text-small tabular-nums text-text-primary";
            cell.textContent = formatEmiMoney(value, intlLocale);
            row.append(cell);
          }
          tbody.append(row);
        }
        table.append(tbody);
        scroll.append(table);
        details.append(summary, scroll);
        schedule.append(details);
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      resetCopyFeedback();

      const amount = parseLocaleNumber(inputAmount.value, intlLocale);
      const rate = parseLocaleNumber(inputRate.value, intlLocale);
      const tenure = parseLocaleNumber(inputTenure.value, intlLocale);
      const tenureUnit = inputTenureUnit.value as TenureUnit;

      let hasError = false;
      let months: number | null = null;

      if (!amount.ok) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          errorMessage(amount.issue),
        );
        hasError = true;
      } else if (amount.value <= 0) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          i18n.tool.errors.amount,
        );
        hasError = true;
      } else {
        hideError(inputAmount, errorAmount, errorTextAmount);
      }

      if (!rate.ok) {
        showError(
          inputRate,
          errorRate,
          errorTextRate,
          errorMessage(rate.issue),
        );
        hasError = true;
      } else if (rate.value < 0) {
        showError(inputRate, errorRate, errorTextRate, i18n.tool.errors.rate);
        hasError = true;
      } else {
        hideError(inputRate, errorRate, errorTextRate);
      }

      if (!tenure.ok) {
        showError(
          inputTenure,
          errorTenure,
          errorTextTenure,
          errorMessage(tenure.issue),
        );
        hasError = true;
      } else {
        months = tenureToMonths(tenure.value, tenureUnit);
        if (months === null || months < 1 || months > MAX_EMI_MONTHS) {
          showError(
            inputTenure,
            errorTenure,
            errorTextTenure,
            i18n.tool.errors.tenure,
          );
          hasError = true;
        } else if (!Number.isInteger(months)) {
          showError(
            inputTenure,
            errorTenure,
            errorTextTenure,
            i18n.tool.errors.fractionalTenure,
          );
          hasError = true;
        } else {
          hideError(inputTenure, errorTenure, errorTextTenure);
        }
      }

      hideGeneralError();

      if (hasError || !amount.ok || !rate.ok || months === null) {
        showEmptyResult();
        return;
      }

      const calculation = calculateEmi(amount.value, rate.value, months);
      if (!calculation.ok) {
        const field = issueField(calculation.issue);
        if (field === "amount") {
          showError(
            inputAmount,
            errorAmount,
            errorTextAmount,
            i18n.tool.errors.amount,
          );
        } else if (field === "rate") {
          showError(inputRate, errorRate, errorTextRate, i18n.tool.errors.rate);
        } else if (field === "tenure") {
          showError(
            inputTenure,
            errorTenure,
            errorTextTenure,
            i18n.tool.errors.tenure,
          );
        } else {
          showGeneralError(i18n.tool.errors.overflow);
        }
        showEmptyResult();
        return;
      }

      const result = calculation.value;
      clearErrors();
      resultGeneration += 1;
      resetCopyFeedback();

      const emi = formatEmiMoney(result.monthlyPayment, intlLocale);
      const principal = formatEmiMoney(result.principal, intlLocale);
      const interest = formatEmiMoney(result.totalInterest, intlLocale);
      const total = formatEmiMoney(result.totalRepayment, intlLocale);
      const principalPercent = formatEmiDecimal(
        (result.principal / result.totalRepayment) * 100,
        intlLocale,
      );
      const interestPercent = formatEmiDecimal(
        (result.totalInterest / result.totalRepayment) * 100,
        intlLocale,
      );

      for (const [element, value] of [
        [emiEl, emi],
        [principalEl, principal],
        [interestEl, interest],
        [totalEl, total],
      ] as const) {
        element.textContent = value;
        element.classList.replace("text-text-disabled", "text-text-primary");
      }
      setText(
        principalShareEl,
        interpolate(i18n.tool.principalShare, {
          amount: principal,
          percent: principalPercent,
        }),
      );
      setText(
        interestShareEl,
        interpolate(i18n.tool.interestShare, {
          amount: interest,
          percent: interestPercent,
        }),
      );
      setText(
        resultCaption,
        interpolate(i18n.tool.caption, {
          amount: formatEmiMoney(result.principal, intlLocale),
          rate: formatEmiDecimal(result.annualRatePercent, intlLocale),
          months: formatEmiDecimal(result.months, intlLocale),
        }),
      );
      setText(
        formulaEl,
        interpolate(i18n.tool.formulas.describe, {
          rate: formatEmiDecimal(result.annualRatePercent, intlLocale),
          monthlyRate: formatEmiDecimal(
            result.annualRatePercent / 12,
            intlLocale,
          ),
        }),
      );
      lastCopyText = interpolate(i18n.tool.copyText, {
        amount: principal,
        emi,
        principal,
        interest,
        total,
        months: formatEmiDecimal(result.months, intlLocale),
      });
      copyButton.disabled = false;
      renderSchedule(result.years);
    });

    inputAmount.addEventListener("input", invalidateResult);
    inputRate.addEventListener("input", invalidateResult);
    inputTenure.addEventListener("input", invalidateResult);
    inputTenureUnit.addEventListener("change", invalidateResult);

    resetButton.addEventListener("click", () => {
      form.reset();
      clearErrors();
      showEmptyResult();
      inputAmount.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      const generation = resultGeneration;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        if (generation !== resultGeneration) return;
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        if (generation !== resultGeneration) return;
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
