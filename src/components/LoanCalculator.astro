---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import { TERM_UNITS } from "../lib/loan";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.loanCalculator;
const localeMeta = getLocale(locale);

/*
 * Strings for the client script — JSON-safe slice of the dictionary plus
 * the locale's Intl formatting locale (calculation stays locale-free).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-loan-calculator data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-calculator-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <div class="space-y-5">
        <div>
          <label for="loan-input-amount" class="text-label text-text-primary">
            {tool.amountLabel}
          </label>
          <input
            id="loan-input-amount"
            name="amount"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="loan-hint-amount loan-error-amount"
            data-input-amount
          />
          <p id="loan-hint-amount" class="mt-1 text-caption text-text-muted">
            {tool.amountHint}
          </p>
          <p
            id="loan-error-amount"
            class="field-error mt-1"
            hidden
            data-error-amount
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-amount></span>
          </p>
        </div>

        <div>
          <label for="loan-input-rate" class="text-label text-text-primary">
            {tool.rateLabel}
          </label>
          <input
            id="loan-input-rate"
            name="rate"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="loan-hint-rate loan-error-rate"
            data-input-rate
          />
          <p id="loan-hint-rate" class="mt-1 text-caption text-text-muted">
            {tool.rateHint}
          </p>
          <p
            id="loan-error-rate"
            class="field-error mt-1"
            hidden
            data-error-rate
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-rate></span>
          </p>
        </div>

        <div>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="loan-input-term" class="text-label text-text-primary">
                {tool.termLabel}
              </label>
              <input
                id="loan-input-term"
                name="term"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                spellcheck="false"
                class="input mt-2 font-mono tabular-nums"
                aria-describedby="loan-hint-term loan-error-term"
                data-input-term
              />
              <p
                id="loan-error-term"
                class="field-error mt-1"
                hidden
                data-error-term
              >
                <span aria-hidden="true" set:html={alertIcon} />
                <span data-error-text-term></span>
              </p>
            </div>

            <div>
              <label
                for="loan-input-term-unit"
                class="text-label text-text-primary"
              >
                {tool.termUnitLabel}
              </label>
              <select
                id="loan-input-term-unit"
                name="termUnit"
                class="input mt-2"
                data-input-term-unit
              >
                {TERM_UNITS.map((unit) => (
                  <option value={unit} selected={unit === "years"}>
                    {tool.termUnits[unit]}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <p id="loan-hint-term" class="mt-1 text-caption text-text-muted">
            {tool.termHint}
          </p>
        </div>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 pr-14">
      <p class="text-caption text-text-secondary">{tool.monthlyLabel}</p>
      <p class="mt-1 text-mono-result text-text-disabled" data-monthly>
        —
      </p>
    </div>
    <div class="mt-4 pr-14">
      <p class="text-caption text-text-secondary">{tool.interestLabel}</p>
      <p
        class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
        data-interest
      >
        —
      </p>
    </div>
    <div class="mt-4 pr-14">
      <p class="text-caption text-text-secondary">{tool.totalLabel}</p>
      <p
        class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
        data-total
      >
        —
      </p>
    </div>
    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={t.calculator.copyResult}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>

  <p class="mt-4 text-small text-text-secondary">
    {t.calculator.formulaLabel}{" "}
    <code class="inline-code" data-formula>
      {tool.formulas.template}
    </code>
  </p>
</div>

<script>
  import {
    calculateLoan,
    describeLoanFormula,
    formatDecimal,
    formatMoney,
    MAX_LOAN_MONTHS,
    termToMonths,
    type TermUnit,
  } from "../lib/loan";
  import { parseLocaleNumber } from "../lib/number-input";
  import type {
    CalculatorStrings,
    LoanCalculatorToolStrings,
  } from "../i18n/dictionary";
  import { interpolate } from "../i18n/interpolate";

  const root = document.querySelector<HTMLElement>("[data-loan-calculator]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: LoanCalculatorToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Loan calculator: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-calculator-form]");
    const inputAmount = requireEl<HTMLInputElement>("[data-input-amount]");
    const inputRate = requireEl<HTMLInputElement>("[data-input-rate]");
    const inputTerm = requireEl<HTMLInputElement>("[data-input-term]");
    const inputTermUnit = requireEl<HTMLSelectElement>(
      "[data-input-term-unit]",
    );
    const errorAmount = requireEl<HTMLElement>("[data-error-amount]");
    const errorTextAmount = requireEl<HTMLElement>("[data-error-text-amount]");
    const errorRate = requireEl<HTMLElement>("[data-error-rate]");
    const errorTextRate = requireEl<HTMLElement>("[data-error-text-rate]");
    const errorTerm = requireEl<HTMLElement>("[data-error-term]");
    const errorTextTerm = requireEl<HTMLElement>("[data-error-text-term]");
    const monthlyEl = requireEl<HTMLElement>("[data-monthly]");
    const interestEl = requireEl<HTMLElement>("[data-interest]");
    const totalEl = requireEl<HTMLElement>("[data-total]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const formulaEl = requireEl<HTMLElement>("[data-formula]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");

    const intlLocale = i18n.intlLocale;
    const FORMULA_TEMPLATE = i18n.tool.formulas.template;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearErrors = () => {
      for (const [wrap, text, input] of [
        [errorAmount, errorTextAmount, inputAmount],
        [errorRate, errorTextRate, inputRate],
        [errorTerm, errorTextTerm, inputTerm],
      ] as const) {
        wrap.hidden = true;
        text.textContent = "";
        input.removeAttribute("aria-invalid");
      }
    };

    const showError = (
      input: HTMLInputElement,
      wrap: HTMLElement,
      text: HTMLElement,
      message: string,
    ) => {
      wrap.hidden = false;
      text.textContent = message;
      input.setAttribute("aria-invalid", "true");
    };

    const showEmptyResult = () => {
      lastCopyText = "";
      resetCopyFeedback();
      for (const el of [monthlyEl, interestEl, totalEl]) {
        el.textContent = "—";
        el.classList.replace("text-text-primary", "text-text-disabled");
      }
      resultCaption.textContent = i18n.calculator.resultsPlaceholder;
      formulaEl.textContent = FORMULA_TEMPLATE;
      copyButton.disabled = true;
    };

    const parseInput = (input: HTMLInputElement) =>
      parseLocaleNumber(input.value, intlLocale);

    const errorMessage = (issue: "invalid" | "ambiguous") =>
      issue === "ambiguous"
        ? i18n.calculator.ambiguousNumber
        : i18n.calculator.invalidNumber;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearErrors();

      const amount = parseInput(inputAmount);
      const rate = parseInput(inputRate);
      const term = parseInput(inputTerm);
      const termUnit = inputTermUnit.value as TermUnit;

      let hasError = false;

      if (!amount.ok) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          errorMessage(amount.issue),
        );
        hasError = true;
      } else if (amount.value <= 0) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          i18n.tool.errors.amount,
        );
        hasError = true;
      }

      if (!rate.ok) {
        showError(
          inputRate,
          errorRate,
          errorTextRate,
          errorMessage(rate.issue),
        );
        hasError = true;
      } else if (rate.value < 0) {
        showError(inputRate, errorRate, errorTextRate, i18n.tool.errors.rate);
        hasError = true;
      }

      let months: number | null = null;
      if (!term.ok) {
        showError(
          inputTerm,
          errorTerm,
          errorTextTerm,
          errorMessage(term.issue),
        );
        hasError = true;
      } else {
        months = termToMonths(term.value, termUnit);
        if (months === null || months < 1 || months > MAX_LOAN_MONTHS) {
          showError(inputTerm, errorTerm, errorTextTerm, i18n.tool.errors.term);
          hasError = true;
        }
      }

      if (hasError || !amount.ok || !rate.ok || months === null) {
        showEmptyResult();
        return;
      }

      const result = calculateLoan(amount.value, rate.value, months);
      if (result === null) {
        showEmptyResult();
        return;
      }

      resetCopyFeedback();

      const monthly = formatMoney(result.monthlyPayment, intlLocale);
      const interest = formatMoney(result.totalInterest, intlLocale);
      const total = formatMoney(result.totalPayable, intlLocale);

      monthlyEl.textContent = monthly;
      monthlyEl.classList.replace("text-text-disabled", "text-text-primary");
      interestEl.textContent = interest;
      interestEl.classList.replace("text-text-disabled", "text-text-primary");
      totalEl.textContent = total;
      totalEl.classList.replace("text-text-disabled", "text-text-primary");

      resultCaption.textContent = interpolate(i18n.tool.caption, {
        amount: formatMoney(amount.value, intlLocale),
        rate: formatDecimal(rate.value, intlLocale),
        months: formatDecimal(result.months, intlLocale),
      });
      formulaEl.textContent = describeLoanFormula(
        rate.value,
        i18n.tool.formulas.describe,
        intlLocale,
      );
      lastCopyText = interpolate(i18n.tool.copyText, {
        monthly,
        interest,
        total,
      });
      copyButton.disabled = false;
    });

    resetButton.addEventListener("click", () => {
      form.reset();
      clearErrors();
      showEmptyResult();
      inputAmount.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
