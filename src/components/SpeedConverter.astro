---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import {
  DEFAULT_SPEED_UNITS,
  SPEED_UNIT_ORDER,
  speedSymbol,
} from "../lib/speed";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.speedConverter;
const localeMeta = getLocale(locale);

/*
 * Strings for the client script — JSON-safe slice of the dictionary plus
 * the locale's Intl formatting locale (calculation stays locale-free).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};

const optionLabel = (unit: string): string =>
  `${(tool.units as Record<string, string>)[unit] ?? ""} (${speedSymbol(unit)})`;
---

<div data-speed-converter data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-calculator-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <div class="space-y-5">
        <div>
          <label
            for="speed-converter-value"
            class="text-label text-text-primary"
          >
            {tool.valueLabel}
          </label>
          <input
            id="speed-converter-value"
            name="value"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="speed-converter-hint-value speed-converter-error-value"
            data-input-value
          />
          <p
            id="speed-converter-hint-value"
            class="mt-1 text-caption text-text-muted"
          >
            {tool.valueHint}
          </p>
          <p
            id="speed-converter-error-value"
            class="field-error mt-1"
            role="alert"
            aria-atomic="true"
            hidden
            data-error-value
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-value></span>
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label
              for="speed-converter-from"
              class="text-label text-text-primary"
            >
              {tool.fromLabel}
            </label>
            <select
              id="speed-converter-from"
              name="from"
              class="input mt-2"
              data-unit-from
            >
              {SPEED_UNIT_ORDER.map((unit) => (
                <option
                  value={unit}
                  selected={unit === DEFAULT_SPEED_UNITS.from}
                >
                  {optionLabel(unit)}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label
              for="speed-converter-to"
              class="text-label text-text-primary"
            >
              {tool.toLabel}
            </label>
            <select
              id="speed-converter-to"
              name="to"
              class="input mt-2"
              data-unit-to
            >
              {SPEED_UNIT_ORDER.map((unit) => (
                <option value={unit} selected={unit === DEFAULT_SPEED_UNITS.to}>
                  {optionLabel(unit)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 flex flex-wrap items-baseline gap-x-2 pr-14">
      <p class="text-mono-result text-text-disabled" data-result>
        —
      </p>
      <p
        class="font-mono text-body font-medium tabular-nums text-text-disabled"
        data-result-unit
      ></p>
    </div>
    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={t.calculator.copyResult}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>
</div>

<script>
  import { convertSpeed, speedSymbol } from "../lib/speed";
  import { formatUnitValue } from "../lib/unit-convert";
  import { parseLocaleNumber } from "../lib/number-input";
  import type {
    CalculatorStrings,
    SpeedConverterToolStrings,
  } from "../i18n/dictionary";
  import { interpolate } from "../i18n/interpolate";

  const root = document.querySelector<HTMLElement>("[data-speed-converter]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: SpeedConverterToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Speed converter: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-calculator-form]");
    const inputValue = requireEl<HTMLInputElement>("[data-input-value]");
    const selectFrom = requireEl<HTMLSelectElement>("[data-unit-from]");
    const selectTo = requireEl<HTMLSelectElement>("[data-unit-to]");
    const errorValue = requireEl<HTMLElement>("[data-error-value]");
    const errorTextValue = requireEl<HTMLElement>("[data-error-text-value]");
    const resultEl = requireEl<HTMLElement>("[data-result]");
    const resultUnitEl = requireEl<HTMLElement>("[data-result-unit]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");

    const intlLocale = i18n.intlLocale;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";
    let resultGeneration = 0;

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearErrors = () => {
      errorValue.hidden = true;
      errorTextValue.textContent = "";
      inputValue.removeAttribute("aria-invalid");
    };

    const showError = (message: string) => {
      if (inputValue.getAttribute("aria-invalid") !== "true") {
        inputValue.setAttribute("aria-invalid", "true");
      }
      if (!errorValue.hidden && errorTextValue.textContent === message) return;
      errorTextValue.textContent = message;
      errorValue.hidden = false;
    };

    const showEmptyResult = () => {
      resultGeneration += 1;
      lastCopyText = "";
      resetCopyFeedback();
      resultEl.textContent = "—";
      resultEl.classList.replace("text-text-primary", "text-text-disabled");
      resultUnitEl.textContent = "";
      resultUnitEl.classList.replace("text-text-primary", "text-text-disabled");
      resultCaption.textContent = i18n.calculator.resultsPlaceholder;
      copyButton.disabled = true;
    };

    /*
     * Keep the result, caption, and clipboard payload tied to one calculation.
     * Any edit to the value or units makes the displayed conversion stale.
     */
    const invalidateResult = () => {
      clearErrors();
      showEmptyResult();
    };

    inputValue.addEventListener("input", invalidateResult);
    selectFrom.addEventListener("change", invalidateResult);
    selectTo.addEventListener("change", invalidateResult);

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const parsed = parseLocaleNumber(inputValue.value, intlLocale);
      if (!parsed.ok) {
        showError(
          parsed.issue === "ambiguous"
            ? i18n.calculator.ambiguousNumber
            : i18n.calculator.invalidNumber,
        );
        showEmptyResult();
        return;
      }

      const from = selectFrom.value;
      const to = selectTo.value;
      const conversion = convertSpeed(parsed.value, from, to);

      if (!conversion.ok) {
        showError(
          conversion.issue === "overflow"
            ? i18n.tool.resultOverflow
            : i18n.calculator.invalidNumber,
        );
        showEmptyResult();
        return;
      }

      const converted = conversion.value;
      clearErrors();
      resultGeneration += 1;
      resetCopyFeedback();

      const formattedInput = formatUnitValue(parsed.value, intlLocale);
      const formattedResult = formatUnitValue(converted, intlLocale);
      const fromSymbol = speedSymbol(from);
      const toSymbol = speedSymbol(to);

      resultEl.textContent = formattedResult;
      resultEl.classList.replace("text-text-disabled", "text-text-primary");
      resultUnitEl.textContent = toSymbol;
      resultUnitEl.classList.replace("text-text-disabled", "text-text-primary");
      resultCaption.textContent = interpolate(i18n.tool.caption, {
        value: formattedInput,
        from: fromSymbol,
        result: formattedResult,
        to: toSymbol,
      });
      lastCopyText = interpolate(i18n.tool.copyText, {
        value: formattedInput,
        from: fromSymbol,
        result: formattedResult,
        to: toSymbol,
      });
      copyButton.disabled = false;
    });

    resetButton.addEventListener("click", () => {
      form.reset();
      invalidateResult();
      inputValue.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      const generation = resultGeneration;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        if (generation !== resultGeneration) return;
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        if (generation !== resultGeneration) return;
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
