---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.percentage;
const localeMeta = getLocale(locale);

/*
 * Strings for the client script — JSON-safe slice of the dictionary plus
 * the locale's Intl formatting locale (calculation stays locale-free).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-percentage-calculator data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-calculator-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <fieldset class="min-w-0">
        <legend class="text-label text-text-primary">{tool.modeLegend}</legend>
        <div class="segmented mt-2">
          <label>
            <input
              type="radio"
              name="mode"
              value="percent-of"
              class="sr-only"
              checked
            />
            {tool.modes["percent-of"].optionLabel}
          </label>
          <label>
            <input
              type="radio"
              name="mode"
              value="what-percent"
              class="sr-only"
            />
            {tool.modes["what-percent"].optionLabel}
          </label>
          <label>
            <input
              type="radio"
              name="mode"
              value="percent-change"
              class="sr-only"
            />
            {tool.modes["percent-change"].optionLabel}
          </label>
        </div>
      </fieldset>

      <div class="mt-6 space-y-5">
        <div>
          <label
            for="calc-input-a"
            class="text-label text-text-primary"
            data-label-a
          >
            {tool.modes["percent-of"].labelA}
          </label>
          <input
            id="calc-input-a"
            name="a"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="calc-hint-a calc-error-a"
            data-input-a
          />
          <p
            id="calc-hint-a"
            class="mt-1 text-caption text-text-muted"
            data-hint-a
          >
            {tool.modes["percent-of"].hintA}
          </p>
          <p id="calc-error-a" class="field-error mt-1" hidden data-error-a>
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-a></span>
          </p>
        </div>

        <div>
          <label
            for="calc-input-b"
            class="text-label text-text-primary"
            data-label-b
          >
            {tool.modes["percent-of"].labelB}
          </label>
          <input
            id="calc-input-b"
            name="b"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="calc-hint-b calc-error-b"
            data-input-b
          />
          <p
            id="calc-hint-b"
            class="mt-1 text-caption text-text-muted"
            data-hint-b
          >
            {tool.modes["percent-of"].hintB}
          </p>
          <p id="calc-error-b" class="field-error mt-1" hidden data-error-b>
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-b></span>
          </p>
        </div>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <p class="mt-2 pr-14 text-mono-result text-text-disabled" data-result-value>
      —
    </p>
    <p class="mt-1 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={t.calculator.copyResult}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>

  <p class="mt-4 text-small text-text-secondary">
    {t.calculator.formulaLabel}{" "}
    <code class="inline-code" data-formula>
      {tool.formulas["percent-of"].template}
    </code>
  </p>
</div>

<script>
  import {
    calculate,
    describeFormula,
    describeResult,
    formatNumber,
    type Mode,
  } from "../lib/percentage";
  import { parseLocaleNumber } from "../lib/number-input";
  import type {
    CalculatorStrings,
    PercentageToolStrings,
  } from "../i18n/dictionary";
  import { interpolate } from "../i18n/interpolate";

  const root = document.querySelector<HTMLElement>(
    "[data-percentage-calculator]",
  );

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: PercentageToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Percentage calculator: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-calculator-form]");
    const inputA = requireEl<HTMLInputElement>("[data-input-a]");
    const inputB = requireEl<HTMLInputElement>("[data-input-b]");
    const labelA = requireEl<HTMLElement>("[data-label-a]");
    const hintA = requireEl<HTMLElement>("[data-hint-a]");
    const labelB = requireEl<HTMLElement>("[data-label-b]");
    const hintB = requireEl<HTMLElement>("[data-hint-b]");
    const errorA = requireEl<HTMLElement>("[data-error-a]");
    const errorTextA = requireEl<HTMLElement>("[data-error-text-a]");
    const errorB = requireEl<HTMLElement>("[data-error-b]");
    const errorTextB = requireEl<HTMLElement>("[data-error-text-b]");
    const resultValue = requireEl<HTMLElement>("[data-result-value]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const formulaEl = requireEl<HTMLElement>("[data-formula]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");
    const radios =
      root.querySelectorAll<HTMLInputElement>('input[name="mode"]');

    const MODES = i18n.tool.modes;
    const FORMULAS = i18n.tool.formulas;
    const RESULTS = i18n.tool.results;
    const intlLocale = i18n.intlLocale;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastResult = "";

    const mode = (): Mode =>
      (root.querySelector<HTMLInputElement>('input[name="mode"]:checked')
        ?.value as Mode | undefined) ?? "percent-of";

    const setCaption = (text: string) => {
      resultCaption.textContent = text;
    };

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearErrors = () => {
      for (const [wrap, text, input] of [
        [errorA, errorTextA, inputA],
        [errorB, errorTextB, inputB],
      ] as const) {
        wrap.hidden = true;
        text.textContent = "";
        input.removeAttribute("aria-invalid");
      }
    };

    const showError = (
      input: HTMLInputElement,
      wrap: HTMLElement,
      text: HTMLElement,
      message: string,
    ) => {
      wrap.hidden = false;
      text.textContent = message;
      input.setAttribute("aria-invalid", "true");
    };

    const showEmptyResult = () => {
      lastResult = "";
      resetCopyFeedback();
      resultValue.textContent = "—";
      resultValue.classList.replace("text-text-primary", "text-text-disabled");
      setCaption(i18n.calculator.resultsPlaceholder);
      formulaEl.textContent = FORMULAS[mode()].template;
      copyButton.disabled = true;
    };

    const applyMode = () => {
      const copy = MODES[mode()];
      labelA.textContent = copy.labelA;
      hintA.textContent = copy.hintA;
      labelB.textContent = copy.labelB;
      hintB.textContent = copy.hintB;
      clearErrors();
      showEmptyResult();
    };

    const parseInput = (input: HTMLInputElement) =>
      parseLocaleNumber(input.value, intlLocale);

    const captionFor = (
      activeMode: Mode,
      a: number,
      b: number,
      value: number,
    ) => {
      if (activeMode === "percent-of")
        return interpolate(i18n.tool.captions.percentOf, {
          percent: formatNumber(a, intlLocale),
          value: formatNumber(b, intlLocale),
        });
      if (activeMode === "what-percent")
        return interpolate(i18n.tool.captions.whatPercent, {
          part: formatNumber(a, intlLocale),
          whole: formatNumber(b, intlLocale),
        });
      return value === 0
        ? interpolate(i18n.tool.captions.noChange, {
            from: formatNumber(a, intlLocale),
            to: formatNumber(b, intlLocale),
          })
        : interpolate(i18n.tool.captions.change, {
            from: formatNumber(a, intlLocale),
            to: formatNumber(b, intlLocale),
          });
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearErrors();

      const a = parseInput(inputA);
      const b = parseInput(inputB);
      const errorMessage = (issue: "invalid" | "ambiguous") =>
        issue === "ambiguous"
          ? i18n.calculator.ambiguousNumber
          : i18n.calculator.invalidNumber;
      if (!a.ok) {
        showError(inputA, errorA, errorTextA, errorMessage(a.issue));
      }
      if (!b.ok) {
        showError(inputB, errorB, errorTextB, errorMessage(b.issue));
      }
      if (!a.ok || !b.ok) {
        showEmptyResult();
        return;
      }

      const activeMode = mode();
      const value = calculate(activeMode, a.value, b.value);
      resetCopyFeedback();

      if (value === null) {
        lastResult = "";
        resultValue.textContent = i18n.tool.undefinedResult;
        resultValue.classList.replace(
          "text-text-disabled",
          "text-text-primary",
        );
        setCaption(
          activeMode === "percent-change"
            ? a.value === 0
              ? i18n.tool.captions.changeFromZero
              : i18n.tool.captions.changeFromNegative
            : i18n.tool.captions.divideByZero,
        );
        formulaEl.textContent = FORMULAS[activeMode].template;
        copyButton.disabled = true;
        return;
      }

      lastResult = describeResult(activeMode, value, RESULTS, intlLocale);
      resultValue.textContent = lastResult;
      resultValue.classList.replace("text-text-disabled", "text-text-primary");
      setCaption(captionFor(activeMode, a.value, b.value, value));
      formulaEl.textContent = describeFormula(
        a.value,
        b.value,
        value,
        FORMULAS[activeMode].describe,
        intlLocale,
      );
      copyButton.disabled = false;
    });

    radios.forEach((radio) => radio.addEventListener("change", applyMode));

    resetButton.addEventListener("click", () => {
      form.reset();
      applyMode();
      inputA.focus();
    });

    copyButton.addEventListener("click", async () => {
      if (!lastResult || copyBusy) return;
      copyBusy = true;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastResult);
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
