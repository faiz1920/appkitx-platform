---
const columns = [
  {
    heading: "Tools",
    links: [
      { label: "Percentage Calculator", href: "/percentage-calculator" },
      { label: "Unit Converter", href: "#" },
      { label: "Loan Calculator", href: "#" },
      { label: "Date Calculator", href: "#" },
    ],
  },
  {
    heading: "Categories",
    links: [
      { label: "Calculators", href: "#" },
      { label: "Converters", href: "#" },
      { label: "Developer tools", href: "#" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "#" },
      { label: "Contact", href: "#" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy", href: "#" },
      { label: "Terms", href: "#" },
    ],
  },
];
---

<footer class="border-t border-border-subtle bg-surface-subtle">
  <div class="mx-auto max-w-(--layout-container) px-6 py-12">
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 md:grid-cols-4">
      {columns.map((column) => (
        <div>
          <h3 class="text-overline text-text-muted uppercase">
            {column.heading}
          </h3>
          <ul class="mt-4 space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="focus-ring text-small text-text-secondary hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle pt-6">
      <p class="text-micro text-text-muted">© 2026 AppKitX</p>
      <p class="text-micro text-text-muted">
        <a href="#" class="focus-ring hover:text-accent">
          Privacy
        </a>
        <span aria-hidden="true"> · </span>
        <a href="#" class="focus-ring hover:text-accent">
          Terms
        </a>
      </p>
    </div>
  </div>
</footer>
