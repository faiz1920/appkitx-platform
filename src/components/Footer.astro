---
import { defaultLocale, getDictionary, type LocaleCode } from "../i18n/config";
import { resolveLocalizedTools } from "../i18n/tool-catalog";
import { localizedHref } from "../i18n/routing";
import {
  categoryPath,
  isCategoryPublished,
  type ToolCategory,
} from "../lib/categories";
import {
  guideIndexHref,
  infoPageHref,
  type InfoPageKey,
} from "../lib/editorial";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const footer = t.footer.columns;

/*
 * Labels have one canonical source: shipped tool names come from the tool
 * dictionaries (via the localized catalog), shipped category names from the
 * category map, and the placeholder tool titles from the homepage copy.
 */
const shippedTools = resolveLocalizedTools(locale, [
  "/percentage-calculator",
  "/discount-calculator",
  "/base64-encoder",
  "/json-formatter",
  "/date-calculator",
  "/age-calculator",
]).map((tool) => ({
  label: tool.title,
  href: localizedHref(tool.href, locale),
}));

/*
 * Planned tools and unpublished categories render as plain muted text, not
 * links, so the footer never presents a placeholder as a working tool.
 */
const placeholderTools = [
  t.home.placeholderTools.unitConverter.title,
  t.home.placeholderTools.loanCalculator.title,
].map((label) => ({ label }));

const footerCategories: ToolCategory[] = [
  "Calculators",
  "Converters",
  "Developer tools",
  "Date & time",
];

const infoLink = (key: InfoPageKey, label: string) => ({
  label,
  href: infoPageHref(key, locale),
});

const columns: Array<{
  heading: string;
  links: Array<{ label: string; href?: string }>;
}> = [
  {
    heading: footer.tools.heading,
    links: [
      ...shippedTools,
      {
        label: t.footer.guides,
        href: guideIndexHref(locale),
      },
      ...placeholderTools,
    ],
  },
  {
    heading: footer.categories.heading,
    links: footerCategories.map((category) => ({
      label: t.categories[category].name,
      ...(isCategoryPublished(category)
        ? { href: localizedHref(categoryPath(category), locale) }
        : {}),
    })),
  },
  {
    heading: footer.company.heading,
    links: [
      infoLink("about", footer.company.about),
      infoLink("contact", footer.company.contact),
    ],
  },
  {
    heading: footer.legal.heading,
    links: [
      infoLink("privacy", footer.legal.privacy),
      infoLink("terms", footer.legal.terms),
      infoLink("affiliateDisclosure", footer.legal.affiliateDisclosure),
    ],
  },
];
---

<footer class="border-t border-border-subtle bg-surface-subtle">
  <div class="mx-auto max-w-(--layout-container) px-6 py-12">
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {columns.map((column) => (
        <div>
          <h2 class="text-overline text-text-muted uppercase">
            {column.heading}
          </h2>
          <ul class="mt-4 space-y-2">
            {column.links.map((link) => (
              <li>
                {link.href ? (
                  <a
                    href={link.href}
                    class="focus-ring inline-flex min-h-6 items-center text-small text-text-secondary hover:text-accent active:text-accent-active"
                  >
                    {link.label}
                  </a>
                ) : (
                  <span class="text-small text-text-muted">{link.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 border-t border-border-subtle pt-6">
      <p class="text-micro text-text-muted">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
