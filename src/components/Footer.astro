---
import { defaultLocale, getDictionary, type LocaleCode } from "../i18n/config";
import { resolveLocalizedTools } from "../i18n/tool-catalog";
import { localizedPath } from "../i18n/routing";
import {
  categoryPath,
  isCategoryPublished,
  type ToolCategory,
} from "../lib/categories";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const footer = t.footer.columns;

/*
 * Labels have one canonical source: shipped tool names come from the tool
 * dictionaries (via the localized catalog), shipped category names from the
 * category map, and the placeholder tool titles from the homepage copy.
 */
const shippedTools = resolveLocalizedTools(locale, [
  "/percentage-calculator",
  "/discount-calculator",
  "/base64-encoder",
  "/json-formatter",
  "/date-calculator",
  "/age-calculator",
]).map((tool) => ({
  label: tool.title,
  href: localizedPath(tool.href, locale),
}));

const placeholderTools = [
  t.home.placeholderTools.unitConverter.title,
  t.home.placeholderTools.loanCalculator.title,
].map((label) => ({ label, href: "#" }));

/*
 * Category links become real links as categories publish; unpublished
 * categories keep the placeholder href they have always had.
 */
const footerCategories: ToolCategory[] = [
  "Calculators",
  "Converters",
  "Developer tools",
  "Date & time",
];

const columns = [
  {
    heading: footer.tools.heading,
    links: [...shippedTools, ...placeholderTools],
  },
  {
    heading: footer.categories.heading,
    links: footerCategories.map((category) => ({
      label: t.categories[category].name,
      href: isCategoryPublished(category)
        ? localizedPath(categoryPath(category), locale)
        : "#",
    })),
  },
  {
    heading: footer.company.heading,
    links: [
      { label: footer.company.about, href: "#" },
      { label: footer.company.contact, href: "#" },
    ],
  },
  {
    heading: footer.legal.heading,
    links: [
      { label: footer.legal.privacy, href: "#" },
      { label: footer.legal.terms, href: "#" },
    ],
  },
];
---

<footer class="border-t border-border-subtle bg-surface-subtle">
  <div class="mx-auto max-w-(--layout-container) px-6 py-12">
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 md:grid-cols-4">
      {columns.map((column) => (
        <div>
          <h3 class="text-overline text-text-muted uppercase">
            {column.heading}
          </h3>
          <ul class="mt-4 space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="focus-ring text-small text-text-secondary hover:text-accent active:text-accent-active"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle pt-6">
      <p class="text-micro text-text-muted">{t.footer.copyright}</p>
      <p class="text-micro text-text-muted">
        <a href="#" class="focus-ring hover:text-accent">
          {footer.legal.privacy}
        </a>
        <span aria-hidden="true"> · </span>
        <a href="#" class="focus-ring hover:text-accent">
          {footer.legal.terms}
        </a>
      </p>
    </div>
  </div>
</footer>
