---
import alertIcon from "lucide-static/icons/circle-alert.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";
import copyIcon from "lucide-static/icons/copy.svg?raw";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";

interface Props {
  locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tool = t.tools.dateCalculator;
const localeMeta = getLocale(locale);

/*
 * Strings for the client script — JSON-safe slice of the dictionary plus
 * the locale's Intl formatting locale (arithmetic stays locale-free).
 */
const scriptStrings = {
  calculator: t.calculator,
  tool,
  intlLocale: localeMeta.intlLocale,
};
---

<div data-date-calculator data-i18n={JSON.stringify(scriptStrings)}>
  <form novalidate data-tool-form>
    <div class="rounded-lg border border-border-subtle bg-surface p-(--layout-panel-padding)">
      <fieldset class="min-w-0">
        <legend class="text-label text-text-primary">{tool.modeLegend}</legend>
        <div class="segmented mt-2">
          <label>
            <input
              type="radio"
              name="mode"
              value="difference"
              class="sr-only"
              checked
            />
            {tool.modes.difference.optionLabel}
          </label>
          <label>
            <input type="radio" name="mode" value="shift" class="sr-only" />
            {tool.modes.shift.optionLabel}
          </label>
        </div>
      </fieldset>

      <div class="mt-6 space-y-5" data-fields-difference>
        <div>
          <label
            for="date-calc-input-start"
            class="text-label text-text-primary"
          >
            {tool.startLabel}
          </label>
          <input
            id="date-calc-input-start"
            name="start"
            type="date"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="date-calc-error-start"
            data-input-start
          />
          <p
            id="date-calc-error-start"
            class="field-error mt-1"
            hidden
            data-error-start
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-start></span>
          </p>
        </div>

        <div>
          <label for="date-calc-input-end" class="text-label text-text-primary">
            {tool.endLabel}
          </label>
          <input
            id="date-calc-input-end"
            name="end"
            type="date"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="date-calc-error-end"
            data-input-end
          />
          <p
            id="date-calc-error-end"
            class="field-error mt-1"
            hidden
            data-error-end
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-end></span>
          </p>
        </div>
      </div>

      <div class="mt-6 space-y-5" hidden data-fields-shift>
        <div>
          <label
            for="date-calc-input-date"
            class="text-label text-text-primary"
          >
            {tool.dateLabel}
          </label>
          <input
            id="date-calc-input-date"
            name="date"
            type="date"
            class="input mt-2 font-mono tabular-nums"
            aria-describedby="date-calc-error-date"
            data-input-date
          />
          <p
            id="date-calc-error-date"
            class="field-error mt-1"
            hidden
            data-error-date
          >
            <span aria-hidden="true" set:html={alertIcon} />
            <span data-error-text-date></span>
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label
              for="date-calc-input-amount"
              class="text-label text-text-primary"
            >
              {tool.amountLabel}
            </label>
            <input
              id="date-calc-input-amount"
              name="amount"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              spellcheck="false"
              class="input mt-2 font-mono tabular-nums"
              aria-describedby="date-calc-hint-amount date-calc-error-amount"
              data-input-amount
            />
            <p
              id="date-calc-hint-amount"
              class="mt-1 text-caption text-text-muted"
            >
              {tool.amountHint}
            </p>
            <p
              id="date-calc-error-amount"
              class="field-error mt-1"
              hidden
              data-error-amount
            >
              <span aria-hidden="true" set:html={alertIcon} />
              <span data-error-text-amount></span>
            </p>
          </div>

          <div>
            <label
              for="date-calc-input-unit"
              class="text-label text-text-primary"
            >
              {tool.unitLabel}
            </label>
            <select
              id="date-calc-input-unit"
              name="unit"
              class="input mt-2"
              data-input-unit
            >
              <option value="days">{tool.units.days}</option>
              <option value="weeks">{tool.units.weeks}</option>
              <option value="months">{tool.units.months}</option>
              <option value="years">{tool.units.years}</option>
            </select>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary w-full">
          {t.calculator.calculate}
        </button>
        <button type="button" class="btn btn-secondary mt-3 w-full" data-reset>
          {t.calculator.reset}
        </button>
      </div>
    </div>
  </form>

  <div
    class="relative mt-6 rounded-lg bg-accent-subtle p-(--layout-card-padding)"
    aria-live="polite"
    data-result-region
  >
    <p class="text-overline text-text-secondary uppercase">
      {t.calculator.resultLabel}
    </p>
    <div class="mt-2 pr-14" data-days-block>
      <p class="text-caption text-text-secondary">{tool.daysLabel}</p>
      <p class="mt-1 text-mono-result text-text-disabled" data-days-value>
        —
      </p>
    </div>
    <div class="mt-4 pr-14" data-breakdown-block>
      <p class="text-caption text-text-secondary">{tool.breakdownLabel}</p>
      <p
        class="mt-1 font-mono text-body font-medium tabular-nums text-text-disabled"
        data-breakdown-value
      >
        —
      </p>
    </div>
    <div class="mt-2 pr-14" hidden data-date-block>
      <p class="text-caption text-text-secondary">{tool.resultDateLabel}</p>
      <p class="mt-1 text-mono-result text-text-disabled" data-date-value>
        —
      </p>
    </div>
    <div class="mt-4 pr-14" hidden data-weekday-block>
      <p class="text-caption text-text-secondary">{tool.weekdayLabel}</p>
      <p
        class="mt-1 font-mono text-body font-medium text-text-disabled"
        data-weekday-value
      >
        —
      </p>
    </div>
    <p class="mt-3 pr-14 text-caption text-text-muted" data-result-caption>
      {t.calculator.resultsPlaceholder}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-success"
      hidden
      data-copy-status-success
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={checkIcon}
      />
      {t.calculator.copied}
    </p>
    <p
      class="mt-2 flex items-center gap-1.5 text-caption text-error"
      hidden
      data-copy-status-error
    >
      <span
        class="h-3.5 w-3.5 [&_svg]:h-3.5 [&_svg]:w-3.5"
        aria-hidden="true"
        set:html={alertIcon}
      />
      {t.calculator.copyFailed}
    </p>
    <button
      type="button"
      class="btn btn-ghost absolute top-3 right-3 w-11 px-0"
      aria-label={t.calculator.copyResult}
      disabled
      data-copy
    >
      <span
        class="h-5 w-5 [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        data-copy-idle
        set:html={copyIcon}
      />
      <span
        class="h-5 w-5 text-success [&_svg]:h-5 [&_svg]:w-5"
        aria-hidden="true"
        hidden
        data-copy-done
        set:html={checkIcon}
      />
    </button>
  </div>
</div>

<script>
  import {
    daysFromCivil,
    difference,
    parseDateInput,
    shiftDate,
    type CivilDate,
    type DateUnit,
  } from "../lib/date-math";
  import {
    formatBreakdown,
    formatDayCount,
    formatLongDate,
    formatUnitAmount,
    formatWeekday,
  } from "../lib/date-format";
  import { parseLocaleNumber } from "../lib/number-input";
  import { interpolate } from "../i18n/interpolate";
  import type {
    CalculatorStrings,
    DateCalculatorToolStrings,
  } from "../i18n/dictionary";

  const root = document.querySelector<HTMLElement>("[data-date-calculator]");

  if (root) {
    const i18n: {
      calculator: CalculatorStrings;
      tool: DateCalculatorToolStrings;
      intlLocale: string;
    } = JSON.parse(root.dataset.i18n ?? "{}");

    const requireEl = <T extends Element>(selector: string): T => {
      const el = root.querySelector<T>(selector);
      if (!el) throw new Error(`Date calculator: missing ${selector}`);
      return el;
    };

    const form = requireEl<HTMLFormElement>("[data-tool-form]");
    const fieldsDifference = requireEl<HTMLElement>("[data-fields-difference]");
    const fieldsShift = requireEl<HTMLElement>("[data-fields-shift]");
    const inputStart = requireEl<HTMLInputElement>("[data-input-start]");
    const inputEnd = requireEl<HTMLInputElement>("[data-input-end]");
    const inputDate = requireEl<HTMLInputElement>("[data-input-date]");
    const inputAmount = requireEl<HTMLInputElement>("[data-input-amount]");
    const inputUnit = requireEl<HTMLSelectElement>("[data-input-unit]");
    const errorStart = requireEl<HTMLElement>("[data-error-start]");
    const errorTextStart = requireEl<HTMLElement>("[data-error-text-start]");
    const errorEnd = requireEl<HTMLElement>("[data-error-end]");
    const errorTextEnd = requireEl<HTMLElement>("[data-error-text-end]");
    const errorDate = requireEl<HTMLElement>("[data-error-date]");
    const errorTextDate = requireEl<HTMLElement>("[data-error-text-date]");
    const errorAmount = requireEl<HTMLElement>("[data-error-amount]");
    const errorTextAmount = requireEl<HTMLElement>("[data-error-text-amount]");
    const daysBlock = requireEl<HTMLElement>("[data-days-block]");
    const breakdownBlock = requireEl<HTMLElement>("[data-breakdown-block]");
    const dateBlock = requireEl<HTMLElement>("[data-date-block]");
    const weekdayBlock = requireEl<HTMLElement>("[data-weekday-block]");
    const daysValue = requireEl<HTMLElement>("[data-days-value]");
    const breakdownValue = requireEl<HTMLElement>("[data-breakdown-value]");
    const dateValue = requireEl<HTMLElement>("[data-date-value]");
    const weekdayValue = requireEl<HTMLElement>("[data-weekday-value]");
    const resultCaption = requireEl<HTMLElement>("[data-result-caption]");
    const copyButton = requireEl<HTMLButtonElement>("[data-copy]");
    const copyIdle = requireEl<HTMLElement>("[data-copy-idle]");
    const copyDone = requireEl<HTMLElement>("[data-copy-done]");
    const copyStatusSuccess = requireEl<HTMLElement>(
      "[data-copy-status-success]",
    );
    const copyStatusError = requireEl<HTMLElement>("[data-copy-status-error]");
    const resetButton = requireEl<HTMLButtonElement>("[data-reset]");
    const radios =
      root.querySelectorAll<HTMLInputElement>('input[name="mode"]');

    const intlLocale = i18n.intlLocale;

    let copyTimer: number | undefined;
    let copyBusy = false;
    let lastCopyText = "";

    const mode = (): "difference" | "shift" =>
      (root.querySelector<HTMLInputElement>('input[name="mode"]:checked')
        ?.value as "difference" | "shift" | undefined) ?? "difference";

    const resetCopyFeedback = () => {
      window.clearTimeout(copyTimer);
      copyIdle.hidden = false;
      copyDone.hidden = true;
      copyStatusSuccess.hidden = true;
      copyStatusError.hidden = true;
    };

    const clearErrors = () => {
      for (const [wrap, text, input] of [
        [errorStart, errorTextStart, inputStart],
        [errorEnd, errorTextEnd, inputEnd],
        [errorDate, errorTextDate, inputDate],
        [errorAmount, errorTextAmount, inputAmount],
      ] as const) {
        wrap.hidden = true;
        text.textContent = "";
        input.removeAttribute("aria-invalid");
      }
    };

    const showError = (
      input: HTMLInputElement,
      wrap: HTMLElement,
      text: HTMLElement,
      message: string,
    ) => {
      wrap.hidden = false;
      text.textContent = message;
      input.setAttribute("aria-invalid", "true");
    };

    const showEmptyResult = () => {
      lastCopyText = "";
      resetCopyFeedback();
      for (const el of [daysValue, breakdownValue, dateValue, weekdayValue]) {
        el.textContent = "—";
        el.classList.replace("text-text-primary", "text-text-disabled");
      }
      resultCaption.textContent = i18n.calculator.resultsPlaceholder;
      daysBlock.hidden = false;
      breakdownBlock.hidden = false;
      dateBlock.hidden = true;
      weekdayBlock.hidden = true;
      if (mode() === "shift") {
        daysBlock.hidden = true;
        breakdownBlock.hidden = true;
        dateBlock.hidden = false;
        weekdayBlock.hidden = false;
      }
      copyButton.disabled = true;
    };

    const completeValue = (el: HTMLElement, text: string) => {
      el.textContent = text;
      el.classList.replace("text-text-disabled", "text-text-primary");
    };

    const parseDate = (input: HTMLInputElement): CivilDate | null =>
      input.value === "" ? null : parseDateInput(input.value);

    const runDifference = () => {
      let hasError = false;

      const start = parseDate(inputStart);
      const end = parseDate(inputEnd);
      if (start === null) {
        showError(
          inputStart,
          errorStart,
          errorTextStart,
          i18n.tool.errors.emptyStart,
        );
        hasError = true;
      }
      if (end === null) {
        showError(inputEnd, errorEnd, errorTextEnd, i18n.tool.errors.emptyEnd);
        hasError = true;
      }
      if (hasError || start === null || end === null) {
        showEmptyResult();
        return;
      }

      const result = difference(start, end);
      if (result === null) {
        showEmptyResult();
        return;
      }

      /* Caption and copy read chronologically even when dates are reversed. */
      const [from, to] =
        daysFromCivil(start) <= daysFromCivil(end)
          ? [start, end]
          : [end, start];

      const daysText = formatDayCount(result.days, intlLocale);
      const breakdownText = formatBreakdown(result.breakdown, intlLocale);
      const fromText = formatLongDate(from, intlLocale);
      const toText = formatLongDate(to, intlLocale);

      completeValue(daysValue, daysText);
      completeValue(breakdownValue, breakdownText);
      resultCaption.textContent = interpolate(i18n.tool.differenceCaption, {
        from: fromText,
        to: toText,
      });
      lastCopyText = interpolate(i18n.tool.differenceCopy, {
        days: daysText,
        from: fromText,
        to: toText,
        breakdown: breakdownText,
      });
      copyButton.disabled = false;
    };

    const runShift = () => {
      let hasError = false;

      const start = parseDate(inputDate);
      if (start === null) {
        showError(
          inputDate,
          errorDate,
          errorTextDate,
          i18n.tool.errors.emptyDate,
        );
        hasError = true;
      }

      const amount = parseLocaleNumber(inputAmount.value, intlLocale);
      let amountValue = 0;
      if (inputAmount.value.trim() === "") {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          i18n.tool.errors.amountRange,
        );
        hasError = true;
      } else if (!amount.ok) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          amount.issue === "ambiguous"
            ? i18n.calculator.ambiguousNumber
            : i18n.calculator.invalidNumber,
        );
        hasError = true;
      } else if (!Number.isInteger(amount.value)) {
        showError(
          inputAmount,
          errorAmount,
          errorTextAmount,
          i18n.tool.errors.amountRange,
        );
        hasError = true;
      } else {
        amountValue = amount.value;
      }

      if (hasError || start === null) {
        showEmptyResult();
        return;
      }

      const unit = inputUnit.value as DateUnit;
      const shifted = shiftDate(start, amountValue, unit);
      if (shifted === null) {
        showEmptyResult();
        return;
      }

      const dateText = formatLongDate(shifted, intlLocale);
      const weekdayText = formatWeekday(shifted, intlLocale);

      completeValue(dateValue, dateText);
      completeValue(weekdayValue, weekdayText);
      resultCaption.textContent = interpolate(
        amountValue < 0
          ? i18n.tool.shiftSubtractCaption
          : i18n.tool.shiftAddCaption,
        {
          amount: formatUnitAmount(Math.abs(amountValue), unit, intlLocale),
          date: formatLongDate(start, intlLocale),
        },
      );
      lastCopyText = interpolate(i18n.tool.shiftCopy, {
        date: dateText,
        weekday: weekdayText,
      });
      copyButton.disabled = false;
    };

    const applyMode = () => {
      const activeMode = mode();
      fieldsDifference.hidden = activeMode !== "difference";
      fieldsShift.hidden = activeMode !== "shift";
      clearErrors();
      showEmptyResult();
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearErrors();
      resetCopyFeedback();
      if (mode() === "difference") {
        runDifference();
      } else {
        runShift();
      }
    });

    radios.forEach((radio) => radio.addEventListener("change", applyMode));

    resetButton.addEventListener("click", () => {
      form.reset();
      clearErrors();
      showEmptyResult();
      if (mode() === "difference") {
        inputStart.focus();
      } else {
        inputDate.focus();
      }
    });

    copyButton.addEventListener("click", async () => {
      if (!lastCopyText || copyBusy) return;
      copyBusy = true;
      resetCopyFeedback();
      try {
        await navigator.clipboard.writeText(lastCopyText);
        copyIdle.hidden = true;
        copyDone.hidden = false;
        copyStatusSuccess.hidden = false;
        copyTimer = window.setTimeout(() => {
          copyIdle.hidden = false;
          copyDone.hidden = true;
          copyStatusSuccess.hidden = true;
        }, 2000);
      } catch {
        copyStatusError.hidden = false;
      } finally {
        copyBusy = false;
      }
    });
  }
</script>
