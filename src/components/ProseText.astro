---
import { splitProseSpans, type ProseSegment } from "../i18n/prose";
import { defaultLocale, type LocaleCode } from "../i18n/config";
import { localizedHref } from "../i18n/routing";
import type { ProseSectionStrings } from "../i18n/dictionary";

interface Props {
  sections: readonly ProseSectionStrings[];
  /** Locale used to localize in-prose links; defaults to English. */
  locale?: LocaleCode;
}

const { sections, locale = defaultLocale } = Astro.props;

/* Render prose segments as text, code, and internal links — no raw HTML. */
const renderSegments = (text: string): ProseSegment[] => splitProseSpans(text);
const paragraph = (section: ProseSectionStrings): readonly string[] =>
  section.paragraphs ?? [];
const items = (section: ProseSectionStrings): readonly string[] =>
  section.items ?? [];
---

{sections.map((section, index) => (
  <>
    {index === 0 ? <h2>{section.heading}</h2> : <h3>{section.heading}</h3>}
    {paragraph(section).map((text) => (
      <p>
        {renderSegments(text).map((segment) =>
          segment.href ? (
            <a href={localizedHref(segment.href, locale)} class="focus-ring">
              {segment.text}
            </a>
          ) : segment.code ? (
            <code>{segment.text}</code>
          ) : (
            segment.text
          ),
        )}
      </p>
    ))}
    {items(section).length > 0 && (
      <ul>
        {items(section).map((text) => (
          <li>
            {renderSegments(text).map((segment) =>
              segment.href ? (
                <a
                  href={localizedHref(segment.href, locale)}
                  class="focus-ring"
                >
                  {segment.text}
                </a>
              ) : segment.code ? (
                <code>{segment.text}</code>
              ) : (
                segment.text
              ),
            )}
          </li>
        ))}
      </ul>
    )}
  </>
))}
