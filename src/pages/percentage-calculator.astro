---
import ToolLayout from "../layouts/ToolLayout.astro";
import PercentageCalculator from "../components/PercentageCalculator.astro";
import { resolveTools } from "../lib/tools";
import { getDictionary } from "../i18n/config";
import tagIcon from "lucide-static/icons/tag.svg?raw";

const t = getDictionary();
const tool = t.tools.percentage;

const toolIcons: Record<string, string> = { tag: tagIcon };
const relatedTools = resolveTools(["/discount-calculator"]).map((related) => ({
  title: related.title,
  description: related.description,
  href: related.href,
  icon: toolIcons[related.icon] ?? "",
}));
---

<ToolLayout
  title={tool.title}
  description={tool.metaDescription}
  toolName={tool.name}
  toolDescription={tool.description}
  breadcrumb={[
    { label: t.toolLayout.breadcrumbHome, href: "/" },
    { label: tool.name },
  ]}
  relatedTools={relatedTools}
>
  <PercentageCalculator slot="tool" />

  <h2>How it works</h2>
  <p>
    The calculator covers three common percentage problems. Pick a mode, enter
    two numbers, and select Calculate. Results update in place — no page reload
    — and can be copied with one click.
  </p>

  <h3>Find X% of Y</h3>
  <p>
    Multiplies the value by the percentage and divides by 100 — the standard way
    to take a percentage of a number.
  </p>
  <p>
    Formula: <code>(X ÷ 100) × Y</code>. Example: 25% of 80 is
    <code>(25 ÷ 100) × 80 = 20</code>.
  </p>

  <h3>X is what percentage of Y?</h3>
  <p>
    Divides the first number by the second and multiplies by 100 to express it
    as a share of the whole.
  </p>
  <p>
    Formula: <code>(X ÷ Y) × 100</code>. Example: 20 out of 80 is
    <code>(20 ÷ 80) × 100 = 25%</code>.
  </p>

  <h3>Percentage change</h3>
  <p>
    Measures the increase or decrease from an original value to a new value, as
    a percentage of the original.
  </p>
  <p>
    Formula: <code>((To − From) ÷ From) × 100</code>. Example: from 80 to 100 is{" "}
    <code>((100 − 80) ÷ 80) × 100 = 25%</code>, a 25% increase.
  </p>

  <h3>Assumptions and edge cases</h3>
  <ul>
    <li>
      Results are calculated at full precision and rounded only for display — up
      to six decimal places, with trailing zeros removed.
    </li>
    <li>
      Negative and decimal inputs are allowed and applied literally; nothing is
      clamped.
    </li>
    <li>
      Dividing by zero is undefined: the "What %" mode requires a non-zero
      whole. Percentage change requires a positive original value — a zero
      baseline divides by zero, and a negative baseline would produce a
      misleading increase or decrease. The calculator explains these cases
      instead of showing Infinity, NaN, or a misleading percentage.
    </li>
    <li>
      An increase and a decrease of the same amount are not symmetrical — going
      from 80 to 100 is a 25% increase, but going back from 100 to 80 is a 20%
      decrease, because the change is always relative to the original value.
    </li>
  </ul>
</ToolLayout>
