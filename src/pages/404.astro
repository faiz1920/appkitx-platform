---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalNav from "../components/GlobalNav.astro";
import Footer from "../components/Footer.astro";
import { tools } from "../lib/tools";
import searchIcon from "lucide-static/icons/search.svg?raw";
---

<BaseLayout
  title="Page not found — AppKitX"
  description="The page you are looking for does not exist. Search for a tool or browse the AppKitX calculators."
  noindex
>
  <GlobalNav />
  <main id="main">
    <div class="mx-auto max-w-(--layout-tool) px-6 py-16 text-center md:py-24">
      <h1 class="text-headline text-text-primary">Page not found</h1>
      <p class="mt-3 text-body text-text-secondary">
        The page you're looking for doesn't exist or may have moved.
      </p>

      <div class="mt-8 text-left">
        <label for="not-found-search" class="text-label text-text-primary">
          Search tools
        </label>
        <form class="relative mt-2" role="search" data-not-found-search>
          <span
            class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-text-muted [&_svg]:h-5 [&_svg]:w-5"
            aria-hidden="true"
            set:html={searchIcon}
          />
          <input
            id="not-found-search"
            type="search"
            class="input input-search"
            placeholder="Search free tools…"
            data-not-found-search-input
          />
        </form>
      </div>

      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {tools.map((tool) => (
          <li>
            <a href={tool.href} class="chip focus-ring">
              {tool.title}
            </a>
          </li>
        ))}
      </ul>

      <a href="/" class="btn btn-primary mt-8">
        Go to homepage
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "[data-not-found-search]",
  );
  const input = document.querySelector<HTMLInputElement>(
    "[data-not-found-search-input]",
  );

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? "";
    if (query === "") return;
    document.dispatchEvent(
      new CustomEvent("appkitx:search-open", { detail: { query } }),
    );
  });
</script>
