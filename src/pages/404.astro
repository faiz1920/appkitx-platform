---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalNav from "../components/GlobalNav.astro";
import Footer from "../components/Footer.astro";
import { tools } from "../lib/tools";
import { defaultLocale, getDictionary } from "../i18n/config";
import { localizedHref } from "../i18n/routing";
import searchIcon from "lucide-static/icons/search.svg?raw";

const t = getDictionary();
---

<BaseLayout
  title={t.notFound.title}
  description={t.notFound.metaDescription}
  noindex
>
  <GlobalNav />
  <main id="main">
    <div class="mx-auto max-w-(--layout-tool) px-6 py-16 text-center md:py-24">
      <h1 class="text-headline text-text-primary">{t.notFound.heading}</h1>
      <p class="mt-3 text-body text-text-secondary">{t.notFound.body}</p>

      <div class="mt-8 text-left">
        <label for="not-found-search" class="text-label text-text-primary">
          {t.search.label}
        </label>
        <form class="relative mt-2" role="search" data-not-found-search>
          <span
            class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-text-muted [&_svg]:h-5 [&_svg]:w-5"
            aria-hidden="true"
            set:html={searchIcon}
          />
          <input
            id="not-found-search"
            type="search"
            class="input input-search"
            placeholder={t.search.pagePlaceholder}
            data-not-found-search-input
          />
        </form>
      </div>

      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {tools.map((tool) => (
          <li>
            <a
              href={localizedHref(tool.href, defaultLocale)}
              class="chip focus-ring"
            >
              {tool.title}
            </a>
          </li>
        ))}
      </ul>

      <a href={localizedHref("/", defaultLocale)} class="btn btn-primary mt-8">
        {t.notFound.goHome}
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "[data-not-found-search]",
  );
  const input = document.querySelector<HTMLInputElement>(
    "[data-not-found-search-input]",
  );

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? "";
    if (query === "") return;
    document.dispatchEvent(
      new CustomEvent("appkitx:search-open", { detail: { query } }),
    );
  });
</script>
