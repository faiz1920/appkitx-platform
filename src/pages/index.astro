---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalNav from "../components/GlobalNav.astro";
import Footer from "../components/Footer.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools as registeredTools } from "../lib/tools";

import searchIcon from "lucide-static/icons/search.svg?raw";
import calculatorIcon from "lucide-static/icons/calculator.svg?raw";
import tagIcon from "lucide-static/icons/tag.svg?raw";
import rulerIcon from "lucide-static/icons/ruler.svg?raw";
import landmarkIcon from "lucide-static/icons/landmark.svg?raw";
import calendarIcon from "lucide-static/icons/calendar-days.svg?raw";
import binaryIcon from "lucide-static/icons/binary.svg?raw";
import bracesIcon from "lucide-static/icons/braces.svg?raw";

const registryIcons: Record<string, string> = {
  calculator: calculatorIcon,
  tag: tagIcon,
};

const tools = [
  ...registeredTools.map((tool) => ({
    title: tool.title,
    description: tool.description,
    icon: registryIcons[tool.icon] ?? "",
    href: tool.href,
  })),
  {
    title: "Unit Converter",
    description: "Length, weight, temperature, and more.",
    icon: rulerIcon,
    href: "#",
  },
  {
    title: "Loan Calculator",
    description: "Monthly payments, interest, and total cost.",
    icon: landmarkIcon,
    href: "#",
  },
  {
    title: "Date Calculator",
    description: "Days between dates, add or subtract time.",
    icon: calendarIcon,
    href: "#",
  },
  {
    title: "Base64 Encoder",
    description: "Encode and decode Base64 in your browser.",
    icon: binaryIcon,
    href: "#",
  },
  {
    title: "JSON Formatter",
    description: "Format, validate, and inspect JSON.",
    icon: bracesIcon,
    href: "#",
  },
];

const categories = [
  "Calculators",
  "Converters",
  "Developer tools",
  "Date & time",
  "Text tools",
];
---

<BaseLayout>
  <GlobalNav />
  <main id="main">
    <section class="bg-surface">
      <div class="mx-auto max-w-(--layout-container) px-6 pt-10 pb-8 md:pt-16 md:pb-12">
        <h1 class="hero-title max-w-[720px] text-text-primary">
          Free tools for everyday work.
        </h1>
        <p class="mt-4 max-w-[560px] text-body-lg text-text-secondary">
          Calculators, converters, and developer utilities — all in one place.
        </p>

        <div class="mt-8 max-w-(--layout-tool)">
          <label for="hero-search" class="text-label text-text-primary">
            Search tools
          </label>
          <form class="relative mt-2" role="search" data-hero-search>
            <span
              class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-text-muted [&_svg]:h-5 [&_svg]:w-5"
              aria-hidden="true"
              set:html={searchIcon}
            />
            <input
              id="hero-search"
              type="search"
              class="input input-search"
              placeholder="Search free tools…"
              data-hero-search-input
            />
          </form>
        </div>

        <div class="mt-6">
          <p class="text-overline text-text-muted uppercase">
            Browse by category
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {categories.map((category) => (
              <li>
                <a href="#tools" class="chip focus-ring">
                  {category}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="tools" class="bg-surface-subtle">
      <div class="mx-auto max-w-(--layout-container) px-6 py-16 md:py-(--layout-section-y)">
        <h2 class="text-headline text-text-primary">Explore the toolkit.</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-(--layout-grid-gap) lg:grid-cols-3 xl:grid-cols-4">
          {tools.map((tool) => (
            <ToolCard
              title={tool.title}
              description={tool.description}
              icon={tool.icon}
              href={tool.href}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const heroForm =
    document.querySelector<HTMLFormElement>("[data-hero-search]");
  const heroInput = document.querySelector<HTMLInputElement>(
    "[data-hero-search-input]",
  );

  heroForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = heroInput?.value.trim() ?? "";
    if (query === "") return;
    document.dispatchEvent(
      new CustomEvent("appkitx:search-open", { detail: { query } }),
    );
  });
</script>
