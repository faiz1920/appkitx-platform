---
import HomeView from "../../views/HomeView.astro";
import { isLocaleCode } from "../../i18n/config";
import { nonDefaultLocales } from "../../i18n/routing";

/*
 * Localized homepage. Only registered non-default locales are generated —
 * unsupported prefixes (including /en) never produce a route.
 */
export function getStaticPaths() {
  return nonDefaultLocales().map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale ?? "";
if (!isLocaleCode(locale)) {
  throw new Error(`Unsupported locale route: ${locale}`);
}
---

<HomeView locale={locale} />
