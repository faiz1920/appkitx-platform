---
import { isLocaleCode } from "../../../i18n/config";
import { nonDefaultLocales } from "../../../i18n/routing";
import { GUIDE_SLUGS } from "../../../lib/editorial";
import GuideArticleView from "../../../views/GuideArticleView.astro";

export function getStaticPaths() {
  return nonDefaultLocales().flatMap((locale) =>
    GUIDE_SLUGS.map((slug) => ({
      params: { locale, slug },
      props: { slug },
    })),
  );
}

const locale = Astro.params.locale ?? "";
if (!isLocaleCode(locale)) {
  throw new Error(`Unsupported locale route: ${locale}`);
}

const { slug } = Astro.props as { slug: string };
---

<GuideArticleView locale={locale} slug={slug} />
