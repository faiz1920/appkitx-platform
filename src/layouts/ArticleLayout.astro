---
import BaseLayout from "./BaseLayout.astro";
import GlobalNav from "../components/GlobalNav.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import GuideCard from "../components/GuideCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import { localizedHref } from "../i18n/routing";
import {
  GUIDE_CATEGORY_LABELS,
  GUIDE_COPY,
  formatEditorialDate,
  guideHref,
  guideIndexHref,
  infoPageHref,
  isoDate,
  type GuideCategory,
  type GuideSummary,
} from "../lib/editorial";
import { buildArticleJsonLd, buildBreadcrumbJsonLd, siteUrl } from "../lib/seo";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Reference {
  title: string;
  publisher: string;
  url: string;
}

interface Props {
  locale?: LocaleCode;
  slug: string;
  title: string;
  seoTitle?: string;
  description: string;
  category: GuideCategory;
  tags: readonly string[];
  published: Date;
  updated: Date;
  author: string;
  readingMinutes: number;
  headings: readonly Heading[];
  references: readonly Reference[];
  related: readonly GuideSummary[];
}

const {
  locale = defaultLocale,
  slug,
  title,
  seoTitle,
  description,
  category,
  tags,
  published,
  updated,
  author,
  readingMinutes,
  headings,
  references,
  related,
} = Astro.props;

const t = getDictionary(locale);
const localeMeta = getLocale(locale);
const copy = GUIDE_COPY[locale];
const categoryLabel = GUIDE_CATEGORY_LABELS[locale][category];
const canonical = siteUrl(guideHref(slug, locale), Astro.site);
const pageTitle = seoTitle ?? `${title} — ${copy.articleFallbackSuffix}`;
const aboutHref = infoPageHref("about", locale);

const breadcrumb = [
  { label: t.toolLayout.breadcrumbHome, href: localizedHref("/", locale) },
  { label: copy.breadcrumbGuides, href: guideIndexHref(locale) },
  { label: title },
];

const jsonLd = [
  buildBreadcrumbJsonLd({ entries: breadcrumb, site: Astro.site }),
  buildArticleJsonLd({
    headline: title,
    description,
    datePublished: isoDate(published),
    dateModified: isoDate(updated),
    authorName: author,
    authorUrl: siteUrl(aboutHref, Astro.site),
    publisherName: "AppKitX",
    publisherUrl: siteUrl(localizedHref("/", locale), Astro.site),
    url: canonical,
    inLanguage: localeMeta.hreflang,
    articleSection: categoryLabel,
    keywords: tags,
  }),
];

const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={pageTitle}
  description={description}
  locale={locale}
  jsonLd={jsonLd}
  ogType="article"
  article={{
    publishedTime: published.toISOString(),
    modifiedTime: updated.toISOString(),
    section: categoryLabel,
    tags,
  }}
>
  <GlobalNav locale={locale} />
  <main id="main">
    <header class="bg-surface">
      <div class="mx-auto max-w-(--layout-container) px-6 pt-10 pb-8 md:pt-16 md:pb-12">
        <Breadcrumbs label={t.toolLayout.breadcrumbLabel} items={breadcrumb} />
        <p class="mt-6 text-overline text-text-muted uppercase">
          {categoryLabel}
        </p>
        <h1
          id="guide-title"
          class="hero-title mt-2 max-w-[820px] text-text-primary"
        >
          {title}
        </h1>
        <p class="mt-4 max-w-(--layout-prose) text-body-lg text-text-secondary">
          {description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-caption text-text-muted">
          <span>
            {copy.bylinePrefix} {author}
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {copy.publishedLabel}
            <time datetime={isoDate(published)} class="ml-1">
              {formatEditorialDate(published, locale)}
            </time>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {copy.updatedLabel}
            <time datetime={isoDate(updated)} class="ml-1">
              {formatEditorialDate(updated, locale)}
            </time>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {readingMinutes} {copy.readingTimeSuffix}
          </span>
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-(--layout-container) gap-12 px-6 py-10 md:py-12 lg:grid-cols-[minmax(0,var(--layout-prose))_240px] lg:justify-center">
      <article aria-labelledby="guide-title">
        <div class="prose">
          <slot />
        </div>

        <section
          class="mt-16 max-w-(--layout-prose)"
          aria-labelledby="references"
        >
          <h2 id="references" class="text-title text-text-primary">
            {copy.references}
          </h2>
          <p class="mt-2 text-small text-text-secondary">
            {copy.referencesIntro}
          </p>
          <ol class="mt-4 space-y-3">
            {references.map((reference) => (
              <li class="text-small text-text-secondary">
                <a
                  href={reference.url}
                  rel="noopener noreferrer"
                  class="focus-ring text-accent underline underline-offset-2 hover:text-accent-hover active:text-accent-active"
                >
                  {reference.title}
                </a>
                <span class="text-text-muted"> — {reference.publisher}</span>
              </li>
            ))}
          </ol>
        </section>

        <div class="mt-12 max-w-(--layout-prose)">
          <AffiliateDisclosure locale={locale} />
        </div>

        <section
          class="mt-8 max-w-(--layout-prose) rounded-lg border border-border-subtle bg-surface-subtle p-4"
          aria-label={copy.aboutAuthor}
        >
          <p class="text-label text-text-primary">{author}</p>
          <p class="mt-1 text-small text-text-secondary">
            {copy.authorNote}
            <a
              href={`${aboutHref}#editorial-principles`}
              class="focus-ring ml-1 text-accent underline underline-offset-2 hover:text-accent-hover active:text-accent-active"
            >
              {copy.editorialPrinciplesLink}
            </a>
          </p>
        </section>
      </article>

      {toc.length >= 3 && (
        <aside class="hidden lg:block">
          <nav
            aria-label={copy.inThisGuide}
            class="sticky top-[calc(var(--layout-nav-height)+24px)]"
          >
            <p class="text-overline text-text-muted uppercase">
              {copy.inThisGuide}
            </p>
            <ul class="mt-3 space-y-2 border-l border-border-subtle pl-4">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="focus-ring text-small text-text-secondary hover:text-accent active:text-accent-active"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="bg-surface-subtle">
        <div class="mx-auto max-w-(--layout-container) px-6 py-16 md:py-(--layout-section-y)">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-title text-text-primary">{copy.relatedGuides}</h2>
            <a
              href={guideIndexHref(locale)}
              class="focus-ring inline-flex h-11 items-center text-label text-accent hover:text-accent-hover active:text-accent-active"
            >
              {copy.allGuides}
            </a>
          </div>
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-(--layout-grid-gap) lg:grid-cols-3">
            {related.map((guide) => (
              <GuideCard
                slug={guide.slug}
                title={guide.title}
                description={guide.description}
                category={guide.category}
                readingMinutes={guide.readingMinutes}
                locale={locale}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer locale={locale} />
</BaseLayout>
