---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import SearchPalette from "../components/SearchPalette.astro";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  /** Error and non-indexable pages: adds noindex and omits the canonical tag. */
  noindex?: boolean;
  /** Registered locale for the document language and direction. */
  locale?: LocaleCode;
}

const {
  title,
  description,
  noindex = false,
  locale = defaultLocale,
} = Astro.props;

const t = getDictionary(locale);
const localeMeta = getLocale(locale);

const pageTitle = title ?? t.layout.defaultTitle;
const pageDescription = description ?? t.layout.defaultDescription;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={localeMeta.code} dir={localeMeta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta
      name="google-site-verification"
      content="FqtwFyw8U6onLFiInewftYVJ-kJePykEmuxN2SwOe0c"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t.layout.skipToContent}
    </a>
    <slot />
    <SearchPalette locale={locale} />
  </body>
</html>
