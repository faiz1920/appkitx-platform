---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import SearchPalette from "../components/SearchPalette.astro";

interface Props {
  title?: string;
  description?: string;
  /** Error and non-indexable pages: adds noindex and omits the canonical tag. */
  noindex?: boolean;
}

const {
  title = "AppKitX — Free Online Tools",
  description = "Free calculators, converters, and developer utilities, all in one place.",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta
      name="google-site-verification"
      content="FqtwFyw8U6onLFiInewftYVJ-kJePykEmuxN2SwOe0c"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <slot />
    <SearchPalette />
  </body>
</html>
