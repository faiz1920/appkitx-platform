---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import SearchPalette from "../components/SearchPalette.astro";
import {
  defaultLocale,
  getDictionary,
  getLocale,
  type LocaleCode,
} from "../i18n/config";
import {
  serializeJsonLd,
  siteUrl,
  SITE_NAME,
  type JsonLdDocument,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** Error and non-indexable pages: adds noindex and omits the canonical tag. */
  noindex?: boolean;
  /** Registered locale for the document language and direction. */
  locale?: LocaleCode;
  /** JSON-LD documents rendered as application/ld+json scripts in the head. */
  jsonLd?: readonly JsonLdDocument[];
}

const {
  title,
  description,
  noindex = false,
  locale = defaultLocale,
  jsonLd = [],
} = Astro.props;

const t = getDictionary(locale);
const localeMeta = getLocale(locale);

const pageTitle = title ?? t.layout.defaultTitle;
const pageDescription = description ?? t.layout.defaultDescription;

const canonical = siteUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={localeMeta.code} dir={localeMeta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={localeMeta.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="google-site-verification"
      content="FqtwFyw8U6onLFiInewftYVJ-kJePykEmuxN2SwOe0c"
    />
    <title>{pageTitle}</title>
    {jsonLd.map((document) => (
      <script type="application/ld+json" set:html={serializeJsonLd(document)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t.layout.skipToContent}
    </a>
    <slot />
    <SearchPalette locale={locale} />
  </body>
</html>
